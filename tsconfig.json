{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "website",
    "scripts",
    "e2e",
    "playwright.config.ts",
    "worker/index.test.ts",
    "data/types.ts",
    "data/params.ts",
    "data/edge-cases.ts"
  ]
}
