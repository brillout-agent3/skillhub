// Generated by scripts/schema.ts from `Data` in data/types.ts: don't edit it, edit the type and run `pnpm run schema`.
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Data",
  "definitions": {
    "Data": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "The JSON Schema of this file, generated from this interface: for editors."
        },
        "updated": {
          "type": "string",
          "description": "When the data was last edited (YYYY-MM-DD)."
        },
        "asOf": {
          "type": "object",
          "properties": {
            "installs": {
              "type": "string",
              "description": "When the installs were collected, which crawl.ts does daily."
            },
            "stars": {
              "type": "string",
              "description": "When the GitHub stars were collected, which crawl.ts does daily."
            },
            "tags": {
              "type": "string",
              "description": "When the tags were last assigned."
            }
          },
          "required": ["installs", "stars", "tags"],
          "additionalProperties": false,
          "description": "When each kind of data is from (YYYY-MM-DD)."
        },
        "facets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Facet"
          },
          "description": "The tag dimensions, with the values their tags can take."
        },
        "repos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Repo"
          },
          "description": "The GitHub repos of the skills and bundles, one entry each."
        },
        "bundles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Bundle"
          },
          "description": "Skills meant to be installed together."
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Skill"
          },
          "description": "The approved skills: the ones the site lists."
        }
      },
      "required": ["$schema", "updated", "asOf", "facets", "repos", "bundles", "skills"],
      "additionalProperties": false,
      "description": "The shape of skills.jsonc, the single data file behind the site: the approved skills, the ones it shows. The skills the crawl found but that aren't approved are in crawl.jsonc."
    },
    "Facet": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Its id: the prefix of its tags, `id:value`."
        },
        "name": {
          "type": "string",
          "description": "Its name, as the site shows it."
        },
        "question": {
          "type": "string",
          "description": "The question its values answer."
        },
        "count": {
          "type": "string",
          "enum": ["one", "one or more", "at most one", "one to five", "any"],
          "description": "How many values of this facet a skill carries."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Its id: the tag is `facet:id`, or just `id` for a topic."
              },
              "label": {
                "type": "string",
                "description": "A name for chips, when the id alone isn't one."
              },
              "description": {
                "type": "string",
                "description": "What it means: for people browsing, and for agents tagging skills."
              },
              "includes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Makes the value a parent of these values of the same facet: skills don't carry it, they have it through any of them, and filtering on it lists them all."
              }
            },
            "required": ["id"],
            "additionalProperties": false
          },
          "description": "The values its tags can take."
        },
        "prefix": {
          "type": "boolean",
          "const": false,
          "description": "`false` for topics, which are written without a `topic:` prefix."
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The group's heading."
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The ids of its values."
              }
            },
            "required": ["name", "values"],
            "additionalProperties": false
          },
          "description": "Display groups (topics only)."
        }
      },
      "required": ["id", "name", "question", "count", "values"],
      "additionalProperties": false,
      "description": "A tag dimension. Tags are written `facet:value`, except topics, which have no prefix."
    },
    "Repo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "GitHub `owner/name`."
        },
        "url": {
          "type": "string",
          "description": "Its GitHub page."
        },
        "kind": {
          "type": "string",
          "enum": ["skills", "project", "index"],
          "description": "`skills`: exists to ship skills. `project`: a product that also ships a skill. `index`: a curated list or catalog."
        },
        "stars": {
          "type": ["number", "null"],
          "description": "GitHub stars, or null when unknown. crawl.ts refreshes them for the repos of approved skills and bundles."
        },
        "description": {
          "type": ["string", "null"],
          "description": "The repo in one line, such as its GitHub description, or null when it has none."
        },
        "leaderboardSkills": {
          "type": ["number", "null"],
          "description": "How many of the repo's skills were in the skills.sh all-time top 600."
        },
        "note": {
          "type": "string",
          "description": "Something to know about the repo, such as where its star count comes from."
        }
      },
      "required": ["id", "url", "kind", "stars", "description", "leaderboardSkills"],
      "additionalProperties": false
    },
    "Bundle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The GitHub repo, `owner/name`, or `owner/name@part` for one of several bundles in a repo."
        },
        "name": {
          "type": "string",
          "description": "Its name, as the site shows it."
        },
        "description": {
          "type": "string",
          "description": "One sentence, shown until it has a TLDR."
        },
        "tldr": {
          "$ref": "#/definitions/Tldr",
          "description": "What the bundle is and how its skills work together, written from the repo at its permalink's commit."
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BundleSkill"
          },
          "description": "Its skills, in the order they're used."
        },
        "install": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Where the command works, such as \"Claude Code plugin\"."
              },
              "command": {
                "type": "string",
                "description": "The command to run."
              }
            },
            "required": ["label", "command"],
            "additionalProperties": false
          },
          "description": "How to install all of its skills, one command per way, as its README gives them."
        },
        "skew": {
          "type": "number",
          "description": "Words added plus words removed across its skills' SKILL.md since the commit the TLDR summarizes, or all their words when there's no TLDR."
        }
      },
      "required": ["id", "name", "description", "skills", "install", "skew"],
      "additionalProperties": false,
      "description": "Skills of one repo meant to be installed together, such as the steps of a workflow. Its skills are listed inside its entry; those worth installing alone also get an entry of their own."
    },
    "Tldr": {
      "type": "object",
      "properties": {
        "glance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "A few words, such as \"Use it when\"."
              },
              "text": {
                "type": "string",
                "description": "What the label introduces."
              }
            },
            "required": ["label", "text"],
            "additionalProperties": false
          },
          "description": "Short labelled facts to place the skill quickly, most telling first, such as \"Use it when\"."
        },
        "text": {
          "type": "string",
          "description": "Prose that explains what the skill does."
        },
        "permalink": {
          "type": "string",
          "description": "GitHub permalink to what the TLDR summarizes: the skill's directory at a commit. For a bundle, its repo at a commit."
        }
      },
      "required": ["glance", "text", "permalink"],
      "additionalProperties": false
    },
    "BundleSkill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Where its SKILL.md lives, as for a skill's `id`."
        },
        "standalone": {
          "type": "boolean",
          "description": "Whether it's worth installing alone, with no other skill of the bundle: then it also gets an entry of its own in the skills list. A skill that loads another one of the bundle, or only works on another's output, isn't."
        },
        "note": {
          "type": "string",
          "description": "For a skill that isn't standalone: what it needs from the rest of the bundle."
        }
      },
      "required": ["id", "standalone"],
      "additionalProperties": false
    },
    "Skill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique: where the skill's SKILL.md lives, as the GitHub repo and the directory inside it, `owner/name/path/to/dir` (just `owner/name` for a SKILL.md at the root). The repo has an entry in `repos`."
        },
        "name": {
          "type": "string",
          "description": "Its name on skills.sh: the end of its skills.sh page."
        },
        "description": {
          "type": "string",
          "description": "One sentence on what it does, shown until it has a TLDR."
        },
        "tldr": {
          "$ref": "#/definitions/Tldr",
          "description": "What the skill is and does, written from the SKILL.md its permalink points to."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Its tags, `facet:value` or just the value for a topic, from the values `facets` defines."
        },
        "skills.sh": {
          "$ref": "#/definitions/SkillsSh",
          "description": "Its listing on skills.sh."
        },
        "skillMd": {
          "$ref": "#/definitions/SkillMd",
          "description": "The copy of the skill's SKILL.md at `data/skill-snapshots/<id>.md`, which `sync.ts` keeps current."
        },
        "note": {
          "type": "string",
          "description": "Something to know before installing."
        }
      },
      "required": ["id", "name", "description", "tags", "skills.sh"],
      "additionalProperties": false,
      "description": "A skill on GitHub that skills.sh lists. SkillHub lists no other skills."
    },
    "SkillsSh": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The skill's page on skills.sh."
        },
        "install": {
          "type": "string",
          "description": "The command skills.sh gives to install it."
        },
        "installs": {
          "type": ["number", "null"],
          "description": "All-time installs, or null when unknown: exact for the skills.sh all-time top 600, else from the skill's skills.sh page, which rounds them to three digits (such as 26.5K)."
        },
        "weeklyInstalls": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Installs per week for the 8 weeks up to the installs snapshot, oldest first."
        },
        "firstSeen": {
          "type": ["string", "null"],
          "description": "When skills.sh first saw the skill (YYYY-MM-DD)."
        }
      },
      "required": ["url", "install", "installs", "weeklyInstalls", "firstSeen"],
      "additionalProperties": false
    },
    "SkillMd": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "description": "The GitHub commit the copy was taken from."
        },
        "updated": {
          "type": "string",
          "description": "When the copy last changed (YYYY-MM-DD)."
        },
        "skew": {
          "type": "number",
          "description": "Words added plus words removed since the SKILL.md the TLDR summarizes, or all its words when there's no TLDR."
        }
      },
      "required": ["version", "updated", "skew"],
      "additionalProperties": false
    }
  }
}
