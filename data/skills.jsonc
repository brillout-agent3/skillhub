    {
      "id": "ibelick/ui-skills/skills/fixing-metadata",
      "name": "fixing-metadata",
      "skills.sh": {
        "url": "https://skills.sh/ibelick/ui-skills/fixing-metadata",
        "installs": 19400,
        "weeklyInstalls": [275, 388, 355, 313, 302, 549, 1111, 654],
        "firstSeen": "2026-01-22"
      },
      "skillMd": {
        "version": "00db7d656719c399c091f3ea138c6f42a7fa4d98",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits and fixes a site's page metadata: titles, descriptions, canonical URLs, Open Graph and Twitter cards, favicons and JSON-LD.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you ship new pages, fix how links look when shared, or set up titles, canonical URLs or structured data"
            },
            {
              "label": "It does",
              "text": "finds pages with missing or wrong metadata, checks them against ranked rules and fixes duplicates and indexing problems first"
            },
            {
              "label": "You get",
              "text": "a small, metadata-only diff in which title, description, canonical URL and og:url agree"
            },
            {
              "label": "Checks",
              "text": "social cards on a real URL, not localhost"
            }
          ],
          "text": "Metadata here is what sits in a page's head: its title and description, the canonical URL (the address search engines should treat as the page's own), robots directives, Open Graph and Twitter card tags for link previews, favicons and the manifest, JSON-LD structured data, and language alternates. Its rules: define metadata in one place per page with no duplicate tags, keep values deterministic, escape dynamic strings and give every page a safe default title and description; use noindex only for private, duplicate or staging pages; use absolute image URLs, and summary_large_image Twitter cards by default; add JSON-LD only when it matches what the page renders, never with invented ratings, reviews or prices; add hreflang alternates only for pages that exist. It follows the project's existing pattern, such as the Next.js metadata API, react-helmet or a hand-written head, and doesn't migrate SEO libraries or touch unrelated code.",
          "permalink": "https://github.com/ibelick/ui-skills/tree/00db7d656719c399c091f3ea138c6f42a7fa4d98/skills/fixing-metadata"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "seo"
        ]
      }
    },
    {
      "id": "rohitg00/agentmemory/plugin/skills/remember",
      "name": "remember",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/agentmemory/remember",
        "installs": 14600,
        "weeklyInstalls": [383, 402, 380, 350, 324, 340, 322, 312],
        "firstSeen": "2026-04-07"
      },
      "skillMd": {
        "version": "f0f7378ac42849b863fcc5c8e753f120d5ec6f9d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Saves an insight, decision or fact to agentmemory's long-term store, tagged with specific concepts so later searches find it.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want the agent to keep a decision, fact or insight for future sessions: \"remember this\", \"don't forget\", or /remember"
            },
            {
              "label": "It does",
              "text": "saves it to agentmemory in your own wording, with 2-5 specific concept tags and the files it mentions, then echoes the tags back"
            },
            {
              "label": "You get",
              "text": "a memory that recall finds later by those tags; saving a corrected version supersedes the old one"
            },
            {
              "label": "Needs",
              "text": "agentmemory's memory server running, with its MCP tools connected to your agent"
            },
            {
              "label": "Unlike lesson",
              "text": "which records rules learned from your corrections, this stores facts"
            }
          ],
          "text": "Part of agentmemory, a memory server that keeps what coding agents learn across sessions. remember is its write side. The agent pulls the core insight, decision or fact out of what you said, keeping your phrasing rather than a paraphrase, picks two to five lowercase concept phrases specific enough to retrieve it, such as jwt-refresh-rotation rather than auth, adds the file paths it refers to, and saves it. In a multi-agent setup it passes the agent's id so the memory lands in that agent's scope. It confirms with the exact concepts it tagged, so you know what to search for later. To change a fact, it saves the corrected version: the near-duplicate supersedes the old record, which drops out of recall but stays in its version history. recall reads back what it saves, and forget removes a memory saved by mistake.",
          "permalink": "https://github.com/rohitg00/agentmemory/tree/f0f7378ac42849b863fcc5c8e753f120d5ec6f9d/plugin/skills/remember"
        },
        "tags": [
          "category:agents",
          "type:tool",
          "effect:local",
          "needs:mcp",
          "by:official",
          "stack:agentmemory",
          "memory"
        ]
      }
    },
    {
      "id": "rohitg00/agentmemory/plugin/skills/recall",
      "name": "recall",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/agentmemory/recall",
        "installs": 14400,
        "weeklyInstalls": [380, 403, 378, 349, 331, 346, 319, 307],
        "firstSeen": "2026-04-07"
      },
      "skillMd": {
        "version": "f0f7378ac42849b863fcc5c8e753f120d5ec6f9d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Searches agentmemory's saved memories and captured session activity for a topic, showing only what the search returns.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you ask \"what did we do about\", \"did we ever\" or \"have we seen\" something in past sessions"
            },
            {
              "label": "It does",
              "text": "runs agentmemory's hybrid keyword, vector and graph search, then fetches the full records of the results it quotes"
            },
            {
              "label": "You get",
              "text": "matches grouped by session, highest importance first, or two or three other search terms when nothing matches"
            },
            {
              "label": "Needs",
              "text": "agentmemory's memory server running, with its MCP tools connected to your agent"
            },
            {
              "label": "Never",
              "text": "invents an observation, session id or score the search didn't return"
            }
          ],
          "text": "Part of agentmemory, a memory server that keeps what coding agents learn across sessions. recall is its read side. The agent searches with your words, scoped to a project or to one agent's history when you ask, and to saved memories, captured activity, or both. Search results are compact, so before quoting a fact or saying where it came from it fetches the full records; a title alone isn't treated as the fact, and a record that can't be fetched is reported as such. Results are grouped by session with their type, title and narrative, leading with those of importance 7 or more. When a response was cut short by its token budget, it checks how many results matched or were left out before calling something absent. The rule throughout is to show only what the tool returned: an empty search gets alternative search terms, never a guess at what was discussed.",
          "permalink": "https://github.com/rohitg00/agentmemory/tree/f0f7378ac42849b863fcc5c8e753f120d5ec6f9d/plugin/skills/recall"
        },
        "tags": [
          "category:agents",
          "type:tool",
          "effect:none",
          "needs:mcp",
          "by:official",
          "stack:agentmemory",
          "memory"
        ]
      }
    },
    {
      "id": "rohitg00/agentmemory/plugin/skills/session-history",
      "name": "session-history",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/agentmemory/session-history",
