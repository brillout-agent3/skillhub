    {
      "id": "software-mansion/argent/packages/skills/skills/argent-test-ui-flow",
      "name": "argent-test-ui-flow",
      "skills.sh": {
        "url": "https://skills.sh/software-mansion/argent/argent-test-ui-flow",
        "installs": 29300,
        "weeklyInstalls": [1534, 1390, 1522, 1537, 1588, 1638, 1697, 1618],
