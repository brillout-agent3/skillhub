      "id": "wshobson/agents/plugins/business-analytics/skills/data-storytelling",
      "name": "data-storytelling",
      "skills.sh": {
        "url": "https://skills.sh/wshobson/agents/data-storytelling",
        "installs": 17500,
        "weeklyInstalls": [216, 240, 406, 580, 374, 322, 369, 382],
