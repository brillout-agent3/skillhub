    {
      "id": "github/awesome-copilot/skills/web-design-reviewer",
      "name": "web-design-reviewer",
      "skills.sh": {
        "url": "https://skills.sh/github/awesome-copilot/web-design-reviewer",
        "installs": 14200,
        "weeklyInstalls": [171, 183, 116, 78, 79, 92, 108, 100],
        "firstSeen": "2026-01-20"
      },
      "skillMd": {
        "version": "797337f33f73e35d08d82f840e21c4b8c4932d88",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Reviews a running website in a browser for layout, responsive, accessibility and consistency problems, then fixes them in the source and re-checks.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want the agent to look at your running site, local or deployed, and find and fix what looks broken"
            },
            {
              "label": "It does",
              "text": "screenshots pages at 375, 768, 1280 and 1920px, rates layout, responsive, accessibility and consistency issues by priority, fixes the source one issue at a time, then re-checks"
            },
            {
              "label": "You get",
              "text": "fixed CSS or components, and a Markdown report of issues found, fixed and left open, with before-and-after screenshots"
            },
            {
              "label": "Needs",
              "text": "the site running, and browser automation that can navigate, screenshot and read the DOM; it recommends the Playwright MCP server"
            },
            {
              "label": "Asks you",
              "text": "before large changes, and when one issue still isn't fixed after three attempts"
            }
          ],
          "text": "The agent asks for the URL if you haven't given one, then detects the framework and styling method from files such as package.json and tailwind.config, so it knows whether a fix belongs in plain CSS, SCSS, CSS Modules, Tailwind classes or CSS-in-JS. It visits the pages, captures screenshots and the DOM, and works through a visual checklist kept in the skill's references, rating issues such as overflowing or overlapping elements, small touch targets, low contrast, missing focus states and mixed fonts as high, medium or low. Fixes go in priority order, one at a time, as minimal changes that follow the project's existing style. After each one it reloads, compares screenshots and checks that nothing else broke, looping until no issues remain. A production site gets a read-only review. Any browser tool with navigation, screenshots and DOM access will do; Selenium, Puppeteer and Cypress are named alongside Playwright MCP.",
          "permalink": "https://github.com/github/awesome-copilot/tree/797337f33f73e35d08d82f840e21c4b8c4932d88/skills/web-design-reviewer"
        },
