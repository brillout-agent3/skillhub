    {
      "id": "jimliu/baoyu-skills/skills/baoyu-translate",
      "name": "baoyu-translate",
      "skills.sh": {
        "url": "https://skills.sh/jimliu/baoyu-skills/baoyu-translate",
        "installs": 26000,
        "weeklyInstalls": [336, 330, 145, 139, 189, 191, 184, 217],
        "firstSeen": "2026-03-06"
      },
      "skillMd": {
