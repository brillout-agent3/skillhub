      "agentReview": {
        "description": "Automates browsers and records Playwright code.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "the agent needs to drive a real browser: test a page, fill a form, debug a UI, or write and fix Playwright tests"
            },
            {
              "label": "It does",
              "text": "controls Chrome, Firefox or WebKit one shell command at a time, reading each page as a text snapshot where every element has a short ID like e15"
            },
            {
              "label": "You get",
