    {
      "id": "software-mansion/argent/packages/skills/skills/argent-lens",
      "name": "argent-lens",
      "skills.sh": {
        "url": "https://skills.sh/software-mansion/argent/argent-lens",
        "installs": 25500,
        "weeklyInstalls": [1526, 1379, 1514, 1527, 1579, 1632, 1684, 1614],
        "firstSeen": "2026-06-17"
      },
      "skillMd": {
        "version": "b965c94827d6167fd2912a7ca5ad5505040ae4e0",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Builds several design variants of on-screen elements, captures each running on the device, and lets you choose in Argent's Lens window.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want design alternatives for a screen or component and to pick between them yourself, on the running app"
            },
            {
              "label": "It does",
              "text": "plans distinct variants per element, then builds each, screenshots it on the device, proposes it in Lens and reverts it"
            },
            {
              "label": "You get",
              "text": "your pick for each element applied in code, your comments acted on, and a report of what was applied or skipped"
            },
            {
              "label": "Rules",
              "text": "at least two variants per element, each a real, distinct screenshot of the running app, never a mockup"
            },
            {
              "label": "Needs",
              "text": "the Argent MCP server with its argent-lens feature flag, off by default and turned on with argent enable argent-lens, and the app running on a simulator or emulator"
            }
          ],
          "text": "Part of Software Mansion's Argent toolkit, which lets the agent control simulators, emulators and devices. Lens is Argent's window for choosing between designs: it shows each element as a card beside the live device stream, and you pick a variant per element, pin comments and press Complete. The agent first writes down which elements it will redesign and the distinct variants for each, such as filled, outlined or pill for a search field, and reads each element's exact identifier from the screen so the card points at the right one. Then, one variant at a time, it changes the code, reloads or rebuilds the app, navigates to the element, takes a screenshot, proposes it and reverts it, so captures never mix. Byte-identical screenshots mean a variant isn't on screen yet; if it can't produce visibly different captures, it stops and tells you. One blocking call waits for your decision, then it implements the chosen variants and treats every comment as a change request, including those on skipped variants.",
          "permalink": "https://github.com/software-mansion/argent/tree/b965c94827d6167fd2912a7ca5ad5505040ae4e0/packages/skills/skills/argent-lens"
        },
        "tags": [
          "category:design",
          "type:workflow",
          "effect:local",
          "needs:mcp",
          "by:official",
          "stack:argent",
          "design",
          "mobile"
        ],
        "note": "Needs Argent's argent-lens feature flag, which is off by default: run argent enable argent-lens once."
      }
    },
    {
      "id": "software-mansion/argent/packages/skills/skills/argent-tv-interact",
