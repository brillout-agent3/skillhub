      "agentReview": {
        "description": "Builds and deploys websites, web apps and browser games on Higgsfield, from design brief to live URL.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a website, web app or browser game built and put online from a description, with no hosting to set up"
            },
            {
              "label": "It does",
              "text": "asks whether you want a plain website, a Higgsfield-connected app or a game, then designs, builds and deploys it through the Higgsfield CLI"
            },
            {
              "label": "You get",
              "text": "a live site at a subdomain it picks from the product's name, with a generated cover image and share-card text, optionally listed on Higgsfield's community feed"
            },
            {
              "label": "Goes live",
              "text": "on every deploy, with no preview stage; listing on the community feed is a separate step"
