          "effect:local",
          "needs:mcp",
          "needs:subagents",
          "by:official",
          "stack:argent",
          "stack:react-native",
          "performance",
          "mobile"
        ],
        "note": "Loads argent-react-native-profiler and follows its workflow for the profiling phase, so it needs that skill and Argent's MCP server."
      }
    },
    {
      "id": "software-mansion/argent/packages/skills/skills/argent-device-interact",
      "name": "argent-device-interact",
