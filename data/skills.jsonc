      "id": "rohitg00/agentmemory/plugin/skills/handoff",
      "name": "handoff",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/agentmemory/handoff",
        "installs": 13900,
        "weeklyInstalls": [355, 375, 329, 291, 293, 304, 299, 285],
