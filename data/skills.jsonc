      "agentReview": {
        "description": "Reviews your whole project and writes a concise README.md for it in GitHub Flavored Markdown.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a README.md written for a project"
            },
            {
              "label": "It does",
              "text": "reviews the whole project and workspace, takes structure and tone from four example READMEs it links to, and writes README.md"
            },
            {
              "label": "You get",
              "text": "a concise README.md in GitHub Flavored Markdown, with GitHub callouts where they fit and the project's logo in the header if it finds one"
            },
            {
              "label": "Leaves out",
              "text": "license, contributing and changelog sections, which belong in their own files, and heavy use of emoji"
            }
          ],
          "text": "A one-shot command. The agent plays a senior engineer experienced in open source: it reviews the entire project and workspace, then writes a comprehensive, well-structured README.md. For structure, tone and content it takes inspiration from four READMEs it names by URL, two from Azure-Samples serverless projects and two from sinedied's run-on-output and smoke repositories. The README should be appealing, informative and easy to read, yet concise, without overused emoji. It uses GitHub Flavored Markdown, with GitHub's admonition syntax (callout blocks such as a note or a warning) where appropriate, and puts the project's logo or icon in the header if it finds one. Sections such as LICENSE, CONTRIBUTING and CHANGELOG are left out, since dedicated files cover them.",
          "permalink": "https://github.com/github/awesome-copilot/tree/797337f33f73e35d08d82f840e21c4b8c4932d88/skills/create-readme"
        },
