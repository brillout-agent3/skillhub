        "skew": 0
      },
      "agentReview": {
        "description": "Drives iOS simulators, Android emulators, phones and Chromium apps through Argent: taps, gestures, typing, hardware buttons and screenshots.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "the agent needs to use your app on an iOS simulator, Android emulator, phone or Chromium app: tap, swipe, type, launch it, take screenshots"
            },
            {
              "label": "It does",
              "text": "tells the agent which Argent tool fits each action, how to find tap targets in the screen's element tree, and how to wait for UI without polling"
            },
            {
              "label": "You get",
              "text": "an agent that takes the paths a real user would, reading the element tree each action returns instead of guessing taps from screenshots"
            },
            {
              "label": "Needs",
              "text": "the Argent MCP server and a simulator, emulator, phone or Chromium app; the agent boots one if none is ready"
            },
            {
              "label": "Not for",
              "text": "TVs"
            }
          ],
          "text": "Argent is Software Mansion's MCP server that lets an agent control simulators, emulators and devices, much as agent-browser does for websites. Each tool describes its own parameters; this skill covers choosing between them and the gotchas. A table maps actions to tools: launch-app rather than tapping home-screen icons, gesture tools for taps, swipes, pinches and long presses, keyboard for text, button for hardware keys, plus rotate, fold and shake. To find a target the agent reads the element tree each action returns, or calls describe; screenshots are a last resort, not a source of tap coordinates for routine navigation. It waits with await-ui-element or await-screen-idle instead of taking screenshots in a loop, and batches known steps with run-sequence, gated on the expected screen appearing. Credentials go in as {{secret:NAME}} placeholders, never as plaintext, and a field holding a secret isn't screenshotted. It answers an app's own permission dialogs rather than changing settings, and explains how React Native's LogBox toasts catch taps. Separate reference files cover Chromium, HarmonyOS and foldable targets; for a physical iPhone, which supports only some of the tools, it sends the agent to argent-ios-device-interact first.",
          "permalink": "https://github.com/software-mansion/argent/tree/b965c94827d6167fd2912a7ca5ad5505040ae4e0/packages/skills/skills/argent-device-interact"
        },
