        "skew": 0
      },
      "agentReview": {
        "description": "Tests app UI flows on iOS or Android through Argent, checking each tap or keystroke with screenshots, element trees or logs.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want the agent to check a login, navigation or other UI flow on a simulator, emulator or phone, or confirm a visible UI change"
            },
            {
              "label": "It does",
              "text": "repeats a loop for each step of the flow: baseline screenshot, find the target, act, verify"
            },
            {
              "label": "You get",
              "text": "a verdict: expected and observed behavior, the evidence used, and anything that blocked the check"
            },
            {
              "label": "Picks evidence",
              "text": "pixel diffs for visual changes, element trees for structure, logs and network traffic for runtime behavior"
            },
            {
              "label": "Needs",
              "text": "the Argent MCP server"
            }
          ],
          "text": "A manual-QA loop the agent runs through Argent, Software Mansion's MCP server for controlling simulators, emulators and devices. It picks a device first, preferring one already running, then for each step of the flow takes a baseline screenshot, finds the element to tap in the screen's element tree, acts, and verifies. Verification depends on what's asserted: a screenshot diff against the baseline for layout, color or text rendering; the element or component tree for navigation state and labels; network and console logs or a JavaScript evaluation for API calls and errors. It waits out loading screens with await-ui-element rather than repeated screenshots, and retries a missed tap once with fresh coordinates before reporting the element as not found. Credentials are typed as {{secret:NAME}} placeholders, never as plaintext. These steps run live; a flow worth repeating can be saved as a replayable YAML test with argent-create-e2e.",
          "permalink": "https://github.com/software-mansion/argent/tree/b965c94827d6167fd2912a7ca5ad5505040ae4e0/packages/skills/skills/argent-test-ui-flow"
