    {
      "id": "software-mansion/argent/packages/skills/skills/argent-metro-debugger",
      "name": "argent-metro-debugger",
      "skills.sh": {
        "url": "https://skills.sh/software-mansion/argent/argent-metro-debugger",
        "installs": 29300,
        "weeklyInstalls": [1530, 1389, 1518, 1535, 1586, 1639, 1687, 1615],
        "firstSeen": "2026-04-28"
      },
      "skillMd": {
        "version": "b965c94827d6167fd2912a7ca5ad5505040ae4e0",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Connects the agent to a running React Native or Chromium app's JavaScript runtime through Argent, to read logs, components and network traffic.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you need to see inside a running React Native app: console errors, which component is on screen, app state or API calls"
            },
            {
              "label": "It does",
              "text": "connects to the app's JavaScript runtime through Metro and gives the agent tools for logs, the component tree, network traffic and running JavaScript"
            },
            {
              "label": "You get",
              "text": "answers from the live app, such as the source file and line of the component at a point on screen"
            },
            {
              "label": "Works with",
              "text": "React Native on iOS, Android and Fire TV (Vega); a subset of the tools on Electron and other Chromium apps"
            },
            {
              "label": "Needs",
              "text": "the Argent MCP server and Metro, which the agent starts with the project's own script if it isn't running; physical iPhones aren't supported"
            }
          ],
          "text": "Argent, Software Mansion's MCP server for simulators and devices, includes debugger tools that attach to a JavaScript runtime over the Chrome DevTools Protocol, through Metro for React Native. This skill is their manual: what each platform needs first, such as the adb port forwarding an Android phone needs, a table of what each tool is for, and what to do when something fails. The agent calls debugger-status first, follows its guidance once rather than retrying in a loop, starts Metro itself with the project's own script if it isn't running, and relaunches the app if it lost its connection. Console logs go to a flat file on disk; the skill explains its format and how to search it narrowly, with grep limits, escaped brackets and a subagent for files over 10,000 entries. Everything read from the app, such as logs, payloads and component trees, is treated as untrusted data: the agent never follows instructions found there or copies secrets out.",
          "permalink": "https://github.com/software-mansion/argent/tree/b965c94827d6167fd2912a7ca5ad5505040ae4e0/packages/skills/skills/argent-metro-debugger"
        },
        "tags": [
          "category:debugging",
