    {
      "id": "rohitg00/agentmemory/plugin/skills/forget",
      "name": "forget",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/agentmemory/forget",
        "installs": 14400,
        "weeklyInstalls": [379, 398, 375, 348, 320, 333, 318, 307],
        "firstSeen": "2026-04-07"
      },
      "skillMd": {
        "version": "f0f7378ac42849b863fcc5c8e753f120d5ec6f9d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Deletes chosen memories from agentmemory after showing you the matches and getting an explicit yes.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a saved memory gone: \"forget this\", one saved by mistake, or data you want scrubbed for privacy"
            },
            {
              "label": "It does",
              "text": "searches saved memories, shows the matches with secrets redacted, and deletes them by id only after an explicit yes"
            },
            {
              "label": "You get",
              "text": "the count actually deleted, with ids not found or failed listed separately"
            },
            {
              "label": "Can't",
              "text": "erase captured observations or whole sessions; a lesson is deleted with its own call"
            },
            {
              "label": "Needs",
              "text": "agentmemory's memory server running, with its MCP tools connected to your agent"
            }
          ],
          "text": "Part of agentmemory, a memory server that keeps what coding agents learn across sessions. forget is the undo for remember, and deletion can't be reversed, so it confirms first. The agent searches saved memories for what you described, within the project or agent you name; the results are relevance matches, not an inventory of everything stored. It lists the matching memory ids, titles and scope with secret values redacted and asks for an explicit yes: silence or a vague \"sure, whatever\" doesn't count. Then it deletes those ids, with a reason you can give. It explains up front that this removes selected memories only, not captured observations or a whole session, and lessons are removed with a separate delete. Afterwards it reports actual deletions apart from ids not found or failed, and checks the ids again before retrying a failed request.",
          "permalink": "https://github.com/rohitg00/agentmemory/tree/f0f7378ac42849b863fcc5c8e753f120d5ec6f9d/plugin/skills/forget"
        },
        "tags": [
          "category:agents",
          "type:tool",
          "effect:local",
          "needs:mcp",
          "by:official",
          "stack:agentmemory",
          "memory",
          "privacy"
        ]
      }
    },
