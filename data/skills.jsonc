    {
      "id": "lllllllama/rigorpilot-skills",
      "skew": 0,
      "agentReview": {
        "name": "RigorPilot",
        "description": "Reproduces a deep learning research repo from its README in small audited steps, with a separate lane for trying new ideas.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want an agent to run a deep learning research repo from its README and record honestly what worked"
            },
            {
              "label": "It does",
              "text": "finds the smallest documented run, such as one evaluation command, sets it up, runs it and audits the result, instead of a full training run"
            },
            {
              "label": "You get",
              "text": "a repro_outputs/ folder: a verdict (verified, partial or blocked), the exact commands, logs, patches, and any change to data, evaluation or metrics"
            },
            {
              "label": "Main skill",
              "text": "ai-research-reproduction runs the steps. It isn't one of the five listed, but the bundle's install command adds it, and two of the five need it"
            },
            {
              "label": "Also has",
              "text": "ai-research-explore, a separate lane for trying new research ideas, whose results are never reported as reproduced"
            }
          ],
          "text": "The repo's main skill, ai-research-reproduction, runs a reproduction end to end. It isn't listed among these five, but the bundle's install command adds it with them. The five are its steps, and each can also be called on its own. repo-intake-and-plan reads the README and project files, sorts the documented commands into inference, evaluation and training, and picks the smallest one worth trusting. paper-context-resolver steps in only when the README leaves out a detail that matters, such as which dataset split to evaluate on, and looks it up in the paper, noting any conflict. env-and-assets-bootstrap drafts conda commands and where checkpoints and datasets should go, before anything runs. minimal-run-and-audit runs the chosen command and writes the evidence to repro_outputs/, including any patch and any change to data, evaluation or metrics; its scripts need the main skill. ai-research-explore, which needs it too, is a separate lane: only when you ask, and starting from a model or run you already have, it ranks and tries new research ideas, writes them to explore_outputs/, and never reports them as reproduced results.",
          "permalink": "https://github.com/lllllllama/rigorpilot-skills/tree/fb3ccdf5aa64b1fa5b1d0463e666a8bc8bc26e01"
        },
        "skills": [
          {
            "id": "lllllllama/rigorpilot-skills/skills/repo-intake-and-plan",
            "standalone": true
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/paper-context-resolver",
            "standalone": true
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/env-and-assets-bootstrap",
            "standalone": true
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/minimal-run-and-audit",
            "standalone": false,
            "note": "Its run and report scripts load a shared runtime that ships inside ai-research-reproduction, the repo's main skill, and stop with an error without it."
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/ai-research-explore",
            "standalone": false,
            "note": "Loads its required research loop and shared runtime from ai-research-reproduction, the repo's main skill, and hands code changes and trial runs to the repo's explore-code and explore-run skills."
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add https://github.com/lllllllama/rigorpilot-skills --skill '*'"
          }
        ]
      }
    },
    {
      "id": "browser-act/skills",
      "skew": 0,
      "agentReview": {
        "name": "BrowserAct",
        "description": "Real-browser automation for agents, plus Skill Forge, which turns a site you scrape often into a reusable skill.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want the agent to use real browsers on logged-in or bot-protected sites, or to turn a repeated scrape into a reusable skill"
            },
            {
              "label": "It does",
              "text": "browser-act drives your Chrome or BrowserAct's stealth browsers from its CLI; browser-act-skill-forge explores a site once and writes a skill that repeats the extraction"
            },
            {
              "label": "You get",
              "text": "pages read, clicked through and screenshotted on demand, and tested skill packages (SKILL.md plus Python scripts) for sites you scrape often"
            },
            {
              "label": "Needs",
              "text": "the browser-act CLI (Python 3.12+, uv). Your own Chrome needs no account; stealth browsers, CAPTCHA solving and browser-act-skill-forge need a free BrowserAct account"
            },
            {
              "label": "Asks first",
              "text": "before creating or deleting browsers, logging in, submitting forms or uploading files"
            }
          ],
          "text": "BrowserAct is a browser-automation service for AI agents, and these skills use its local CLI rather than its cloud product. browser-act lets the agent open pages in your own Chrome, reusing your logins, or in BrowserAct's stealth browsers, which each present their own device fingerprint so sites see separate, ordinary visitors rather than a bot. The agent reads a numbered list of page elements and clicks or types by number, takes screenshots, captures network responses, and can send you a live link to take over when it gets stuck. browser-act-skill-forge builds on browser-act, which it loads first. You describe the data you want from a site and confirm a plan; it works out how the site loads that data, preferring the site's own data APIs over scraping its HTML, then generates a skill of SKILL.md plus Python scripts, has a subagent test it, fixes what fails and installs it. Later runs call that skill without exploring again, which suits bulk jobs such as hundreds of listings. Beyond the free account, only managed proxies and more than five stealth browsers cost money.",
          "permalink": "https://github.com/browser-act/skills/tree/11c057b03f92101642cadc9f840564574120d184"
        },
        "skills": [
          {
            "id": "browser-act/skills/browser-act",
            "standalone": true
          },
          {
            "id": "browser-act/skills/browser-act-skill-forge",
            "standalone": false,
            "note": "Loads the browser-act skill in its first step and explores every site through it, so it needs that skill and its CLI installed."
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add https://github.com/browser-act/skills --skill browser-act --skill browser-act-skill-forge"
          }
        ]
      }
    }
  ],
  "skills": [
    {
      "id": "vercel-labs/skills/skills/find-skills",
      "name": "find-skills",
      "skills.sh": {
        "url": "https://skills.sh/vercel-labs/skills/find-skills",
        "installs": 4239591,
        "weeklyInstalls": [101317, 105144, 103601, 107199, 110524, 121189, 121665, 115285],
        "firstSeen": "2026-01-26"
      },
      "skillMd": {
        "version": "a80e4c9d12d607631249d4d7d059f835d4b2f13a",
        "updated": "2026-10-20",
        "skew": 0
      },
      "agentReview": {
        "description": "Discovers and installs skills when you ask \"how do I do X\" or \"is there a skill for X\".",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you ask \"is there a skill for X?\" or \"how do I do X?\""
            },
            {
              "label": "It does",
              "text": "looks up the skills.sh leaderboard and searches with the npx skills CLI"
            },
            {
              "label": "You get",
              "text": "a few vetted skills, each with its install count, source and install command"
            },
            {
              "label": "Needs",
              "text": "Node.js, for npx skills"
            }
          ],
          "text": "It turns the agent into a scout for the open skills ecosystem. When you ask how to do something, the agent first checks the skills.sh leaderboard for a well-known skill, then searches with npx skills find using specific keywords. Before recommending anything it vets it: the install count, whether the publisher is a known source, and the repo's GitHub stars, with caution under 100 installs or stars. It presents each option with what it does, its numbers, the install command and a link, and can install the one you pick. If nothing fits, it says so, offers to help directly, and suggests writing your own skill with npx skills init.",
          "permalink": "https://github.com/vercel-labs/skills/tree/a80e4c9d12d607631249d4d7d059f835d4b2f13a/skills/find-skills"
        },
        "tags": [
          "category:skill-tools",
          "type:tool",
          "effect:local",
          "needs:cli",
          "by:official",
          "skill-discovery",
          "agent-workflows"
        ]
      }
    },
    {
      "id": "mattpocock/skills/skills/engineering/setup-matt-pocock-skills",
      "name": "setup-matt-pocock-skills",
      "skills.sh": {
