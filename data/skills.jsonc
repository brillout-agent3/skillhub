      "agentReview": {
        "description": "Maps a product's assets to the right Strix test, runs them in sequence, and consolidates the results into one impact-ranked remediation plan.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want an application-security review across a whole product but don't yet know which test you need"
            },
            {
              "label": "It does",
              "text": "maps each asset (code, web app, API, CI) to the right Strix skill, sequences the runs, and merges findings into one ranked plan"
            },
            {
              "label": "You get",
              "text": "a remediation plan ordered by proven impact, with honest coverage gaps noted"
