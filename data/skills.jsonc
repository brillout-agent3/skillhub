    {
      "id": "petergyang/no-ai-slop/skills/no-ai-slop",
      "name": "no-ai-slop",
      "skills.sh": {
        "url": "https://skills.sh/petergyang/no-ai-slop/no-ai-slop",
        "installs": 30000,
        "weeklyInstalls": [1833, 1767, 1216, 1405, 4538, 6367, 1204, 990],
        "firstSeen": "2026-07-22"
      },
      "skillMd": {
        "version": "000650b156983f5159695b441477f4e63b25dc85",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Edits drafts to remove AI-sounding patterns while keeping the writer's voice, or flags those patterns without rewriting.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a draft sounds generated, or you want to know whether a piece reads as AI"
            },
            {
              "label": "It does",
              "text": "edits by default, making the smallest change that fixes AI patterns while keeping your vocabulary, rhythm, humor and bluntness"
            },
            {
              "label": "You get",
              "text": "the full edited draft and a short What changed section; in detect mode, each pattern found with the quoted line and a fix"
            },
            {
              "label": "Won't",
              "text": "invent facts, stats or sources, score the draft, or guess whether AI wrote it"
            },
            {
              "label": "Unlike unslop",
              "text": "it protects the writer's quirks, and asks who the piece is for when that's unclear"
            }
          ],
          "text": "Peter Yang's editing skill. It casts the agent as a sharp human editor whose first job is to notice what makes the draft yours, such as your words, cadence, digressions and uncertainty, and keep it. It cuts a banned list of words (delve, leverage, robust, game changer), empty adverbs and phrases unless they carry your voice, and named patterns: \"not X, it's Y\" contrasts, throat-clearing openers, \"what nobody tells you\" setups, colon reveals, trailing -ing analysis, importance puffery, lines telling the reader what to notice, weasel attributions, dramatic fragments, rhetorical setups, mic-drop endings, recap conclusions, formatting slop and em-dash clusters. It pushes for concrete names, numbers and mechanisms, and applies a portability test: a sentence that could move unchanged to another subject is filler. With no draft it asks for one, and it asks a single question when the audience or goal is unclear. After editing, it checks the draft against the skill's eval.md and fixes what fails before returning it.",
          "permalink": "https://github.com/petergyang/no-ai-slop/tree/000650b156983f5159695b441477f4e63b25dc85/skills/no-ai-slop"
        },
        "tags": [
          "category:writing",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "anti-slop",
          "writing"
        ]
      }
    },
    {
      "id": "obra/superpowers/skills/diagnosing-superpowers",
      "name": "diagnosing-superpowers",
      "skills.sh": {
        "url": "https://skills.sh/obra/superpowers/diagnosing-superpowers",
        "installs": 28800,
        "weeklyInstalls": [0, 941, 4336, 3664, 3315, 4039, 4577, 4394],
        "firstSeen": "2026-09-19"
      },
      "skillMd": {
        "version": "22f0b463e7a5e579904dd6211a520321035526f7",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Investigates why a Superpowers session went wrong from its transcripts, and drafts an evidence-backed bug report for the maintainers.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a Superpowers session repeated work, ignored its plan, cost too much or never fired a skill, and you want to know why"
            },
            {
              "label": "It does",
              "text": "asks what went wrong, finds the session's transcripts, and runs seven analyst subagents in parallel, one per angle such as plan adherence or cost"
            },
            {
              "label": "You get",
              "text": "a report in which every finding cites a transcript file and line; a GitHub issue if Superpowers looks involved; a scrubbed session bundle if you ask"
            },
            {
              "label": "Won't",
              "text": "name a defect in a skill, propose a change or give advice; it reports, and the maintainers decide"
            },
            {
              "label": "Asks first",
              "text": "before filing an issue, and before building or archiving a bundle"
            }
          ],
          "text": "Superpowers' way to look back at a session, the current one or a past one by id or path, on any agent harness. It starts with intake, asking one question at a time until it can say which session, what you expected, what happened and what you care about, such as time, tokens or one repeated action. It then locates the transcript files, subagents' included, confirms a past session by quoting its first prompt, and opens a case file in ~/.superpowers/diagnosing-superpowers/<session-id>/. It reads the region around the problem itself, then dispatches analysts for skill timeline, plan adherence, repeated work, stumbles, quality evidence, conflicting requests, and cost and time, discarding any finding without a path:line citation; every number comes from the transcript or a command it ran. If the report says Superpowers may be involved, it searches existing GitHub issues, suggests adding to the closest, and files a new one only after you approve its exact text. A shareable bundle is built only when you ask, at a redaction level you choose, scrubbed and audited until clean. It never modifies session files.",
          "permalink": "https://github.com/obra/superpowers/tree/22f0b463e7a5e579904dd6211a520321035526f7/skills/diagnosing-superpowers"
        },
        "tags": [
          "category:debugging",
          "category:skill-tools",
          "type:workflow",
          "effect:remote",
          "needs:subagents",
          "needs:issue-tracker",
          "by:community",
          "debugging",
          "agent-workflows",
          "issue-tracking"
        ],
        "note": "Only analyzes sessions that used the Superpowers skills, so it's useful only alongside them."
      }
    },
    {
      "id": "wshobson/agents/plugins/framework-migration/skills/database-migration",
      "name": "database-migration",
      "skills.sh": {
        "url": "https://skills.sh/wshobson/agents/database-migration",
        "installs": 18000,
        "weeklyInstalls": [224, 239, 267, 320, 252, 228, 223, 203],
        "firstSeen": "2026-01-20"
