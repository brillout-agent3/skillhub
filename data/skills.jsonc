      "agentReview": {
        "description": "Audits a site's SEO, performance, security and accessibility, then fixes the code.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a site's SEO, performance, security, accessibility and content problems found and fixed in its code"
