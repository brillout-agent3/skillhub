      },
      "agentReview": {
        "description": "Fills the gaps a README leaves when reproducing a deep-learning paper's repo.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you're reproducing a paper's code and the README leaves one specific question open, such as a dataset split or evaluation protocol"
            },
            {
              "label": "It does",
              "text": "looks up that one detail in the paper's primary sources: the README's paper link, the project page, arXiv or OpenReview"
            },
            {
              "label": "You get",
              "text": "a short answer with its sources, separating direct evidence from inference and noting any conflict with the README"
            },
            {
              "label": "Not for",
              "text": "summarizing a paper, finding a paper from its title alone, or overriding the README"
            },
            {
              "label": "Usually called by",
              "text": "RigorPilot's main skill, which reproduces a research repo from its README"
            }
          ],
          "text": "A narrow, optional helper in RigorPilot, a set of skills that reproduces deep-learning research code by following its README. It comes in only after the README and repo files have been read and a concrete gap remains, such as which dataset version or split, which preprocessing, which evaluation protocol, or which checkpoint matches which model. It searches in a fixed order: the paper the README links, the official project or paper page, the arXiv or OpenReview record, and Google Scholar only to locate those. It answers that question alone, without a paper summary or guessed \"best settings\". When the paper and README disagree, it doesn't quietly switch to the paper: it records the conflict, says which source says what, and keeps the README as the default.",
          "permalink": "https://github.com/lllllllama/rigorpilot-skills/tree/fb3ccdf5aa64b1fa5b1d0463e666a8bc8bc26e01/skills/paper-context-resolver"
        },
