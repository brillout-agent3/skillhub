          "effect:none",
          "needs:mcp",
          "by:official",
          "stack:argent",
          "mobile",
          "testing",
          "computer-use"
        ],
        "note": "Covers only what differs on a physical iPhone; argent-device-interact still applies to everything else."
      }
    },
    {
      "id": "sanyuan0704/sanyuan-skills/skills/code-review-expert",
      "name": "code-review-expert",
      "skills.sh": {
        "url": "https://skills.sh/sanyuan0704/sanyuan-skills/code-review-expert",
        "installs": 13700,
        "weeklyInstalls": [143, 147, 83, 75, 97, 113, 117, 92],
