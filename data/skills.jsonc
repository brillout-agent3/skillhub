      "skillMd": {
        "version": "ca703c2d7c2c4399a1dc0cf82224f8551e05a96d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Posts tweets with images or video, quote tweets and long-form X Articles to X through your own logged-in Chrome.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want the agent to post to X for you: a post with images or video, a quote tweet or a long Markdown article"
            },
            {
              "label": "It does",
              "text": "fills in X's composer in your logged-in Chrome, through computer use, Codex's Chrome plugin or, as a fallback, its own scripts"
            },
            {
              "label": "Asks first",
              "text": "it never clicks Post or Publish without your explicit go-ahead; its scripts leave the browser open for you to publish"
            },
            {
              "label": "Articles",
              "text": "converts Markdown to rich text, pastes it into X Articles, uploads each image in place and checks the preview; needs X Premium"
            },
            {
              "label": "Needs",
              "text": "Chrome, Bun or npx, and an X account you log in to once"
            }
          ],
          "text": "Before touching X it picks one way to control Chrome: Codex's Chrome plugin when you ask for it, otherwise Chrome computer use if the agent has it, and its own scripts over Chrome's debugging protocol only as a fallback, never switching silently. Plain text becomes a regular post (280 characters, or up to 10,000 with Premium); a Markdown file becomes an X Article. For an article it converts the Markdown to HTML, uploads the cover, pastes the body, then replaces each image placeholder with the uploaded image and checks that none remain before showing you the preview. Images in regular posts go in through the clipboard, which on macOS needs accessibility permission for your terminal and on Linux needs xdotool or ydotool. If its scripts can't reach Chrome's debugging port, it kills Chrome instances running with remote debugging and retries, without asking.",
          "permalink": "https://github.com/jimliu/baoyu-skills/tree/ca703c2d7c2c4399a1dc0cf82224f8551e05a96d/skills/baoyu-post-to-x"
        },
