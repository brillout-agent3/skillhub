      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/content-strategy",
        "installs": 172538,
        "weeklyInstalls": [3687, 3323, 3469, 4241, 4772, 4330, 4666, 5239],
        "firstSeen": "2026-01-26"
      },
      "skillMd": {
