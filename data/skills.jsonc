      "agentReview": {
        "description": "Explores a website through Playwright MCP, trying three to five core features, and proposes test cases from what it found.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want to know what to test on a website before writing tests, and have its URL"
