    {
      "id": "coreyhaines31/marketingskills/skills/pricing",
      "name": "pricing",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/pricing",
        "installs": 86318,
        "weeklyInstalls": [2871, 2670, 2632, 2978, 3385, 3529, 3758, 4202],
        "firstSeen": "2026-05-14"
      },
      "skillMd": {
        "version": "96798cf38736ecdba015a1d2b0521b0c8f8f41dd",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Designs SaaS pricing (value metric, tiers, first price, research, increases) and audits pricing pages for buyers and AI agents.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you're deciding what to charge, how to structure plans, whether to offer a free tier, or how to raise prices"
            },
            {
              "label": "It does",
              "text": "finds a value metric that grows with what customers get, then sets tiers and a price between the next best alternative and perceived value"
            },
            {
              "label": "First price",
              "text": "start near $10, $100 or $1,000 a month by customer type, and avoid ultra-low $9 pricing"
            },
            {
              "label": "Price increases",
              "text": "test on new customers first, move 5-10% of existing ones, and treat grandfathering as a transition"
            },
            {
              "label": "Also does",
              "text": "a pricing page teardown scoring it for human buyers and for AI agents that need prices in plain text"
            }
          ],
          "text": "Pricing for SaaS along three axes: what each tier includes, what you charge for (the value metric, such as per seat or per usage) and the price itself. It reads your product marketing context if you have it (a shared file on your product, audience and positioning that the repo's product-marketing skill writes) and asks about your product, current pricing, market, sales motion, conversion, revenue per user and churn. Prices are set by value, not by cost or by copying a competitor. On day one a price is for learning, so it suggests a round number in the right order of magnitude, shipped quickly. Tiers follow good-better-best, with the top tier at 2-3 times the middle one. It describes Van Westendorp surveys (four questions that find an acceptable price range) and MaxDiff (ranking which features matter), noting that a survey intersection isn't proof of the best price. The pricing page teardown checks clarity, transparency and whether AI assistants can read and quote your prices, with a quick test of asking one for your plans. Upgrade screens inside the product go to the repo's paywalls skill.",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/pricing"
        },
        "tags": [
