          "effect:local",
          "needs:cli",
          "needs:account",
          "needs:browser",
          "by:community",
          "stack:gemini",
          "image",
          "ai-generation"
        ],
        "note": "Uses an unofficial, reverse-engineered Gemini web API with your Google login cookies; it may break without notice."
      }
