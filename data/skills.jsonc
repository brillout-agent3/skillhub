      "agentReview": {
        "description": "Converts local PDF, Word, Excel, HTML and other documents to Markdown through the Firecrawl CLI, or summarizes them or answers questions.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "the input is a file on disk, such as a PDF, DOCX, ODT, RTF, XLSX or HTML file, not a URL"
            },
            {
              "label": "It does",
