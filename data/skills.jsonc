      "id": "wshobson/agents/plugins/security-scanning/skills/threat-mitigation-mapping",
      "name": "threat-mitigation-mapping",
      "skills.sh": {
        "url": "https://skills.sh/wshobson/agents/threat-mitigation-mapping",
        "installs": 21000,
        "weeklyInstalls": [793, 949, 1159, 1185, 867, 853, 984, 964],
