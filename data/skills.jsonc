          "effect:local",
          "needs:account",
          "by:community",
          "image",
          "ai-generation"
        ],
        "note": "Needs an image generator: your agent's own image tool, as in Codex or Cursor, or the baoyu-image-gen skill, which needs an image API key."
      }
