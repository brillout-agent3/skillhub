    {
      "id": "emilkowalski/skills/skills/improve-animations",
      "name": "improve-animations",
      "skills.sh": {
        "url": "https://skills.sh/emilkowalski/skills/improve-animations",
        "installs": 253283,
        "weeklyInstalls": [11806, 13445, 14337, 15455, 17151, 17432, 19222, 17252],
        "firstSeen": "2026-07-11"
      },
      "skillMd": {
        "version": "c8a79627b59d72d764d6ab6f2c87c09a48169833",
