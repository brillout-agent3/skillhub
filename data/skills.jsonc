      "agentReview": {
        "description": "Grounds UI and web design work in researched references, styles, real screens and user flows, before building, then checks the result against them.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you're designing or redesigning a landing page, product screen, dashboard or flow and want it based on real references, not the model's default taste"
            },
            {
              "label": "It does",
              "text": "researches Refero's styles for visual direction, screens for UI patterns and flows for multi-step journeys, then picks one dominant direction"
            },
            {
              "label": "You get",
              "text": "a research summary, a \"reference lock\" of traits that must survive, and a decision ledger tracing each choice to a source, before any code"
