        "skew": 21
      },
      "agentReview": {
        "description": "Audits Core Web Vitals and loading performance.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a site loads slowly, or you want to improve its Core Web Vitals or Lighthouse performance score"
            },
            {
              "label": "It does",
              "text": "records a page-load trace in Chrome, then checks the metrics, network requests, accessibility and, if available, your code"
            },
            {
              "label": "You get",
              "text": "a report: metrics rated good to poor, top issues ranked by impact, specific fixes and code findings"
            },
            {
              "label": "Needs",
              "text": "browser tools such as the Chrome DevTools MCP server; without them it says what it couldn't measure"
            },
            {
              "label": "Works on",
              "text": "any website: it's published by Cloudflare but isn't tied to Cloudflare's products"
            }
          ],
          "text": "It works in five phases. First, the agent loads the page and records a trace of a fresh load. Second, it reads Chrome's insights, such as what delays the main content (LCP), which elements make the layout jump (CLS) and which files block rendering, and rates each metric against good, needs-improvement and poor thresholds. Third, it lists network requests to find blocking scripts, missing preloads, weak caching, oversized bundles and unused preconnects. Fourth, it takes an accessibility snapshot to flag gaps such as low contrast or controls without accessible names. Fifth, when the codebase is at hand, it detects the framework and bundler and checks tree-shaking, unused CSS, polyfills and compression. It's told to verify before recommending, quantify savings, skip changes with no measurable gain, name exact fixes (\"compress hero.png (450KB) to WebP\") and say so when a site is already fast.",
          "permalink": "https://github.com/cloudflare/skills/tree/86505e44f87d801aa1864a3c4109e9a8ae5c409f/skills/web-perf"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:none",
          "needs:browser",
          "needs:mcp",
          "by:official",
          "performance"
        ]
      }
    },
