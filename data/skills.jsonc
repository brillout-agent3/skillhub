      "skills.sh": {
        "url": "https://skills.sh/lllllllama/rigorpilot-skills/env-and-assets-bootstrap",
        "installs": 488755,
        "weeklyInstalls": [24, 30, 30, 41, 3494, 10908, 11041, 8737],
        "firstSeen": "2026-03-30"
