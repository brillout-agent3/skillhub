    {
      "id": "firecrawl/firecrawl-workflows/skills/firecrawl-seo-audit",
      "name": "firecrawl-seo-audit",
      "skills.sh": {
        "url": "https://skills.sh/firecrawl/firecrawl-workflows/firecrawl-seo-audit",
        "installs": 32300,
        "weeklyInstalls": [138, 91, 134, 120, 88, 95, 192, 159],
