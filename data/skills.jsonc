    {
      "id": "firecrawl/cli/skills/firecrawl-search",
      "name": "firecrawl-search",
      "skills.sh": {
        "url": "https://skills.sh/firecrawl/cli/firecrawl-search",
        "installs": 85053,
        "weeklyInstalls": [321, 464, 618, 513, 546, 501, 573, 414],
        "firstSeen": "2026-03-10"
      },
      "skillMd": {
        "version": "da25d5cd06db21cb33b100661cea0d9b89d457a3",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Searches the web, news and Firecrawl's catalog of data tools through the Firecrawl CLI, returning page excerpts or full content.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "the agent needs web sources for a question, recent news, US legal or regulatory sources, or structured records such as listings, transcripts or datasets"
            },
            {
              "label": "It does",
              "text": "runs firecrawl search, which returns web results with relevant excerpts plus matching tools from Alexandria, Firecrawl's catalog of data providers and site workflows"
            },
            {
              "label": "You get",
              "text": "results saved as JSON under .firecrawl/, optionally with each page's full content, and answers with source links"
            },
            {
              "label": "Needs",
              "text": "the Firecrawl CLI; without an API key, searches return web results only"
            },
            {
              "label": "Sends",
              "text": "feedback to Firecrawl after each search, which refunds one of its two credits, unless FIRECRAWL_NO_SEARCH_FEEDBACK=1 is set"
            },
            {
              "label": "Unlike the firecrawl skill",
              "text": "that is the overview of every command; this is the detailed guide to search, tool discovery and feedback"
            }
          ],
          "text": "The detailed companion to the main firecrawl skill for its search command. Results come with excerpts relevant to the query; --scrape adds each result's full page, which the agent reuses instead of scraping again. Other options cover news, time ranges, an index of GitHub issues, merged pull requests, READMEs and docs, and US federal, state and local legal sources through firecrawl gov, which filters by jurisdiction, court or cited statute. Before citing current law it checks the source's issuer, jurisdiction, status and version. With an API key, each search also matches Alexandria tools, by meaning and by the domains in the results; the agent reads a tool's contract, its inputs and coverage, before running it through scrape, and falls back to web results when none fits. After using the results it sends rated feedback in the background within about two minutes, listing every result it used and the content it expected but didn't find.",
          "permalink": "https://github.com/firecrawl/cli/tree/da25d5cd06db21cb33b100661cea0d9b89d457a3/skills/firecrawl-search"
        },
        "tags": [
          "category:browser",
          "type:tool",
          "needs:cli",
          "needs:account",
          "by:official",
          "stack:firecrawl",
          "flag:mirror",
          "effect:remote",
          "web-search",
          "research"
        ]
      }
    },
    {
      "id": "firecrawl/cli/skills/firecrawl-scrape",
      "name": "firecrawl-scrape",
      "skills.sh": {
        "url": "https://skills.sh/firecrawl/cli/firecrawl-scrape",
        "installs": 84124,
        "weeklyInstalls": [349, 460, 532, 463, 356, 337, 452, 377],
        "firstSeen": "2026-03-10"
      },
      "skillMd": {
        "version": "da25d5cd06db21cb33b100661cea0d9b89d457a3",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Reads web pages as clean Markdown or schema-typed JSON through the Firecrawl CLI, and runs data tools from Firecrawl's catalog.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "the agent has a URL, or a list of them, and needs the page content, structured fields from it, or results from a chosen data tool"
            },
            {
              "label": "It does",
              "text": "runs firecrawl scrape on pages, JavaScript-rendered ones included, or batch-scrape for many URLs, and runs Alexandria data tools from their contracts"
            },
            {
              "label": "You get",
              "text": "Markdown or JSON saved under .firecrawl/, read in small pieces rather than dumped into context"
            },
            {
              "label": "Needs",
              "text": "the Firecrawl CLI and Firecrawl credits; a PDF costs a credit per parsed page, capped with --max-pages"
            },
            {
              "label": "Unlike firecrawl-interact",
              "text": "scrape only reads; pages that need clicks, forms or a login go to interact"
            }
          ],
          "text": "The detailed companion to the main firecrawl skill for reading known pages. A scrape returns the page's main content as Markdown by default, the whole page with --full-page, links or other formats on request, and typed fields when given a JSON schema. A few URLs can be scraped at once as Markdown; batch-scrape takes longer lists as a job, with other formats, one schema for all pages, or a webhook. --query asks one question about a page for 5 extra credits, though the skill prefers saving the page and searching it. Structured data can also come from Alexandria, Firecrawl's catalog of data providers: the agent reads a tool's contract, its required inputs, response shape and pagination, and checks every result item for errors, not just the overall status. When output is too large for the agent, it recovers the kept result by its ID rather than repeating a paid call. For PDFs it caps the pages parsed and checks how many were.",
          "permalink": "https://github.com/firecrawl/cli/tree/da25d5cd06db21cb33b100661cea0d9b89d457a3/skills/firecrawl-scrape"
        },
        "tags": [
          "category:browser",
          "type:tool",
          "needs:cli",
          "needs:account",
          "by:official",
          "stack:firecrawl",
          "flag:mirror",
          "effect:local",
          "scraping"
        ]
      }
    },
    {
      "id": "firecrawl/cli/skills/firecrawl-agent",
      "name": "firecrawl-agent",
      "skills.sh": {
        "url": "https://skills.sh/firecrawl/cli/firecrawl-agent",
        "installs": 81815,
        "weeklyInstalls": [308, 306, 480, 532, 479, 430, 392, 325],
        "firstSeen": "2026-03-10"
      },
      "skillMd": {
        "version": "da25d5cd06db21cb33b100661cea0d9b89d457a3",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Sends Firecrawl's AI agent through websites to collect structured data across many pages, returned as JSON.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "the data you need spans pages of complex sites and no ready-made tool in Firecrawl's catalog covers it"
            },
            {
              "label": "It does",
              "text": "runs firecrawl agent with a prompt, an optional JSON schema and starting URLs; Firecrawl's agent navigates and extracts, taking two to five minutes"
            },
            {
              "label": "You get",
              "text": "a JSON file under .firecrawl/, or a job ID to check later"
            },
            {
              "label": "Needs",
              "text": "the Firecrawl CLI and Firecrawl credits; agent runs cost more than scrapes, and --max-credits caps spending"
            },
            {
              "label": "Asks first",
              "text": "with --require-approval, a run stops for your go-ahead instead of making a paid provider call"
            },
            {
              "label": "Unlike firecrawl-scrape",
              "text": "scrape is faster and cheaper for one page; the agent decides on its own where to go"
            }
          ],
          "text": "Before starting, the agent checks Alexandria, Firecrawl's catalog of data providers and site workflows, for a tool that already returns the records, and uses it instead when it fits. A run can also call connected providers, such as Apollo or Crunchbase, when started with flags that name them, cap the number of calls or require approval. A provider whose terms an organization admin hasn't accepted in the Firecrawl dashboard won't continue, and approving the call doesn't accept them. Jobs can be waited on, polled or cancelled by ID. A schema keeps the output predictable; without one the agent returns free-form data. The skill also shows how to send feedback on an Alexandria session, which refunds a credit.",
          "permalink": "https://github.com/firecrawl/cli/tree/da25d5cd06db21cb33b100661cea0d9b89d457a3/skills/firecrawl-agent"
        },
        "tags": [
          "category:browser",
          "type:tool",
          "needs:cli",
          "needs:account",
          "by:official",
