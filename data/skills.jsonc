    {
      "id": "wshobson/agents/plugins/startup-business-analyst/skills/startup-financial-modeling",
      "name": "startup-financial-modeling",
      "skills.sh": {
        "url": "https://skills.sh/wshobson/agents/startup-financial-modeling",
        "installs": 13000,
        "weeklyInstalls": [211, 226, 265, 347, 297, 250, 250, 231],
