      "agentReview": {
        "description": "Pentests a web app, API, codebase, URL or domain with Strix's autonomous agents, returning findings validated by working proof-of-concept exploits.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want to pentest or security-scan an app, API, repo or URL and get exploit-proven findings"
            },
            {
              "label": "It does",
              "text": "runs autonomous AI pentesting agents that exploit the target in a sandbox and validate each finding with a proof-of-concept"
            },
            {
              "label": "You get",
              "text": "a report plus per-finding files with PoC and remediation, as Markdown, JSON, CSV and SARIF"
