    {
      "id": "rohitg00/agentmemory/plugin/skills/commit-context",
      "name": "commit-context",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/agentmemory/commit-context",
        "installs": 14200,
        "weeklyInstalls": [375, 396, 372, 342, 312, 331, 319, 294],
        "firstSeen": "2026-05-18"
      },
      "skillMd": {
        "version": "f0f7378ac42849b863fcc5c8e753f120d5ec6f9d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Traces a file, function or line to its commit and the agent session that produced it, through git and agentmemory.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you ask why some code is here, who wrote it, or what the agent was doing when it changed"
            },
            {
              "label": "It does",
              "text": "finds the commit with git blame or git log, then looks it up in agentmemory for the agent session linked to it"
            },
            {
              "label": "You get",
              "text": "the commit's sha, branch, author and message, the linked session's summary and observation count, and its important observations"
            },
            {
              "label": "Needs",
              "text": "agentmemory's memory server and MCP tools, and git"
            },
            {
              "label": "Older commits",
              "text": "made before session linking show no session, and the agent says so rather than guessing intent from the diff"
            }
          ],
          "text": "Part of agentmemory, a memory server that records what coding agents do in each session as observations. commit-context works backwards from code to the session linked to its commit. For a line range the agent runs git blame, for a function git log -L, and for a bare file path the last commit that touched it. It looks the full sha up in agentmemory and presents the commit, the linked sessions with their project, start and end, observation count and summary, and the observations of importance 7 or more when memory recall is available. When the lookup finds no commit record, the commit predates session linking: the agent says so and describes only what git shows, claiming no intent beyond what the observations state. commit-history lists many linked commits at once.",
          "permalink": "https://github.com/rohitg00/agentmemory/tree/f0f7378ac42849b863fcc5c8e753f120d5ec6f9d/plugin/skills/commit-context"
        },
        "tags": [
          "category:agents",
          "category:engineering",
          "type:tool",
          "effect:none",
          "needs:mcp",
          "by:official",
          "stack:agentmemory",
          "stack:git",
          "memory",
          "git"
        ]
      }
    },
    {
      "id": "rohitg00/agentmemory/plugin/skills/commit-history",
      "name": "commit-history",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/agentmemory/commit-history",
        "installs": 14200,
        "weeklyInstalls": [372, 394, 373, 341, 312, 331, 315, 295],
        "firstSeen": "2026-05-18"
      },
      "skillMd": {
        "version": "f0f7378ac42849b863fcc5c8e753f120d5ec6f9d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Lists recent git commits linked to agent sessions in agentmemory, optionally by branch or repo, with each commit's session.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want to see what the agent has shipped: commits alongside the sessions that produced them"
            },
            {
              "label": "It does",
              "text": "lists the git commits linked to agent sessions in agentmemory, filtered by branch or repo if you ask, up to 100 by default and 500 at most"
            },
            {
              "label": "You get",
              "text": "newest first: short sha, branch, date, first line of the message, linked session ids with observation counts, and file counts"
            },
            {
              "label": "Needs",
              "text": "agentmemory's memory server running, with its MCP tools connected to your agent"
            },
            {
              "label": "Unlike commit-context",
              "text": "which traces one piece of code to its session, this lists many commits"
            }
          ],
          "text": "Part of agentmemory, a memory server that records what coding agents do in each session as observations. commit-history lists the git commits linked to those sessions. You can filter by branch and by repository URL or a fragment of it, and set a limit; a bare number is the limit, and by default there's no filter and up to 100 commits, capped at 500. The list shows only what the tool returned, newest first, with the short sha, branch, authored time, first line of the message, the linked sessions' short ids with their observation counts, and the number of files when given. An empty result means the filter matched nothing, and the agent suggests dropping the branch or repo filter. When the MCP tools are missing and it calls agentmemory's REST API instead, it URL-encodes every filter value.",
          "permalink": "https://github.com/rohitg00/agentmemory/tree/f0f7378ac42849b863fcc5c8e753f120d5ec6f9d/plugin/skills/commit-history"
        },
