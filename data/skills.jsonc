      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/video",
        "installs": 92784,
        "weeklyInstalls": [2659, 2461, 2490, 2855, 3073, 3233, 3478, 4205],
        "firstSeen": "2026-04-24"
      },
      "skillMd": {
        "version": "96798cf38736ecdba015a1d2b0521b0c8f8f41dd",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Guides marketing video production: picks programmatic, AI-generated, avatar or editing tools and lays out workflows for demos, explainers and batches of social clips.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a product demo, explainer, social clip or ad video and aren't sure which tools to use"
            },
            {
              "label": "It does",
              "text": "chooses among code-built video (Hyperframes, Remotion), AI footage (Veo, Runway, Kling), AI avatars (HeyGen, Synthesia) and editing tools"
            },
            {
              "label": "You get",
              "text": "a tool choice, video-model prompts and production workflows; with code or API access, the agent can build the video itself"
            },
            {
              "label": "Also covers",
              "text": "copying a reference video's edit style as a beat sheet, without its footage, script or music"
            },
            {
              "label": "Unlike social",
              "text": "from the same repo, which decides what to post, this covers how to make the video"
            }
          ],
          "text": "Video production for marketing, organized by approach. Programmatic video means building videos with code for templated or data-driven content: Hyperframes compositions are HTML files animated by a GSAP timeline, Remotion compositions are React components, and the skill picks whichever matches what your team already writes. AI generation covers B-roll and scenes you can't film, with a comparison of models on resolution, length and cost, and prompts built from subject, action, camera, style and mood. AI avatars from HeyGen (which has an MCP server) or Synthesia present scripts without filming. Editing tools such as Descript, Opus Clip and CapCut turn long recordings into short clips. Workflows cover product demos, explainers, batch social clips and personalized films per target account, and references cover recording a web app demo with Playwright and rendering product films from code. With Hyperframes, the HeyGen MCP server or a video model's API, an agent can run the whole pipeline itself, from script to assembled final cut. It warns against AI-generated text in video and against skipping captions. It reads your product marketing context first if you have it (a shared file the repo's product-marketing skill writes) and asks about your API keys and budget.",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/video"
        },
