        "installs": 119601,
        "weeklyInstalls": [2565, 2381, 2350, 2705, 2910, 3076, 3159, 3704],
        "firstSeen": "2026-02-27"
      },
      "skillMd": {
        "version": "96798cf38736ecdba015a1d2b0521b0c8f8f41dd",
