      },
      "skillMd": {
        "version": "96798cf38736ecdba015a1d2b0521b0c8f8f41dd",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Optimizes your content to be cited in AI answers from ChatGPT, Perplexity, Google AI Overviews and other assistants.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want your brand cited in AI answers from ChatGPT, Perplexity, Claude, Gemini, Copilot or Google AI Overviews"
            },
            {
              "label": "It does",
              "text": "audits where you're cited today, then improves pages along three lines: structure AI can quote, authority worth citing, and presence where AI looks"
            },
            {
              "label": "You get",
              "text": "a citation audit by query and platform, page fixes, AI crawler rules for robots.txt, files such as llms.txt and pricing.md, and a monitoring routine"
            },
            {
              "label": "Unlike seo-audit",
              "text": "from the same repo, which diagnoses classic search ranking, it targets being quoted by AI assistants"
            },
            {
              "label": "Keeps in view",
              "text": "Google's stance that AI Overviews need no special files or markup, and no content written separately for AI"
            }
          ],
          "text": "AI SEO, also called AEO or GEO (answer or generative engine optimization), means getting quoted as a source in AI-generated answers. After reading your product marketing context if you have it (a shared file on your product, audience and positioning that the repo's product-marketing skill writes), it asks about your current AI visibility, content, goals and competitors. The audit runs 10 to 20 queries that matter for revenue across AI platforms, compares who gets cited, checks each priority page for self-contained answers, sourced statistics, schema, named authors and freshness, and reviews which AI crawlers you let in, keeping search, user-triggered and training bots apart. Fixes lead each section with a direct 40 to 60 word answer, add cited numbers and expert quotes, and build presence on Wikipedia, Reddit, review sites, YouTube and LinkedIn. Because AI answers vary, it has you run each query several times and track a citation rate. References go deeper on agent-readable sites, attribution, wrong answers about your product and each platform, and it warns that its statistics drift.",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/ai-seo"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "seo",
          "marketing"
        ]
      }
    },
    {
      "id": "coreyhaines31/marketingskills/skills/copy-editing",
      "name": "copy-editing",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/copy-editing",
        "installs": 157275,
        "weeklyInstalls": [3556, 3216, 3466, 4320, 4743, 4276, 4438, 5072],
        "firstSeen": "2026-01-19"
      },
      "skillMd": {
        "version": "96798cf38736ecdba015a1d2b0521b0c8f8f41dd",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Edits existing marketing copy in focused passes and strips AI tells, without changing its message.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you have marketing copy, or an aging page, and want it tightened, polished or refreshed rather than rewritten"
            },
            {
              "label": "It does",
              "text": "picks a mode first: rebuild generic or AI-sounding copy from the facts, restore a draft's own voice, or change only the line you asked about"
            },
            {
              "label": "You get",
              "text": "specific edits, each with a reason; a point edit returns only the changed lines"
            },
            {
              "label": "Removes",
              "text": "AI tells such as \"it's not X, it's Y\", \"no X, no Y\" lists and stock openers, marking missing facts [NEED: ...] instead of inventing them"
            },
            {
              "label": "Unlike copywriting",
              "text": "from the same repo, it improves copy you already have instead of writing new pages"
            }
          ],
          "text": "Copy editing in seven sweeps, each checking one thing: clarity, voice and tone, \"so what\" (does every claim say why the reader should care), proof, specificity, emotion, and risk (what still stops someone from acting). After each sweep it rechecks the earlier ones, so one fix doesn't undo another. A point edit skips the sweeps and touches only what you asked about. It first reads your product marketing context if you have it (a shared file on your product, audience and positioning that the repo's product-marketing skill writes), to keep your brand's voice and your customers' words. After the sweeps, high-stakes copy goes to a panel of 3 to 5 expert personas, always for launch copy, pricing pages and high-traffic landing pages: each scores it from 1 to 10, and it revises until every score is at least 7 and the average reaches 8. Quick checks cover weak words, sentence length and paragraphs, and an AI-tell check runs on every edit. A reference on content refresh covers updating pages that have gone stale. When editing with you, it proposes changes and leaves final decisions to the author.",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/copy-editing"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "copywriting",
          "writing",
          "anti-slop"
        ]
      }
    },
