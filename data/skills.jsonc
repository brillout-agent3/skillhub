    {
      "id": "firecrawl/cli/skills/firecrawl-monitor",
      "name": "firecrawl-monitor",
      "skills.sh": {
        "url": "https://skills.sh/firecrawl/cli/firecrawl-monitor",
        "installs": 33600,
        "weeklyInstalls": [261, 281, 290, 337, 233, 231, 217, 215],
        "firstSeen": "2026-05-28"
      },
      "skillMd": {
        "version": "da25d5cd06db21cb33b100661cea0d9b89d457a3",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Sets up Firecrawl monitors that check pages, sites or web searches on a schedule and alert you by email or webhook when something changes.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want to hear when a page, a set of pages or a whole site changes, or when new web results match a goal"
            },
            {
              "label": "It does",
              "text": "creates monitors with a schedule in plain words and a goal saying what matters; Firecrawl fetches, compares, judges and notifies on its servers"
            },
            {
              "label": "You get",
              "text": "a monitor confirmed by a test check, and email or webhook alerts; each checked page is labeled same, new, changed, removed or error"
            },
            {
              "label": "Needs",
              "text": "the Firecrawl CLI and a Firecrawl account; each check costs credits, and zero-data-retention teams can't use monitoring"
            },
            {
              "label": "Runs",
              "text": "until paused or deleted, as often as every five minutes"
            },
            {
              "label": "Unlike firecrawl-scrape",
              "text": "for checking the same URL more than once; one monitor replaces repeated scrapes"
            }
          ],
          "text": "It has four target modes: one page, a batch of URLs, every page a crawl finds, or web searches that alert on results not seen before, which need a goal. The goal, two or three sentences starting \"Alert when\", is what Firecrawl's AI judge uses to decide whether a page changed in a way that matters; a guide that ships with the skill shows how to write it, and the queries of a search monitor. A second guide covers tracking fields such as a price or a stock flag, which reports each field's old and new value instead of a text diff. After creating a monitor the agent triggers a check right away to confirm the target, state and notifications. Other commands list, inspect, update, pause and delete monitors and filter a check's pages to the changed ones. External email recipients must confirm by email before they get alerts. On a rate-limit error it waits about 30 seconds and retries once; if that fails, it stops and deletes the monitors it created for the task.",
          "permalink": "https://github.com/firecrawl/cli/tree/da25d5cd06db21cb33b100661cea0d9b89d457a3/skills/firecrawl-monitor"
        },
        "tags": [
          "category:browser",
          "type:tool",
          "needs:cli",
          "needs:account",
          "by:official",
          "stack:firecrawl",
          "flag:mirror",
          "effect:remote",
          "scraping",
          "web-search"
        ],
        "note": "Monitors keep running on Firecrawl's servers, using credits on every check, until you pause or delete them."
      }
    },
    {
      "id": "addyosmani/agent-skills/skills/code-review-and-quality",
      "name": "code-review-and-quality",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/agent-skills/code-review-and-quality",
        "installs": 82125,
        "weeklyInstalls": [3503, 4573, 4388, 4720, 5783, 6429, 6032, 5359],
        "firstSeen": "2026-02-16"
      },
      "skillMd": {
        "version": "301b02b12bff98e4688e6984af6556802322bbde",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Reviews a change on five axes, correctness, readability, architecture, security and performance, with every finding labelled by severity.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a change, diff or pull request needs reviewing before it merges, whether you, another agent or a person wrote it"
            },
            {
              "label": "It does",
              "text": "reads the tests first, walks each file for correctness, readability, architecture, security and performance, then checks how the author verified it"
            },
            {
              "label": "You get",
              "text": "findings ordered by impact, each marked Critical, required, Optional, Nit or FYI, and a verdict: approve or request changes"
            },
            {
              "label": "Also checks",
              "text": "that the tests would catch a regression, by flipping one condition and rerunning them; plus change size, dead code and dependency upgrades"
            }
          ],
          "text": "Its approval standard: approve a change once it clearly improves the health of the codebase, even if it isn't perfect. The agent first asks what the change is for and which spec it implements, then reads the tests, and proves they'd catch a regression by inverting one condition the change adds, running the suite and restoring the file. Then it goes file by file through the five axes, with concrete questions such as N+1 queries, unvalidated input, feature logic leaking into shared modules, or a refactor that only moves complexity around. Before reporting, it drops findings that callers, guards or tests rule out, separates old defects from new regressions, and accepts zero findings as a valid result. When it flags a structural problem it names the fix, such as replacing a chain of conditionals with a dispatcher. Other sections cover change sizing (about 100 lines is good, 1,000 should be split), commit descriptions, listing dead code and asking before deleting it, reviewing dependency upgrades one package at a time against their changelog, and having a second model review the first one's code. It ends with a review checklist.",
          "permalink": "https://github.com/addyosmani/agent-skills/tree/301b02b12bff98e4688e6984af6556802322bbde/skills/code-review-and-quality"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "code-review",
          "code-quality"
        ]
      }
    },
    {
      "id": "addyosmani/agent-skills/skills/security-and-hardening",
      "name": "security-and-hardening",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/agent-skills/security-and-hardening",
        "installs": 79452,
        "weeklyInstalls": [3568, 4463, 4543, 4846, 6068, 6709, 6347, 5802],
        "firstSeen": "2026-02-16"
      },
      "skillMd": {
        "version": "301b02b12bff98e4688e6984af6556802322bbde",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Threat-models a feature, then hardens it against injection, broken access control, leaked secrets, risky dependencies, privacy gaps and LLM prompt injection.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you build or audit anything that takes user input, handles logins, sessions or personal data, calls outside services, or adds a dependency"
            },
            {
              "label": "It does",
              "text": "maps where untrusted data enters and what's worth stealing, asks the six STRIDE questions of each entry point, then applies hardening rules"
            },
            {
              "label": "Rules",
              "text": "always validate input, parameterize queries and hash passwords; ask you before changing auth, CORS or uploads; never commit secrets or log tokens"
            },
            {
              "label": "Also covers",
              "text": "dependency audits and supply-chain risk, server-side URL fetches, unsafe deletes, rate limiting, privacy rules such as GDPR, and features that call an LLM"
            }
          ],
          "text": "Before any control, the agent spends five minutes thinking like an attacker: it maps the trust boundaries where outside data enters, including LLM output and values handed over by other processes, names the assets worth stealing, and asks the six STRIDE questions of each boundary: can someone impersonate a user, tamper with data, deny an action, read what they shouldn't, overwhelm the system or gain rights? Abuse cases become the first tests. Rules come in three tiers: always do (validate at the boundary, parameterize queries, encode output, hash passwords, set security headers and safe cookies), ask first (new auth flows, new kinds of sensitive data, CORS, uploads, permissions), and never do (secrets in git, sensitive data in logs, eval or innerHTML on user input). Each control, from SSRF and rate limiting to secrets and dependency audits, links to worked code in a file that ships with the skill. Personal data is treated as a liability, with a purpose, a retention limit and a working deletion path. LLM features map to OWASP's LLM Top 10: model output is untrusted input, and the system prompt isn't a security boundary. Sign-off walks a security checklist kept in the repo's shared folder.",
          "permalink": "https://github.com/addyosmani/agent-skills/tree/301b02b12bff98e4688e6984af6556802322bbde/skills/security-and-hardening"
        },
        "tags": [
          "category:security",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "security",
          "privacy"
        ],
        "note": "Installed alone, it lacks the repo-wide security checklist its sign-off step walks; install the whole repo to get it."
      }
    },
    {
      "id": "addyosmani/agent-skills/skills/frontend-ui-engineering",
      "name": "frontend-ui-engineering",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/agent-skills/frontend-ui-engineering",
        "installs": 75953,
        "weeklyInstalls": [3273, 4281, 4248, 4230, 5448, 6141, 5840, 5315],
        "firstSeen": "2026-02-16"
      },
      "skillMd": {
        "version": "301b02b12bff98e4688e6984af6556802322bbde",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Shapes UI code: composable components, simple state, your design system's tokens, WCAG 2.1 AA accessibility and no generic AI look.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "the agent builds or changes components, pages or layouts, and you want them to look designed rather than generated"
            },
            {
              "label": "It does",
              "text": "gives rules for component structure, state, spacing, type, color, accessibility, responsive layout and loading states, with React and Tailwind examples"
            },
            {
              "label": "Avoids",
              "text": "the AI defaults: purple gradients, rounded everything, oversized padding, stock card grids, heavy shadows and placeholder copy"
            },
            {
              "label": "Checks",
              "text": "keyboard access, screen-reader structure, layouts at 320 to 1440 pixels wide, and loading, empty, error and permission states"
            }
          ],
          "text": "A set of rules the agent applies while writing UI code. Components live with their tests and hooks, favour composition over long prop lists, do one thing, and keep data fetching apart from rendering. State starts as simple as possible, from local state up to a global store only when needed, with no prop drilling past three levels. When the product needs its own look, the agent studies two or three reference screens and writes a short design contract before building, without copying another product's branding. A table names the AI defaults to avoid and what to use instead: the project's palette, its spacing scale, its corner radii, real content. Accessibility targets WCAG 2.1 AA: everything works by keyboard, controls are labelled, focus moves into dialogs, contrast is at least 4.5:1 and color never carries meaning alone. Layouts are mobile-first and checked at four widths, content loads with skeletons rather than spinners, and updates can show before the server confirms them. The examples are React with Tailwind.",
          "permalink": "https://github.com/addyosmani/agent-skills/tree/301b02b12bff98e4688e6984af6556802322bbde/skills/frontend-ui-engineering"
        },
        "tags": [
          "category:design",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "stack:react",
          "stack:tailwind",
          "design",
          "accessibility",
          "design-system",
          "anti-slop"
        ]
      }
    },
    {
      "id": "addyosmani/agent-skills/skills/performance-optimization",
      "name": "performance-optimization",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/agent-skills/performance-optimization",
        "installs": 73402,
        "weeklyInstalls": [3156, 4169, 3900, 4246, 5431, 6229, 5793, 5155],
        "firstSeen": "2026-02-16"
      },
      "skillMd": {
        "version": "301b02b12bff98e4688e6984af6556802322bbde",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Measures before optimizing: finds the real bottleneck, fixes only that, re-measures, and reverts any change that doesn't beat the noise.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "pages load slowly, Core Web Vitals miss their targets, an endpoint drags, or a change may have made things slower"
            },
            {
              "label": "It does",
              "text": "measures a baseline, finds the actual bottleneck, fixes that one thing, re-measures the same way, then adds a guard against regression"
            },
            {
              "label": "Keeps",
              "text": "a change only if it beats run-to-run variance with tests still green; anything neutral or worse is reverted, and every attempt is logged"
            },
            {
              "label": "Covers",
              "text": "frontend and backend: images, re-renders, bundle size, N+1 queries, query plans and indexes, connection pools and caching"
            }
          ],
          "text": "Its rule is measure first: no optimization without data. Step one takes a baseline, both lab measurements such as Lighthouse or a DevTools trace and real-user data from the web-vitals library, and a decision tree points from the symptom (slow first load, sluggish clicks, a slow endpoint) to what to measure. Step two names the bottleneck from tables of likely causes. Step three fixes only that, with rules for the usual suspects: N+1 queries, missing pagination, indexes judged by EXPLAIN ANALYZE rather than guessed, connection pools sized to the database's limit, caches keyed on every input, images with dimensions and modern formats, needless re-renders, code splitting. Step four re-measures under the same conditions and decides strictly: keep only a gain past the noise with tests green, otherwise revert, and log every attempt, kept or reverted, in the PR or a PERF.md so dead ideas aren't retried. Step five guards the user-facing metric with a CI budget and field monitoring. Targets are the Core Web Vitals \"good\" thresholds, LCP 2.5 s, INP 200 ms and CLS 0.1, plus default budgets such as 200 KB of gzipped JavaScript.",
          "permalink": "https://github.com/addyosmani/agent-skills/tree/301b02b12bff98e4688e6984af6556802322bbde/skills/performance-optimization"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "performance",
          "databases",
          "verification"
        ]
      }
