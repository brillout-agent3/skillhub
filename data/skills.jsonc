    {
      "id": "addyosmani/web-quality-skills/skills/accessibility",
      "name": "accessibility",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/web-quality-skills/accessibility",
        "installs": 67685,
        "weeklyInstalls": [1936, 1769, 2156, 1902, 2016, 1773, 1923, 1925],
        "firstSeen": "2026-01-20"
      },
      "skillMd": {
        "version": "afa8da942115f2961fdbfa80807ea0b232ff6c00",
        "updated": "2026-10-20",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits and fixes accessibility against WCAG 2.2.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a web page or app checked and fixed against WCAG 2.2, the web accessibility standard"
            },
            {
              "label": "It does",
              "text": "runs a Lighthouse audit, inspects the accessibility tree, tries the flow by keyboard, edits the code to fix what fails, then audits again"
            },
            {
              "label": "You get",
              "text": "fixed code, guided by rules and before-and-after HTML, CSS and JavaScript for each WCAG area"
            },
            {
              "label": "Works with",
              "text": "Chrome DevTools MCP if available, otherwise the Lighthouse CLI or axe"
            },
            {
              "label": "Unlike web-design-guidelines",
              "text": "Vercel's skill that reviews UI code against its design rules, it tests the rendered page and fixes what fails"
            }
          ],
          "text": "When a rendered page is available, it starts from what actually fails: the failing elements in the Lighthouse report point to the component to fix, a snapshot of the accessibility tree shows names, roles, headings and landmarks, and the agent walks the flow with the keyboard. It warns that automated tools catch only some problems, so a score of 100 doesn't mean the page conforms. The rest is a reference organized by WCAG's four principles (perceivable, operable, understandable, robust), with before-and-after code: alt text, contrast ratios, keyboard access, visible focus, skip links, form labels, error messages, native elements over ARIA, live announcements. It flags what's new in WCAG 2.2: tap targets of at least 24 pixels, focus never hidden behind sticky headers, alternatives to dragging, not asking for the same information twice, logins that allow paste or passkeys. It ends with a manual checklist (screen readers, 200% zoom, reduced motion) and common issues ranked by impact.",
          "permalink": "https://github.com/addyosmani/web-quality-skills/tree/afa8da942115f2961fdbfa80807ea0b232ff6c00/skills/accessibility"
        },
        "tags": [
          "category:design",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "accessibility"
        ]
      }
    },
