    {
      "id": "lllllllama/rigorpilot-skills/skills/ai-research-explore",
      "name": "ai-research-explore",
      "skills.sh": {
        "url": "https://skills.sh/lllllllama/rigorpilot-skills/ai-research-explore",
        "installs": 350165,
        "weeklyInstalls": [63, 49, 55, 65, 3522, 10928, 11047, 8763],
        "firstSeen": "2026-05-26"
      },
      "skillMd": {
        "version": "fb3ccdf5aa64b1fa5b1d0463e666a8bc8bc26e01",
        "updated": "2026-10-20",
        "skew": 0
      },
      "agentReview": {
        "description": "Explores novel research candidates on top of a reproduced baseline.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you have a working baseline and want to try new research ideas on top of it, with the benchmark and evaluation fixed in advance"
            },
            {
              "label": "It does",
              "text": "ranks candidate ideas, tests them one at a time on an isolated branch, and compares each with the baseline"
            },
            {
              "label": "You get",
              "text": "results in explore_outputs, marked as candidates and never as reproduced results, with notes on what changed and how comparable they are"
            },
            {
              "label": "Needs",
              "text": "you to ask for exploration explicitly, and a saved baseline: a branch, commit, checkpoint or run record"
            },
            {
              "label": "Unlike RigorPilot's reproduction skills",
              "text": "it tries new ideas instead of rerunning what the README documents"
            }
          ],
          "text": "The exploration side of RigorPilot, a set of skills that reproduces deep-learning research code by following its README, kept separate from its reproduction work. You fix the ground rules first: task, dataset, benchmark, how results are evaluated, the state-of-the-art results you compare against, and a compute budget. The agent then alternates between planning and trying. While planning, it studies the repo, keeps your own ideas, adds a few single-change ideas of its own, looks up supporting papers (in a local reference manager such as Zotero first, the web optionally) and ranks ideas by expected gain, cost, risk and ease of rollback. While trying, it makes one bounded change or run, checks it quickly, collects evidence and ranks it against the baseline; measured results outrank predictions. It stops for you at blockers, unclear scientific meaning, an exhausted budget or ideas too close to call. It won't call a gain new or state-of-the-art without a literature comparison, ablations and a fair comparison.",
          "permalink": "https://github.com/lllllllama/rigorpilot-skills/tree/fb3ccdf5aa64b1fa5b1d0463e666a8bc8bc26e01/skills/ai-research-explore"
        },
        "tags": [
          "category:science",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "stack:python",
          "ml-research",
          "research"
        ]
      }
    },
