      "agentReview": {
        "description": "Defines brand voice and visual identity in one guidelines file, syncs its colors into design tokens, and checks assets against it.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want one source of truth for a brand's colors, fonts and voice that design tokens and generated content follow"
            },
            {
              "label": "It does",
              "text": "keeps docs/brand-guidelines.md as the source, syncs it to design-tokens.json and design-tokens.css, and extracts brand context for prompts"
