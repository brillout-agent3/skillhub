        "skew": 0
      },
      "agentReview": {
        "description": "Formats a draft into scannable Markdown with frontmatter, headings, bold and lists, changing no words beyond obvious typos.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a draft or plain text needs structure before publishing: headings, emphasis, lists and a title"
            },
            {
              "label": "It does",
              "text": "works out what a reader should notice, adds frontmatter, headings, bold, lists, tables and code blocks, then runs a typography script"
            },
            {
              "label": "You get",
              "text": "<name>-formatted.md and <name>-analysis.md beside the original, with your wording kept apart from obvious typos"
            },
            {
              "label": "Titles",
              "text": "4 or 5 candidates to pick from, two or three built on hook formulas and one or two plain ones"
            },
            {
              "label": "Typography",
              "text": "spacing between Chinese and English text, fixes for bold markers broken by CJK punctuation, and optional full-width quotes"
            },
            {
              "label": "Needs",
              "text": "Bun or npx"
            }
          ],
          "text": "Its rule is to change formatting only: no sentences added, cut or reworded, no editorializing headings and no over-formatting. For Markdown that's already formatted, it asks whether to improve the formatting, keep it and fix only typography, or fix typography directly in the original file. The analysis lists highlights, suggested sections, what a reader needs, formatting issues and typos. The frontmatter gets a title, a slug, a one-sentence summary and a longer description, both about the value to the reader rather than the topic, plus a cover path if imgs/cover.png exists. Title choice can be made automatic in its preferences. baoyu-markdown-to-html, from the same repo, offers to run it on Chinese, Japanese or Korean articles before converting.",
          "permalink": "https://github.com/jimliu/baoyu-skills/tree/ca703c2d7c2c4399a1dc0cf82224f8551e05a96d/skills/baoyu-format-markdown"
        },
        "tags": [
          "category:writing",
          "type:workflow",
          "effect:local",
          "needs:cli",
          "by:community",
          "writing"
        ]
      }
