    {
      "id": "addyosmani/web-quality-skills/skills/performance",
      "name": "performance",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/web-quality-skills/performance",
        "installs": 43100,
        "weeklyInstalls": [1354, 1165, 1131, 1011, 1048, 1057, 1110, 1091],
        "firstSeen": "2026-01-20"
      },
      "skillMd": {
        "version": "afa8da942115f2961fdbfa80807ea0b232ff6c00",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Speeds up web pages by measuring real-user and lab data first, fixing only the measured bottlenecks, then re-measuring.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a site loads slowly or feels sluggish and you want it faster, with numbers to show it"
            },
            {
              "label": "It does",
              "text": "sets a baseline from real-user Chrome data (CrUX) and a browser performance trace, changes only the code behind measured bottlenecks, then re-runs the same measurement"
            },
            {
              "label": "You get",
              "text": "code changes and a report of before and after values, test conditions and uncertainty; real-user confirmation is left pending"
            },
            {
              "label": "Without a live page",
              "text": "it inspects the source but labels findings as hypotheses, and gives the command or browser steps that would verify the high-impact ones"
            },
            {
              "label": "Works with",
              "text": "Chrome DevTools MCP traces if available, otherwise the Lighthouse CLI, PageSpeed Insights or CrUX tools"
            },
            {
              "label": "Unlike core-web-vitals",
              "text": "its sibling skill focused on three Core Web Vitals, it covers loading and runtime speed as a whole: budgets, images, fonts, caching, scripts"
            }
          ],
          "text": "The measurement workflow it reads first, shared with the repo's core-web-vitals and web-quality-audit skills, keeps evidence types apart: CrUX field data from real Chrome users decides whether users have a problem, a DevTools trace or Lighthouse run in the lab finds why, and code inspection only forms hypotheses. It tests mobile conditions by default, records the browser, throttling and cache state, takes the median of three runs for decisions, and never treats missing CrUX data as passing. The rest is a reference of fixes with code: a starting performance budget (1.5 MB page, 300 KB of JavaScript), server response and compression, preconnect, preloads only where a trace shows late discovery, Speculation Rules prerendering, deferred scripts and CSS, code splitting, AVIF and WebP images with srcset, font loading, Cache-Control and service workers, avoiding layout thrashing, virtualized lists, View Transitions, and delaying third-party widgets until needed. For production monitoring, it points to Google's web-vitals library over hand-written observers.",
          "permalink": "https://github.com/addyosmani/web-quality-skills/tree/afa8da942115f2961fdbfa80807ea0b232ff6c00/skills/performance"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "performance"
        ]
      }
    },
    {
      "id": "addyosmani/web-quality-skills/skills/web-quality-audit",
      "name": "web-quality-audit",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/web-quality-skills/web-quality-audit",
        "installs": 35300,
        "weeklyInstalls": [1147, 963, 941, 981, 1063, 1112, 1403, 1467],
        "firstSeen": "2026-01-20"
      },
      "skillMd": {
        "version": "afa8da942115f2961fdbfa80807ea0b232ff6c00",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits a site's performance, accessibility, SEO, best practices and agent readiness from live measurements, then makes or recommends fixes by severity.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want one review of a site's quality across speed, accessibility, search, security and how well AI agents can use it"
            },
            {
              "label": "It does",
              "text": "records a performance trace and runs Lighthouse audits, uses the failures to find the code responsible, then fixes or recommends fixes and re-runs the checks"
            },
            {
              "label": "You get",
              "text": "a report with an evidence table, issues from critical to low with file, impact and fix, a fix order, and what's still unverified"
            },
            {
              "label": "Works with",
              "text": "Chrome DevTools MCP if available, otherwise the Lighthouse CLI, PageSpeed Insights and manual checks; a bundled script gives a quick static scan"
            },
            {
              "label": "Unlike its siblings",
              "text": "it's the umbrella of Addy Osmani's web quality skills; performance, core-web-vitals, accessibility, seo and best-practices each go deep on one area"
            },
            {
              "label": "Install with",
              "text": "the repo's performance skill: it reads that skill's measurement workflow file"
            }
          ],
          "text": "It starts by settling the scope: which URLs, states and user journeys, logged in or not, mobile or desktop. With a runnable page, it collects a small live baseline before searching the codebase, and lets runtime failures point to the source, keeping measured findings apart from hypotheses found only in code. Performance goes through a browser trace, since the Lighthouse tool in Chrome DevTools MCP leaves performance out; accessibility, SEO, best practices and agentic browsing go through Lighthouse, plus an accessibility-tree snapshot and trying the UI. The checklist covers Core Web Vitals thresholds, images, scripts, fonts and caching; WCAG basics such as alt text, contrast, keyboard access and labels; crawlability and page tags; HTTPS, CSP and deprecated APIs; and agentic browsing, meaning whether an AI assistant can find and operate the page's controls, with WebMCP and llms.txt treated as optional. It warns that an aggregate score isn't proof of quality. Findings are ranked critical (fix now), high (before launch), medium (this sprint) or low. It ends with checklists for every deploy and for weekly and monthly reviews.",
          "permalink": "https://github.com/addyosmani/web-quality-skills/tree/afa8da942115f2961fdbfa80807ea0b232ff6c00/skills/web-quality-audit"
        },
        "tags": [
          "category:debugging",
          "category:design",
          "category:marketing",
          "category:security",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "performance",
          "accessibility",
          "seo",
          "security"
        ],
        "note": "Reads the measurement workflow in the performance skill's folder, so install the repo's performance skill with it."
      }
    },
    {
      "id": "addyosmani/web-quality-skills/skills/core-web-vitals",
      "name": "core-web-vitals",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/web-quality-skills/core-web-vitals",
        "installs": 33900,
        "weeklyInstalls": [1220, 1074, 1024, 1030, 1061, 1058, 1118, 1057],
        "firstSeen": "2026-01-20"
      },
      "skillMd": {
        "version": "afa8da942115f2961fdbfa80807ea0b232ff6c00",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Diagnoses and fixes slow loading, sluggish responses and layout shifts (LCP, INP, CLS) from real-user data and browser traces.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a page's Core Web Vitals fail: the main content appears late (LCP), clicks respond slowly (INP), or the layout jumps (CLS)"
            },
            {
              "label": "It does",
              "text": "checks real-user Chrome data at the 75th percentile, records a browser trace, reads only the insights for the failing metric, fixes the code behind it and re-measures"
            },
            {
              "label": "You get",
              "text": "fixes with lab before-and-after numbers; it won't claim a real-user improvement until new visits show one"
            },
            {
              "label": "Unlike performance",
              "text": "its sibling skill for loading and runtime speed in general, it targets these three metrics and their good, needs-work and poor thresholds"
            },
            {
              "label": "Install with",
              "text": "the repo's performance skill: it reads that skill's measurement workflow and real-user monitoring files"
            }
          ],
          "text": "LCP (Largest Contentful Paint) is when the biggest visible element renders, good at 2.5 seconds or less; INP (Interaction to Next Paint) is how fast the page responds to clicks, taps and key presses, good at 200 ms; CLS (Cumulative Layout Shift) measures unexpected jumps, good at 0.1. Each must be met by 75% of visits. With only source code, it names likely causes but won't call a metric failing without runtime evidence. For LCP it covers slow server response, render-blocking CSS, hero images discovered late, client-side rendering, and Speculation Rules prerendering of the likely next page, with its costs: each prerender is roughly a full page load and fires analytics early. LCP, INP and CLS each have a detailed reference file, read only when a trace or field data points to that metric. It adds quick fixes for Next.js, React and Vue/Nuxt, and recommends Google's web-vitals library over hand-written observers for production data.",
          "permalink": "https://github.com/addyosmani/web-quality-skills/tree/afa8da942115f2961fdbfa80807ea0b232ff6c00/skills/core-web-vitals"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "performance"
        ],
        "note": "Reads the measurement and real-user monitoring files in the performance skill's folder, so install the repo's performance skill with it."
      }
    },
    {
