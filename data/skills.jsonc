      "agentReview": {
        "description": "Triages Strix findings, patches the root cause, and re-runs Strix to prove each exploit is closed.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a Strix scan has reported findings and you want to remediate them"
            },
            {
              "label": "It does",
              "text": "orders findings by severity, fixes the root cause with framework defenses, then re-scans to confirm the exploit is gone"
