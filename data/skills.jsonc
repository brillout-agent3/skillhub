        "skew": 0
      },
      "agentReview": {
        "description": "Audits a site's technical and on-page SEO with Lighthouse, fixes the source, then re-runs the same checks.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a site's crawlability, page tags, structured data and mobile setup checked and fixed for search engines"
            },
            {
              "label": "It does",
              "text": "runs Lighthouse's SEO and Agentic Browsing audits, checks what Lighthouse can't (headers, redirects, robots.txt, sitemap, canonicals), fixes the source and re-runs them"
            },
            {
              "label": "You get",
              "text": "fixes in your code, with crawl and index problems kept apart from content quality, and ranking outcomes marked as still pending"
            },
            {
              "label": "Works with",
              "text": "Chrome DevTools MCP if available, otherwise the Lighthouse CLI plus direct source and HTTP checks"
            },
            {
              "label": "Won't",
              "text": "promise ranking changes or invent ranking-factor weights; a Lighthouse SEO score isn't treated as a ranking forecast"
            },
            {
              "label": "Unlike seo-audit",
              "text": "Corey Haines's skill that audits by checklist and ends with an action plan, it measures the rendered page and edits your code"
            }
          ],
          "text": "Part of Addy Osmani's web quality skills, built on Google Lighthouse and Google Search guidance. With a rendered page, the agent runs Lighthouse's SEO and Agentic Browsing audits, then inspects what those can't settle: response headers, redirects, robots.txt, sitemap coverage, canonical tags across page templates, structured-data eligibility, and Search Console data if you give it access. It fixes the source and runs the same checks again. The reference covers robots rules, XML sitemaps, URL structure, title tags and meta descriptions (lengths treated as rough guides, since Google rewrites and truncates them), heading hierarchy, image and link text, JSON-LD structured data, mobile viewport and tap targets, and hreflang for multilingual sites. It keeps three things apart: Lighthouse's Agentic Browsing score (how well an AI assistant can read and use the page), search ranking, and whether an AI product will cite you. It audits each AI crawler, such as OAI-SearchBot, Claude-SearchBot or Google-Extended, separately rather than blocking \"AI bots\" wholesale, and treats llms.txt as optional and experimental. It ends with a prioritized checklist, from critical items (HTTPS, no stray noindex) to ongoing work in Search Console.",
          "permalink": "https://github.com/addyosmani/web-quality-skills/tree/afa8da942115f2961fdbfa80807ea0b232ff6c00/skills/seo"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "seo"
        ]
      }
