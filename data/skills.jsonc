  "bundles": [
    {
      "id": "obra/superpowers",
      "skew": 5767,
      "agentReview": {
        "name": "Superpowers",
        "description": "A software development workflow: brainstorm, plan, build test-first, review, then merge.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want the agent to follow a full development process instead of jumping straight to code"
            },
            {
              "label": "It does",
              "text": "chains its skills into one workflow: brainstorm, plan, build test-first on its own branch, review, then merge"
            },
            {
              "label": "You get",
              "text": "an approved design, a written plan, tested commits and a review before anything merges"
            },
            {
              "label": "Runs",
              "text": "by itself: before every reply, the agent checks which of its skills applies"
            },
            {
              "label": "Works with",
              "text": "Claude Code, Codex, Cursor, Gemini CLI, OpenCode and more, each installed separately"
            }
          ],
          "text": "Superpowers makes its skills fire on their own: using-superpowers, loaded at the start of each session, has the agent check for a matching skill before every reply. Building something then follows one path. brainstorming asks what you actually want and ends with a design you approve, in chat for small changes or as a document for projects. using-git-worktrees sets up an isolated branch with a clean test baseline, and writing-plans breaks the design into small tasks, each with exact files, code and checks. The plan runs either through subagent-driven-development, a fresh subagent per task with a review after each, or through executing-plans, inline with one review at the end. Throughout, test-driven-development makes every change start from a failing test, and finishing-a-development-branch verifies the tests, then merges, opens a PR, keeps or discards the branch. Other skills step in when needed: systematic-debugging for bugs, verification-before-completion before claiming anything works, requesting-code-review and receiving-code-review around reviews, dispatching-parallel-agents for independent tasks, and writing-skills for writing new skills test-first.",
          "permalink": "https://github.com/obra/superpowers/tree/b739a8af570e10a95898f2bdf6cec97467fa6c12"
        },
        "skills": [
          {
            "id": "obra/superpowers/skills/using-superpowers",
            "standalone": false,
            "note": "Makes the agent load the other Superpowers skills before it replies; alone, it has nothing to load."
          },
          {
            "id": "obra/superpowers/skills/brainstorming",
            "standalone": true
          },
          {
            "id": "obra/superpowers/skills/using-git-worktrees",
            "standalone": true
          },
          {
            "id": "obra/superpowers/skills/writing-plans",
            "standalone": true
          },
          {
            "id": "obra/superpowers/skills/subagent-driven-development",
            "standalone": false,
            "note": "Executes a plan such as writing-plans writes, and has its final reviewer use the prompt that ships with requesting-code-review."
          },
          {
            "id": "obra/superpowers/skills/executing-plans",
            "standalone": false,
            "note": "Runs scripts that ship with subagent-driven-development, and loads test-driven-development and verification-before-completion."
          },
          {
            "id": "obra/superpowers/skills/test-driven-development",
            "standalone": true
          },
          {
            "id": "obra/superpowers/skills/requesting-code-review",
            "standalone": true
          },
          {
            "id": "obra/superpowers/skills/receiving-code-review",
            "standalone": true
          },
          {
            "id": "obra/superpowers/skills/finishing-a-development-branch",
            "standalone": true
          },
          {
            "id": "obra/superpowers/skills/systematic-debugging",
            "standalone": true
          },
          {
            "id": "obra/superpowers/skills/verification-before-completion",
            "standalone": true
          },
          {
            "id": "obra/superpowers/skills/dispatching-parallel-agents",
            "standalone": true
          },
          {
            "id": "obra/superpowers/skills/writing-skills",
            "standalone": true
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add https://github.com/obra/superpowers --skill '*'"
          },
          {
            "label": "Claude Code plugin",
            "command": "/plugin install superpowers@claude-plugins-official"
          }
        ]
      }
    },
    {
      "id": "juliusbrussee/caveman",
      "skew": 0,
      "agentReview": {
        "name": "Caveman",
        "description": "Terse agent replies, plus compressed commits, reviews and memory files, and lean work patterns.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want shorter agent replies and fewer tokens spent, beyond chat too"
            },
            {
              "label": "It does",
              "text": "makes the agent answer tersely, and adds terse commits, one-line reviews and compressed memory files"
            },
            {
              "label": "Keeps",
              "text": "code, commands, errors and numbers exact, and full sentences for warnings and irreversible actions"
            },
            {
              "label": "Also has",
              "text": "five short work patterns, such as investigate-first and lean-build, that keep code changes small"
            },
            {
              "label": "Needs",
              "text": "the Caveman plugin for caveman-stats and for cavecrew's subagents"
            }
          ],
          "text": "Its core is caveman, a mode that makes the agent lead with the answer in short plain sentences, with no greetings, hedging or recaps, until you say \"stop caveman\"; ultracave and megacave, two more skills in the repo, cut further. The other skills carry the idea beyond chat. caveman-commit writes Conventional Commits messages with a subject of 50 characters when possible, caveman-review writes one line per review finding, and caveman-compress rewrites a memory file such as CLAUDE.md in caveman style to save input tokens, backing up the original. cavecrew delegates searches, small edits and reviews to three subagents whose reports come back compressed, so the main context lasts longer. caveman-stats shows the session's recorded token usage, and caveman-help lists every mode and command. Five short skills are work patterns the agent picks up when a task fits: investigate-first diagnoses before editing, lean-build builds only what's asked, surgical-patch fixes at the narrowest layer, safe-refactor keeps behavior unchanged and migration keeps changes reversible. The repo also ships a CLI and a proxy that shrink what the agent reads; this bundle covers its skills.",
          "permalink": "https://github.com/juliusbrussee/caveman/tree/bad48a0e1df55e05e3f52249afa35ecc1909ee76"
        },
        "skills": [
          {
            "id": "juliusbrussee/caveman/skills/caveman",
            "standalone": true
          },
          {
            "id": "juliusbrussee/caveman/skills/caveman-commit",
            "standalone": true
          },
          {
            "id": "juliusbrussee/caveman/skills/caveman-review",
            "standalone": true
          },
          {
            "id": "juliusbrussee/caveman/skills/caveman-compress",
            "standalone": true
          },
          {
            "id": "juliusbrussee/caveman/skills/caveman-stats",
            "standalone": false,
            "note": "Prints the token report of hooks that only the Caveman plugin installs, in Claude Code."
          },
          {
            "id": "juliusbrussee/caveman/skills/caveman-help",
            "standalone": false,
            "note": "A reference card for the bundle's modes and skills, so it only helps once they're installed."
          },
          {
            "id": "juliusbrussee/caveman/skills/cavecrew",
            "standalone": false,
            "note": "Delegates to three subagents that come with the Caveman plugin, not with the skill."
          },
          {
            "id": "juliusbrussee/caveman/skills/investigate-first",
            "standalone": true
          },
          {
            "id": "juliusbrussee/caveman/skills/lean-build",
            "standalone": true
          },
          {
            "id": "juliusbrussee/caveman/skills/surgical-patch",
            "standalone": true
          },
          {
            "id": "juliusbrussee/caveman/skills/safe-refactor",
            "standalone": true
          },
          {
            "id": "juliusbrussee/caveman/skills/migration",
            "standalone": true
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add https://github.com/juliusbrussee/caveman --skill '*'"
          },
          {
            "label": "Claude Code plugin",
            "command": "claude plugin marketplace add JuliusBrussee/caveman && claude plugin install caveman@caveman"
          }
        ]
      }
    },
    {
      "id": "mattpocock/skills@writing",
      "skew": 0,
      "agentReview": {
        "name": "Writing workflow",
        "description": "Turns an interview into a file of raw notes, then the notes into an article.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want to write an essay or article from your own ideas, with the agent as interviewer and editor"
            },
            {
              "label": "It does",
              "text": "first interviews you into a file of raw notes, then turns the notes into an article with you"
            },
            {
              "label": "You get",
              "text": "a notes file and, in a separate file, an article built one section at a time"
            },
            {
              "label": "Then pick",
              "text": "writing-beats to choose each next section, or writing-shape to commit to an angle first"
            },
            {
              "label": "Runs",
              "text": "only when you call each skill"
            }
          ],
          "text": "Matt Pocock's writing skills split writing into exploring and committing. writing-fragments is the exploring step: the agent interviews you and saves every usable line, anecdote and idea to one Markdown file, with no outline. The committing step takes that file, or any pile of notes, and turns it into an article in a separate file, in one of two ways. writing-beats drafts two or three possible openings, then after each section offers the next possible ones, so you steer the piece one choice at a time. writing-shape has you pick an angle up front, then builds the article block by block, debating with you whether each should be prose, a list, a table or a quote. Both refuse to let a section lean on an idea the reader hasn't met yet. The skills sit in the repo's in-progress folder, so expect them to change.",
          "permalink": "https://github.com/mattpocock/skills/tree/5beb35b040e3de97e54fa9e386d7e42d15c295c2"
        },
        "skills": [
          {
            "id": "mattpocock/skills/skills/in-progress/writing-fragments",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/in-progress/writing-beats",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/in-progress/writing-shape",
            "standalone": true
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add https://github.com/mattpocock/skills --skill writing-fragments --skill writing-beats --skill writing-shape"
          }
        ]
      }
    },
    {
      "id": "mattpocock/skills@engineering",
      "skew": 144,
      "agentReview": {
        "name": "Engineering workflow",
        "description": "Grills an idea into a spec and tickets on your issue tracker, builds them test-first, reviews the result and tunes the agent's setup.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want the agent to agree with you on what to build before it codes, then build it in small tested steps"
            },
            {
              "label": "It does",
              "text": "interviews you about a change, writes a spec and tickets on your issue tracker, builds each ticket test-first, then reviews the diff"
            },
            {
              "label": "You get",
              "text": "a project glossary and decision records, a spec and ordered tickets, tested commits, a review against your standards and the spec, and ideas for next time"
            },
            {
              "label": "Needs",
              "text": "a code repo, and one run of the setup skill there to record your issue tracker: GitHub, GitLab, local Markdown files or another"
            },
            {
              "label": "Runs",
              "text": "each main step only when you type it; supporting skills, such as the test-first and review ones, the agent can also start by itself"
            },
            {
              "label": "Unlike",
              "text": "frameworks that own the whole process, each step is a small skill you call yourself and can edit"
            },
            {
              "label": "Also covers",
              "text": "triaging incoming issues, debugging hard bugs, planning work too big for one session, and finding refactors that simplify a codebase"
            },
            {
              "label": "Start with",
              "text": "ask-matt, a skill that maps the others and points you to the one that fits"
            }
          ],
          "text": "Matt Pocock, a TypeScript teacher, built these skills to keep coding agents aligned with what you want and their code small and tested. A one-time setup skill records which issue tracker the repo uses and what its triage labels are called. The flow then starts with an interview: the agent asks about the change in numbered rounds, each question with its recommended answer, until no decision is left open, and writes the project's terms to a glossary and hard-to-reverse choices to architecture decision records as you go. Questions that talk can't answer go to a throwaway prototype or a background research agent. Next, the conversation becomes a spec on the tracker, then tickets: thin slices that each work end to end and list the tickets that must land first. The build step takes one ticket at a time, test-first, and ends with a review that checks the diff against your coding standards and, separately, against the spec; another skill builds a whole spec at once with parallel subagents. Finally, a retrospective proposes new checks, coding standards or agent instructions so the next run goes better.",
          "permalink": "https://github.com/mattpocock/skills/tree/5beb35b040e3de97e54fa9e386d7e42d15c295c2"
        },
        "skills": [
          {
            "id": "mattpocock/skills/skills/engineering/setup-matt-pocock-skills",
            "standalone": false,
            "note": "Writes the tracker, label and domain-doc settings under docs/agents/ that the other skills read; on its own, nothing uses them."
          },
          {
            "id": "mattpocock/skills/skills/engineering/ask-matt",
            "standalone": false,
            "note": "A map of the other skills that reads each one's SKILL.md before recommending it, so it only helps once they're installed."
          },
          {
            "id": "mattpocock/skills/skills/engineering/grill-with-docs",
            "standalone": false,
            "note": "Its whole SKILL.md loads grilling and domain-modeling."
          },
          {
            "id": "mattpocock/skills/skills/productivity/grill-me",
            "standalone": false,
            "note": "Its whole SKILL.md loads grilling."
          },
          {
            "id": "mattpocock/skills/skills/productivity/grilling",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/engineering/domain-modeling",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/engineering/research",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/productivity/handoff",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/engineering/prototype",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/engineering/wayfinder",
            "standalone": false,
            "note": "Resolves its decision tickets by loading grilling, domain-modeling, research and prototype, on the tracker that setup-matt-pocock-skills configures (local Markdown files without it)."
          },
          {
            "id": "mattpocock/skills/skills/engineering/to-spec",
            "standalone": false,
            "note": "Publishes to the issue tracker, with the ready-for-agent label, that setup-matt-pocock-skills configures."
          },
          {
            "id": "mattpocock/skills/skills/engineering/to-tickets",
            "standalone": false,
            "note": "Publishes to the issue tracker, with the ready-for-agent label, that setup-matt-pocock-skills configures."
          },
          {
            "id": "mattpocock/skills/skills/engineering/triage",
            "standalone": false,
            "note": "Needs the tracker and label mapping from setup-matt-pocock-skills, and loads grilling and domain-modeling to flesh out a request."
          },
          {
            "id": "mattpocock/skills/skills/engineering/implement",
            "standalone": false,
            "note": "Builds through tdd and closes with code-review, loading both as steps."
          },
          {
            "id": "mattpocock/skills/skills/engineering/implement-spec",
            "standalone": false,
            "note": "Works a spec and its tickets from to-spec and to-tickets on the configured tracker, has each subagent load tdd, and ends with code-review."
          },
          {
            "id": "mattpocock/skills/skills/engineering/tdd",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/engineering/codebase-design",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/engineering/code-review",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/engineering/diagnosing-bugs",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/engineering/retro",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/productivity/writing-for-agents",
            "standalone": true
          },
          {
            "id": "mattpocock/skills/skills/engineering/improve-codebase-architecture",
            "standalone": false,
            "note": "Loads codebase-design for its vocabulary, then grilling and domain-modeling to work through the refactor you pick."
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add https://github.com/mattpocock/skills --skill setup-matt-pocock-skills --skill ask-matt --skill grill-with-docs --skill grill-me --skill grilling --skill domain-modeling --skill research --skill handoff --skill prototype --skill wayfinder --skill to-spec --skill to-tickets --skill triage --skill implement --skill implement-spec --skill tdd --skill codebase-design --skill code-review --skill diagnosing-bugs --skill retro --skill writing-for-agents --skill improve-codebase-architecture"
          },
          {
            "label": "Claude Code plugin, with 5 more of the repo's skills",
            "command": "claude plugin install mattpocock-skills@claude-plugins-official"
          },
          {
            "label": "Codex plugin, with 5 more of the repo's skills",
            "command": "codex plugin marketplace add mattpocock/skills && codex plugin add mattpocock-skills@mattpocock"
          },
          {
            "label": "GitHub Copilot CLI plugin, with 5 more of the repo's skills",
            "command": "copilot plugin marketplace add mattpocock/skills && copilot plugin install mattpocock-skills@mattpocock"
          },
          {
            "label": "Gemini CLI, with 5 more of the repo's skills",
            "command": "gemini skills install https://github.com/mattpocock/skills.git --path skills/engineering && gemini skills install https://github.com/mattpocock/skills.git --path skills/productivity"
          }
        ]
      }
