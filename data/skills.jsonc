        "skew": 0
      },
      "agentReview": {
        "description": "Explains the current topic visually with pseudocode, call trees, file trees, Mermaid diagrams, diffs or a focused HTML page.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a discussion about code is hard to follow in prose and you want to see its shape"
            },
            {
              "label": "It does",
              "text": "picks the smallest visual that makes the point: pseudocode, a call tree, a component or file tree, a Mermaid diagram or a diff"
            },
            {
              "label": "You get",
              "text": "brief text with each visual beside it; for dense UI or concepts, one HTML diagram, infographic or short slide deck it opens for you"
            },
            {
              "label": "Runs",
              "text": "only when you call it with /show-me"
            }
          ],
          "text": "From HumanLayer's skills. It answers the topic you're already discussing in pictures rather than paragraphs, with no preamble. Logic becomes pseudocode, runtime flow a call tree, UI a component tree with the state and module boundaries that matter, file responsibilities a shallow file tree, and interactions between parts a Mermaid diagram. When the point is what changes, it shows a diff in the matching shape: components, files, calls or state. A whole block of code appears only when most of it is new or you need a shape to copy. For a visual UI, a layout or a concept too dense for Mermaid, it writes one HTML file that matches your product's colors, type, spacing and components, uses real labels and data, works on desktop and mobile, and opens it with the open command. It keeps only the calls, files and states your question needs, and usually uses one or a few of these, rarely all.",
          "permalink": "https://github.com/humanlayer/skills/tree/4d69d20f6e9b57b4fcf0d501ccfb1be961f0f329/plugins/show-me/skills/show-me"
        },
        "tags": [
          "category:output-style",
          "type:command",
          "effect:local",
          "needs:none",
          "by:community",
          "diagrams",
          "output-style"
        ]
      }
    },
