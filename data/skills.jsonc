      "agentReview": {
        "description": "Reviews UI code against Vercel's Web Interface Guidelines and accessibility rules.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want UI code reviewed for accessibility, UX and front-end best practices"
            },
            {
              "label": "It does",
              "text": "fetches Vercel's latest Web Interface Guidelines, then checks the files you name against every rule"
            },
            {
              "label": "You get",
              "text": "terse findings grouped by file, each at a clickable file:line"
            },
            {
              "label": "Unlike writing-guidelines",
              "text": "which runs the same kind of review on docs and prose"
            },
            {
              "label": "Needs",
              "text": "web access, since the rules are fetched fresh before each review"
            }
          ],
          "text": "Like writing-guidelines, it's a short wrapper around rules kept elsewhere: the agent fetches them from Vercel's web-interface-guidelines repo before each review, so they can change between runs. You name a file or pattern, or it asks. In October 2026 the rules covered accessibility, focus states, forms, animation, typography, images, performance, navigation, touch, dark mode, localization and copy, written as checks on HTML, CSS and React code. Examples: icon-only buttons need an aria-label, a div with a click handler should be a button, never remove the focus outline without a replacement, never block paste, honor reduced-motion settings, give images a width and height, virtualize lists over 50 items, keep filters and tabs in the URL, and confirm destructive actions. Each finding is one line, the issue and its location, and clean files are marked as passing.",
          "permalink": "https://github.com/vercel-labs/agent-skills/tree/063bee94c3f4df8453406c830b0a7df0f2860278/skills/web-design-guidelines"
        },
