    {
      "id": "software-mansion/argent/packages/skills/skills/argent-screen-recording",
      "name": "argent-screen-recording",
      "skills.sh": {
        "url": "https://skills.sh/software-mansion/argent/argent-screen-recording",
        "installs": 20700,
        "weeklyInstalls": [1512, 1371, 1512, 1521, 1580, 1636, 1684, 1608],
        "firstSeen": "2026-07-23"
      },
      "skillMd": {
        "version": "b965c94827d6167fd2912a7ca5ad5505040ae4e0",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Records a video of an app on an iOS simulator or Android screen through Argent while the agent drives the flow.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a video of a flow, interaction or animation in your app on an iOS simulator, Android emulator or Android phone"
            },
            {
              "label": "It does",
              "text": "starts recording with a time cap, sets itself a reminder to stop, drives the interaction, then stops and checks the file"
            },
            {
              "label": "You get",
              "text": "a video file in your project's .argent/recordings/, or ~/.argent/recordings/ outside one, plus a reminder to .gitignore or delete it if it shouldn't be committed"
            },
            {
              "label": "Watermark",
              "text": "a faint Argent logo in a corner, until you run argent disable video-watermark"
            },
            {
              "label": "Not supported",
              "text": "physical iPhones, tvOS simulators, Chromium apps, Fire TV and HarmonyOS"
            },
            {
              "label": "Needs",
              "text": "the Argent MCP server"
            }
          ],
          "text": "Part of Software Mansion's Argent toolkit, which lets the agent control simulators, emulators and devices. Its first rule is never to leave a recording running: a forgotten one keeps capturing until its time cap and holds the session. So as soon as recording starts, the agent sets a reminder for the expected end, with a scheduling tool or a background sleep, and reads the note every Argent result carries while a recording runs. The steps: get the app to the opening state, start recording with a cap slightly above the expected length, drive the interaction, batching tight steps so tool latency doesn't pad the video, then stop, check any warning and confirm the file has a sane size. The agent tells you where the file landed, a folder you can change with argent config, and that it's untracked, so you can add it to .gitignore or delete it if it shouldn't be committed. Limits: one recording per device at a time, the video keeps the screen size it started with, landscape on remote simulators plays sideways, and secure Android screens come out black.",
          "permalink": "https://github.com/software-mansion/argent/tree/b965c94827d6167fd2912a7ca5ad5505040ae4e0/packages/skills/skills/argent-screen-recording"
        },
        "tags": [
          "category:debugging",
          "category:media",
          "type:workflow",
          "effect:local",
          "needs:mcp",
          "by:official",
          "stack:argent",
          "video",
          "mobile"
        ]
      }
