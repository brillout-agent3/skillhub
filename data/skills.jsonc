    {
      "id": "emilkowalski/skills/skills/animation-vocabulary",
      "name": "animation-vocabulary",
      "skills.sh": {
        "url": "https://skills.sh/emilkowalski/skills/animation-vocabulary",
        "installs": 266895,
        "weeklyInstalls": [11830, 13412, 14446, 15864, 17494, 16696, 18489, 16866],
        "firstSeen": "2026-06-29"
      },
      "skillMd": {
        "version": "2d228630ba1446365f614a108cb8252f1feda202",
        "updated": "2026-10-20",
        "skew": 0
      },
      "agentReview": {
        "description": "Turns \"the bouncy thing when a popover opens\" into its exact term.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you can picture a motion effect but don't know its name, and want the right word to ask a designer or an AI for it"
            },
            {
              "label": "It does",
              "text": "matches your loose description to the skill's own glossary of about 90 animation terms"
            },
            {
              "label": "You get",
              "text": "the term with its one-line definition, plus one or two close alternatives and how they differ"
            },
            {
              "label": "Unlike emil-design-eng",
              "text": "that skill gives rules for building animations; this one only names effects"
            }
          ],
          "text": "A reverse dictionary for motion. You describe what you see or feel, and it returns the precise term. \"The popover seems to grow out of the button\" is an origin-aware animation; \"the iOS scroll that resists and snaps back\" is rubber-banding. Its glossary, written into the skill, sorts about 90 terms into 12 groups, among them entrances and exits, transitions between states, scroll, feedback, easing, springs, looping motion and performance. The agent reads for the sensation rather than keywords, quotes the glossary's definitions as written, and contrasts close pairs, such as a crossfade (one element fades out as another fades in) and a morph (one shape turns into another). When nothing fits exactly, it gives the closest term and says it's an approximation instead of inventing one. Answers stay short: the name first, more only if you ask.",
          "permalink": "https://github.com/emilkowalski/skills/tree/2d228630ba1446365f614a108cb8252f1feda202/skills/animation-vocabulary"
        },
        "tags": [
          "category:design",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "animation",
          "learning"
        ]
      }
    },
    {
      "id": "emilkowalski/skills/skills/apple-design",
      "name": "apple-design",
      "skills.sh": {
        "url": "https://skills.sh/emilkowalski/skills/apple-design",
        "installs": 277331,
        "weeklyInstalls": [13069, 14691, 15936, 16618, 18712, 19555, 21421, 19778],
        "firstSeen": "2026-07-09"
      },
      "skillMd": {
        "version": "2d228630ba1446365f614a108cb8252f1feda202",
        "updated": "2026-10-20",
        "skew": 0
      },
      "agentReview": {
        "description": "Brings Apple's interface and physical-motion approach to the web.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you're building drags, swipes, sheets or spring animations on the web that should feel as fluid as iOS"
            },
            {
              "label": "It does",
              "text": "applies Apple's WWDC developer-conference talks, mainly on fluid interfaces, translated to CSS, Pointer Events and spring animation libraries"
            },
            {
              "label": "You get",
              "text": "gesture and animation code built on Apple's own numbers: spring settings, where a flick lands, how edges resist"
            },
            {
              "label": "Unlike emil-design-eng",
              "text": "that skill covers general UI animation; this one centers on touch gestures and physics, plus glassy surfaces, typography and Apple's design principles"
            }
          ],
          "text": "Its core idea: an interface feels alive when motion starts from where an element is on screen, keeps the finger's speed, carries momentum forward and can be grabbed and reversed at any moment. So the agent gives feedback on press rather than release, keeps dragged elements glued to the pointer from where they were grabbed, never blocks input during a transition, and uses springs instead of fixed-duration animations for anything you can touch. When you let go of a flicked element, it works out where the element would naturally stop and snaps to the nearest resting point from there, and at edges it resists softly instead of stopping dead. Beyond motion it covers frosted-glass toolbars and sheets, syncing sound and vibration with visuals, accessibility settings for motion, transparency and contrast, letter-spacing that changes with text size, and Apple's eight design principles, such as purpose, familiarity, simplicity and craft.",
          "permalink": "https://github.com/emilkowalski/skills/tree/2d228630ba1446365f614a108cb8252f1feda202/skills/apple-design"
        },
        "tags": [
          "category:design",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "design",
          "animation"
        ]
      }
    },
