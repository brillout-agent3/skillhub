      },
      "skillMd": {
        "version": "b965c94827d6167fd2912a7ca5ad5505040ae4e0",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Profiles native CPU hotspots, UI hangs and memory issues in iOS and Android apps through Argent, with Instruments or Perfetto.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "an iOS or Android app hangs, burns CPU or seems to leak memory in native code"
            },
            {
              "label": "It does",
              "text": "records a native profile while the app is used, analyzes it, then drills into hang stacks, per-thread CPU and leak stacks"
            },
            {
              "label": "You get",
              "text": "findings marked red (act on it) or yellow (worth investigating), then fixes and a re-profile if you want them"
            },
            {
              "label": "Needs",
              "text": "the Argent MCP server; on iOS, full Xcode and a simulator; on Android, an app that is debuggable or profileable"
            },
            {
              "label": "Unlike argent-react-native-profiler",
              "text": "it covers native code only; that skill starts this profiler alongside React profiling by default"
            }
          ],
          "text": "Part of Software Mansion's Argent toolkit, which lets the agent control simulators, emulators and devices. On iOS it records with Instruments through xctrace, on simulators only, and reports CPU hotspots, UI hangs and memory leaks. On Android it uses Perfetto on an emulator or phone and reports CPU hotspots and UI hangs, with jank reasons and the main-thread function that blocked, plus memory growth to treat as a hint rather than a confirmed leak. The steps run in order: start the profiler with the app running, let you or the agent use the app, stop, analyze, then present findings and ask whether to dig deeper, fix or stop. Drill-downs follow set patterns: a hang goes from its native call chain to the callers of the suspect function and its source, a CPU hotspot from the per-thread split to the dominant function. After a fix it re-profiles the same scenario and compares sessions, saying plainly when nothing improved. It warns that simulator timings reflect your computer, not the phone, and counts only consistent changes across two or more runs, or over 15%, as real.",
          "permalink": "https://github.com/software-mansion/argent/tree/b965c94827d6167fd2912a7ca5ad5505040ae4e0/packages/skills/skills/argent-native-profiler"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:local",
          "needs:mcp",
          "needs:cli",
          "by:official",
          "stack:argent",
          "performance",
          "mobile"
        ]
      }
    },
    {
      "id": "wshobson/agents/plugins/brand-landingpage/skills/brand-landingpage",
