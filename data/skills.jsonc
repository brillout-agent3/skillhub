    {
      "id": "coreyhaines31/marketingskills/skills/cold-email",
      "name": "cold-email",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/cold-email",
        "installs": 134599,
        "weeklyInstalls": [3161, 2837, 2893, 3575, 3947, 3406, 3538, 4191],
        "firstSeen": "2026-02-18"
      },
      "skillMd": {
        "version": "96798cf38736ecdba015a1d2b0521b0c8f8f41dd",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Writes B2B cold emails and follow-ups that sound human, and covers sending setup, LinkedIn steps, multichannel cadences and reply handling.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you're writing B2B cold outbound emails or a follow-up sequence, or nobody is replying"
            },
            {
              "label": "It does",
              "text": "writes short, peer-to-peer emails built on a real observation about the prospect, with one low-friction ask"
            },
            {
              "label": "You get",
              "text": "email drafts with 2-4 word lowercase subject lines, plus follow-ups that each add a new angle"
            },
            {
              "label": "Before sending",
              "text": "send from secondary domains with SPF, DKIM and DMARC, verify lists, and turn off open and click tracking"
            },
            {
              "label": "Unlike the emails skill",
              "text": "that one, from the same repo, covers lifecycle and nurture email; this one is for cold outreach"
            }
          ],
          "text": "B2B cold outbound written to read like it came from a sharp colleague rather than a sales template. It reads your product marketing context if you have it (a shared file on your product, audience and positioning that the repo's product-marketing skill writes), then asks who you're writing to, what you want, the value, your proof and any research signals such as funding or hiring, but writes with whatever you give it. Personalization has to connect to the problem: if removing the opening line leaves the email intact, it isn't working. It picks a shape such as observation, problem, proof, ask, keeps one interest-based question as the call to action, and checks the draft against a list of AI tells (contrast reveals, self-answered questions, em dashes, stock phrases). Follow-ups run 3 to 5 emails with growing gaps, each standing alone. Replies are sorted by type, and positive ones get a fast answer with two proposed times and a booking link. References cover deliverability rules for Google, Yahoo and Microsoft, LinkedIn outreach, outbound plays, and multichannel cadences in which a reply on any channel stops them all. The prospect list comes from the repo's prospecting skill.",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/cold-email"
        },
