      "id": "anthropics/skills/skills/mcp-builder",
      "name": "mcp-builder",
      "skills.sh": {
        "url": "https://skills.sh/anthropics/skills/mcp-builder",
        "installs": 137974,
        "weeklyInstalls": [2337, 2627, 2485, 3298, 3265, 3067, 3712, 3697],
