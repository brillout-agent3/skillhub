      },
      "skillMd": {
        "version": "d2a986240f9d786ae54fc33fcfd9ad37308e9cc3",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits a website's on-page and technical SEO with Firecrawl and returns source-backed findings with prioritized fixes.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a site's titles, descriptions, headings, canonicals, structured data and internal links checked, or pages compared for target keywords"
            },
            {
              "label": "It does",
              "text": "starts from your pages or maps the site, picks pages covering each template, scrapes fresh raw HTML and links, and judges findings against each page's purpose"
            },
            {
              "label": "You get",
              "text": "a concise audit, top fixes first: affected URLs, evidence, likely impact, the fix and how to verify it, with confirmed defects kept apart from opportunities"
            },
            {
              "label": "Needs",
              "text": "the Firecrawl CLI and a Firecrawl API key; ranking, keyword and backlink figures need a signed-in CLI and a fitting data provider"
            },
            {
              "label": "Won't",
              "text": "invent an overall score, forecast traffic gains or edit the website"
            }
          ],
          "text": "It works from the pages you give, or lists a site's URLs with Firecrawl to pick pages covering each page template, and records what it inspected, since a sample isn't the whole site. Each page is scraped fresh as Markdown, raw HTML and links, so metadata is checked in the actual head markup; checks that need source it couldn't get are marked unverified. It reviews titles, descriptions, headings, relevance, image alt text, internal links, canonicals, robots directives and structured data, reading robots.txt or sitemaps when needed, and keeps apart things that are easy to confuse: crawl blocks versus indexing directives, declared versus search-engine-chosen canonicals, a scrape error versus a broken link. Keyword comparisons use a live search, with the query and date recorded. For ranking, keyword or backlink numbers it looks for a data provider in Alexandria, Firecrawl's catalog of data tools; without one it says what stays unmeasured rather than guessing traffic, indexing or Core Web Vitals. It never accepts a provider's terms without your approval. Shared template issues are grouped, and fixes are ranked by impact, confidence and effort.",
          "permalink": "https://github.com/firecrawl/firecrawl-workflows/tree/d2a986240f9d786ae54fc33fcfd9ad37308e9cc3/skills/firecrawl-seo-audit"
        },
