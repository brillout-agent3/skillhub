        "skew": 0
      },
      "agentReview": {
        "description": "Typesets resumes, one-pagers, letters, long reports, slides and social cards from its own serif templates, then renders and checks the PDF.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a document that looks typeset: a resume, one-pager, letter, white paper, portfolio, equity report, changelog, slide deck or social cards"
            },
            {
              "label": "It does",
              "text": "distills your content into the template that fits, fills it, then runs its build script until the PDF passes its checks"
            },
            {
              "label": "You get",
              "text": "the HTML source and a PDF, plus PNG or an editable PPTX when called for; a landing page comes as one static HTML file"
            },
            {
              "label": "Look",
              "text": "serif type, a warm background and one ink-blue accent; not for dark, multi-color or Material-style designs"
            },
            {
              "label": "Never guesses",
              "text": "missing facts, logos or figures are marked [DATA NEEDED] in the page and listed for you"
            },
            {
              "label": "Languages",
              "text": "templates in Chinese, English and Korean; Japanese and other languages are best-effort"
            },
            {
              "label": "Needs",
              "text": "Python for its build script, which renders PDFs with WeasyPrint; Node.js only for math formulas"
            }
          ],
          "text": "Kami first locks a short contract and states it in one line without waiting: language, template, output formats, length, what counts as visually done and how to verify it. It asks at most one question, only when purpose, audience or constraints are truly unclear, and picks the template from cues such as one page for investors or two pages of career story. Text edits and complaints about how a page looks are handled as separate modes that keep what already works. For a new document it writes your distilled content and the brief to content.json, checked against a schema for that document type, so every fact, number and name you gave lands on the page or in a gap report. It copies the template rather than writing HTML from scratch, and generates charts from your numbers with its script. One command checks the HTML, renders the PDF, checks page count, fonts, placeholders and orphans, and exports page images the agent inspects, fixing the three worst defects per round for up to three rounds. An optional brand profile in ~/.config/kami/brand.md fills in your defaults. Each task starts with a check, at most daily, for a newer release on GitHub.",
          "permalink": "https://github.com/tw93/kami/tree/588a727e1f11fd911efa166af2aa59416a002268/skills/kami"
        },
        "tags": [
          "category:documents",
          "category:design",
          "type:workflow",
          "effect:local",
          "needs:cli",
          "by:community",
          "documents",
          "pdf",
          "slides",
          "design"
        ]
      }
    },
    {
      "id": "openai/skills/skills/.curated/pdf",
      "name": "pdf",
      "skills.sh": {
        "url": "https://skills.sh/openai/skills/pdf",
        "installs": 13700,
        "weeklyInstalls": [255, 221, 200, 272, 165, 147, 147, 161],
        "firstSeen": "2026-01-28"
