      "agentReview": {
        "description": "Plans template-driven SEO pages at scale.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want many similar pages for search, such as \"[service] in [city]\", \"X vs Y\" or integration pages"
            },
            {
              "label": "It does",
              "text": "picks the page type that fits your data, checks there's search demand, and designs a template that gives every page unique value"
