    {
      "id": "jakubkrehel/skills/skills/better-ui",
      "name": "better-ui",
      "skills.sh": {
        "url": "https://skills.sh/jakubkrehel/skills/better-ui",
        "installs": 44500,
        "weeklyInstalls": [2447, 4851, 3106, 3571, 3236, 2260, 2556, 3276],
        "firstSeen": "2026-07-10"
      },
      "skillMd": {
        "version": "60bf140e43c98b248e6594487384ec967e89d98a",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Polishes surfaces, icons and motion in UI code with exact values for corner radius, shadows, press scale and animation timing.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "your UI works but its surfaces, icons or motion feel slightly off"
            },
            {
              "label": "It does",
              "text": "applies exact values, such as an outer radius equal to the inner radius plus padding, buttons pressing to 0.96 over 150ms, and 100ms staggers"
            },
            {
              "label": "You get",
              "text": "polished UI code, or a review: findings by severity with file, before and after, ending in Block or Approve"
            },
            {
              "label": "Unlike make-interfaces-feel-better",
              "text": "the same author's all-in-one checklist, it leaves typography, hit areas, layout and color to the other better-* skills"
            }
          ],
          "text": "The visual-polish part of Jakub Krehel's better-* interface skills. Its values are exact, not ranges: nested surfaces with an even inset get an outer radius equal to the inner radius plus the padding; borders that only fake depth become layered transparent shadows, keeping a transparent border so forced-colors mode still draws an edge; content images get a 1px pure black or white outline at 10% opacity; a pressed button scales to 0.96 over 150ms, and a disabled one never does. State changes use transitions rather than keyframes so they can reverse mid-flight, keystrokes and row hovers respond instantly, staged entrances stagger by 100ms, exits are shorter than entrances, and movement runs only when the reduced-motion setting allows, with an opacity cross-fade otherwise. It also matches icon stroke to text weight, recolors one currentColor SVG per state, keeps hover styles to hover-capable pointers and stops overlays from scrolling the page behind. The project's own library, tokens and conventions win wherever no rule sets a value. A review checks every state, replays motion at 10% speed when a browser is available, marks what it couldn't check as Not verified, and blocks while any high-severity finding remains.",
          "permalink": "https://github.com/jakubkrehel/skills/tree/60bf140e43c98b248e6594487384ec967e89d98a/skills/better-ui"
        },
        "tags": [
          "category:design",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "design",
          "animation"
        ]
      }
    },
    {
      "id": "jakubkrehel/skills/skills/better-typography",
      "name": "better-typography",
      "skills.sh": {
        "url": "https://skills.sh/jakubkrehel/skills/better-typography",
        "installs": 39100,
        "weeklyInstalls": [2416, 2718, 2475, 3146, 2735, 1763, 2045, 2950],
        "firstSeen": "2026-07-10"
      },
      "skillMd": {
        "version": "60bf140e43c98b248e6594487384ec967e89d98a",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Sets and reviews how text renders in UI code: type scale, line-height, letter-spacing, wrapping, truncation, font loading and punctuation.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you're setting up or reviewing the type in an interface: sizes, spacing, wrapping and fonts"
            },
            {
              "label": "It does",
              "text": "applies measured rules, such as unitless line-height, weight 400 or heavier below 18px, a 60–75 character line and 16px inputs on iOS"
            },
            {
              "label": "You get",
              "text": "fixes in your project's styling system, with Tailwind equivalents, or a review ending in Block or Approve"
            },
            {
              "label": "Won't",
              "text": "propose a new typeface, paid or free, unless the task asks for a type change"
            }
          ],
          "text": "The typography part of Jakub Krehel's better-* interface skills. It separates measured rules from heuristics: unitless line-height, weights of 400 or more under 18px, a 60–75 character line length, 16px inputs so iOS Safari doesn't zoom the page, and tabular numbers on timers, prices and counters are findings when missed, while letter-spacing, font pairing and scale ratios are reported only where they break the project's own scale. It sets line-height by role (1.1 for display, 1.2–1.3 for headings, 1.5–1.6 for body), tracking by size in em, a small type scale named by use on teams, and headings that shrink with their level. It prefers CSS properties over raw OpenType tags, loads every face the design uses instead of letting the browser synthesize weights or styles, balances headings and keeps lone words off the last line of paragraphs, and swaps keyboard stand-ins for curly quotes, dashes and the ellipsis character. A cheat sheet maps each declaration to its Tailwind utility. With a browser, a review compares computed values and resizes the viewport with real content; anything it couldn't check is marked Not verified.",
          "permalink": "https://github.com/jakubkrehel/skills/tree/60bf140e43c98b248e6594487384ec967e89d98a/skills/better-typography"
        },
        "tags": [
          "category:design",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "design"
        ]
      }
    },
    {
      "id": "jakubkrehel/skills/skills/better-colors",
      "name": "better-colors",
      "skills.sh": {
        "url": "https://skills.sh/jakubkrehel/skills/better-colors",
        "installs": 37200,
        "weeklyInstalls": [2211, 2429, 2297, 3061, 2722, 1748, 2021, 2922],
        "firstSeen": "2026-07-10"
      },
      "skillMd": {
        "version": "60bf140e43c98b248e6594487384ec967e89d98a",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Builds and audits color systems: generates ramps with a color library, maps steps to semantic tokens, converts notation and measures contrast.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you're building a palette and color tokens, or checking existing ones for broken roles and failing contrast"
            },
            {
              "label": "It does",
              "text": "builds one-hue ramps with a color library, gives every step a role, and names tokens in two tiers: by hue, then by job"
            },
            {
              "label": "You get",
              "text": "tokens in your project's notation, OKLCH for a new system, and a measured contrast value for each rendered pair"
            },
            {
              "label": "Won't",
              "text": "change a failing color unless asked: it reports the pair, its measured value and the threshold it misses"
            }
          ],
          "text": "The color part of Jakub Krehel's better-* interface skills. A color system here is ramps, not colors: one neutral, one accent and only the status ramps the product actually renders, each holding one hue, built with a color library rather than by eye, and with no step that no role uses. Primitive tokens name a value, like --blue-600, and are never used in components; semantic tokens name a job, like --color-text-secondary, and are the only ones components reference, so a theme can repoint colors without touching them. A token is never borrowed for another role because its value happens to match. Hues within 15° in OKLCH count as the same color, so each color keeps one meaning, and color never carries meaning alone. Where filled color marks the primary action, only one action per view gets it. Contrast is measured against the background the text actually renders on, never estimated. A checklist catches common slips, such as white text on a Tailwind 500 fill, a dark theme made by reversing the light ramp, and vivid OKLCH colors with no sRGB fallback.",
          "permalink": "https://github.com/jakubkrehel/skills/tree/60bf140e43c98b248e6594487384ec967e89d98a/skills/better-colors"
        },
        "tags": [
          "category:design",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "design",
          "design-system",
          "accessibility"
        ]
      }
    },
    {
      "id": "jakubkrehel/skills/skills/better-layout",
      "name": "better-layout",
      "skills.sh": {
        "url": "https://skills.sh/jakubkrehel/skills/better-layout",
        "installs": 35300,
        "weeklyInstalls": [2240, 2550, 2327, 3042, 2675, 1687, 2001, 2864],
        "firstSeen": "2026-07-24"
      },
      "skillMd": {
        "version": "60bf140e43c98b248e6594487384ec967e89d98a",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Sets grouping, alignment, reading order and responsive structure in UI code, then checks it survives resizing, translation and right-to-left mirroring.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a layout has to hold up at narrow widths, at 200% zoom, in longer languages or mirrored for right-to-left"
            },
            {
              "label": "It does",
              "text": "groups with space before lines, aligns to shared edges, keeps visual order equal to source order and writes direction-dependent CSS as start and end"
            },
            {
              "label": "You get",
              "text": "fixes in your project's own spacing tokens, or a review whose findings each show a clip, overlap, broken mirror or misread group"
            },
            {
              "label": "Starting values",
              "text": "8px within a group and 16px or more between groups, used only when the project has no spacing scale"
            }
          ],
          "text": "The layout part of Jakub Krehel's better-* interface skills. It sets structure, then stress-tests it by resizing, translating and mirroring. Groups are made with space first, background shapes second and separator lines last, with gaps between groups at least twice those within. Controls get a shape, border, underline or fixed zone so they never read as static text, and each view gets one primary action, with secondary actions moved into a menu past three. Direction-dependent layout uses logical properties such as margin-inline-start, so it mirrors for right-to-left languages, and content is never reordered away from its source order. Hidden or scrolled-off content gets a visible cue, and breakpoints come from the content, with container queries for components. Text containers use max-width and min-height rather than fixed sizes, since translated strings, short labels most of all, grow; it suggests testing with pseudo-localization and German. A checklist catches traps such as 100vw causing a horizontal scroll, 100vh hidden under mobile toolbars, and safe-area insets that stay zero without viewport-fit=cover. A value that merely differs from its starting points is not a finding.",
          "permalink": "https://github.com/jakubkrehel/skills/tree/60bf140e43c98b248e6594487384ec967e89d98a/skills/better-layout"
        },
        "tags": [
