      "agentReview": {
        "description": "Creates posters and visual art as PNG or PDF from a design philosophy.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a poster, art print or other single static image designed from scratch"
            },
            {
              "label": "It does",
              "text": "writes a design philosophy, a short manifesto for an invented art movement, then draws an image in that style with code"
