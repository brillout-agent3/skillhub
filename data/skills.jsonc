    {
      "id": "coreyhaines31/marketingskills/skills/marketing-plan",
      "name": "marketing-plan",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/marketing-plan",
        "installs": 74444,
        "weeklyInstalls": [2817, 2636, 2666, 3090, 3393, 3270, 3499, 3952],
        "firstSeen": "2026-05-29"
      },
      "skillMd": {
        "version": "96798cf38736ecdba015a1d2b0521b0c8f8f41dd",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Builds a 12-month marketing plan structured by funnel stage and fitted to a company's budget, team and funding, reviewed with you section by section.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you're a fractional CMO or consultant starting with a client, or a founder who needs a 12-month marketing roadmap for the team or investors"
            },
            {
              "label": "It does",
              "text": "researches the company and interviews you, then drafts 13 sections one at a time for you to approve, adjust or expand"
            },
            {
              "label": "You get",
              "text": "one Markdown file of roughly 8,000 to 12,000 words, ready to paste into Notion, with a 90-day roadmap that names owners"
            },
            {
              "label": "Keeps",
              "text": "research, progress and each approved section in ~/marketing-plans/, so you can stop and resume where you left off"
            },
            {
              "label": "Unlike marketing-ideas",
              "text": "from the same repo, which suggests standalone tactics, it commits to a sequenced plan and cross-references all 139 of those ideas"
            }
          ],
          "text": "A fractional CMO's strategy document, organized by AARRR, the funnel stages acquisition, activation, retention, referral and revenue, so every move names the stage it serves. You call it with a client name or domain. First it reads the materials you provide, pulls data from connected tools such as analytics or Stripe, and interviews you on funding, team, budget, channels, what's done and what's stuck, scoring the current state against its own 17-part rubric. In the second it presents each of 13 sections for approval: executive summary, strategic frame, current state, one per funnel stage, a 90-day roadmap, a 12-month outlook tied to funding milestones, the marketing skills and integrations that would carry out each move, an idea bank, and measurement with open decisions. The third phase compiles and checks the final file, and can offer to publish it to a GitHub repo. Throughout, it treats marketing as a portfolio of compounding assets, checks how big and frequent the problem is, sizes the market (total, serviceable and obtainable) when that's in doubt, sets budgets from revenue or from goals, and lists unknowns such as acquisition cost as open decisions rather than guessing. A finished plan is never overwritten without asking.",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/marketing-plan"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "marketing",
          "research"
        ],
        "note": "Saves research, progress and the finished plan under ~/marketing-plans/ in your home folder."
      }
    },
    {
      "id": "coreyhaines31/marketingskills/skills/prospecting",
      "name": "prospecting",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/prospecting",
        "installs": 71707,
        "weeklyInstalls": [2634, 2435, 2280, 2639, 3052, 3109, 3268, 3937],
        "firstSeen": "2026-05-26"
      },
      "skillMd": {
        "version": "96798cf38736ecdba015a1d2b0521b0c8f8f41dd",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Builds verified, scored prospect lists for B2B, SaaS or local-business outreach, or finds first customers from public signs of demand.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you need a list of companies or local businesses to contact, or your first customers and design partners"
            },
            {
              "label": "It does",
              "text": "turns your ideal customer into pass/fail criteria, sources two to three times more candidates than needed, and qualifies each with sources and a confidence level"
            },
            {
              "label": "You get",
              "text": "a lead sheet scored hot, warm, cold or skip, as a chat table or a CSV above 25 rows, with the top 3 to 5 targets explained"
            },
            {
              "label": "Won't",
              "text": "bulk-scrape LinkedIn or Google Maps, get past logins or CAPTCHAs, or use leaked data or sensitive traits"
            },
            {
              "label": "Works with",
              "text": "Apollo, Clay, ZoomInfo, Hunter and similar if you have them; otherwise public sources and browser research"
            },
            {
              "label": "Unlike cold-email",
              "text": "from the same repo, which handles the outreach itself (copy, sending setup, cadences and replies), it builds the list you reach out to"
            }
          ],
          "text": "Prospect research in four branches: SaaS companies, other B2B businesses, local small businesses such as gyms or clinics, and an early-stage branch that looks for public evidence of the pain you solve in forums, reviews, GitHub issues and job posts. Every branch runs the same five phases. It defines the ideal customer profile as a paragraph plus pass/fail checks, including a \"why now\" buying signal; builds a candidate list from two or three sources; qualifies each candidate with evidence, rating confidence high only with two independent sources or the official business page; scores and tiers accounts, with a researched brief before any outreach to the top tier; and outputs the lead sheet, or an evidence report for the early-stage branch. Emails are verified before they go on the list and again before sending if the list has sat. Compliance rules apply on every run: no bulk scraping, public business contacts only, a source URL and date kept for every contact for GDPR and CAN-SPAM, and no reselling extracted data. It reads your product marketing context if you have it (a shared file on your product, audience and positioning that the repo's product-marketing skill writes).",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/prospecting"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "research",
          "marketing"
        ]
      }
    },
