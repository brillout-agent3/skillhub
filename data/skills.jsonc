    {
      "id": "cathrynlavery/diagram-design/skills/diagram-design",
      "name": "diagram-design",
      "skills.sh": {
        "url": "https://skills.sh/cathrynlavery/diagram-design/diagram-design",
        "installs": 25600,
        "weeklyInstalls": [1028, 813, 665, 626, 2226, 5193, 4258, 4019],
        "firstSeen": "2026-04-19"
      },
      "skillMd": {
        "version": "e57eda6102a19444538ebd611d39534fad65b663",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Draws diagrams and charts of 45 types as self-contained HTML and SVG in your brand, and redraws draw.io, Mermaid and Excalidraw files.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you need an architecture diagram, flowchart, sequence, timeline, quadrant, chart or another of 45 types that looks designed, not generated"
            },
            {
              "label": "It does",
              "text": "picks the type, states its plan, draws in a strict editorial style, then runs a pre-output checklist and a bundled self-check script"
            },
            {
              "label": "You get",
              "text": "one .html file with inline SVG, from light, dark or full editorial templates, plus PNG or SVG export when you ask"
            },
            {
              "label": "First run",
              "text": "asks to match your brand from a website, a design system, pasted tokens or a saved profile, or to keep the default style"
            },
            {
              "label": "Imports",
              "text": "redraws draw.io, Mermaid and Excalidraw files in its own style, and reports what it merged or dropped"
            },
            {
              "label": "Needs",
              "text": "Python 3 for its check, import and export scripts"
            }
          ],
          "text": "Its philosophy is deletion: every node is a distinct idea, every line carries information, and a diagram is done when nothing can be removed. Each one stays within a budget of 9 nodes and 12 arrows, with the accent color on one or two focal elements; bigger subjects split into an overview and a detail. When behavior matters, such as a bottleneck, a trust boundary or a lifecycle with retries, it first picks a semantic pattern, then the layout type. Six connector rules are mandatory, among them right-angle elbows only, labels masked with a gap from their line, and no overlapping paths. It bans common slop such as dark mode with cyan glow, shadows, heavily rounded boxes and JetBrains Mono, and sets type in Instrument Serif, Geist and Geist Mono. Every SVG is accessible, with a title and description. Before drawing, it checks whether a table or paragraph would do the job better, and animation is off unless you ask.",
          "permalink": "https://github.com/cathrynlavery/diagram-design/tree/e57eda6102a19444538ebd611d39534fad65b663/skills/diagram-design"
        },
        "tags": [
          "category:science",
          "category:design",
          "type:workflow",
          "effect:local",
          "needs:cli",
          "by:community",
          "diagrams",
          "charts",
          "architecture",
          "anti-slop"
        ]
      }
    },
    {
      "id": "firecrawl/skills/skills/core/firecrawl-research-index",
      "name": "firecrawl-research-index",
      "skills.sh": {
        "url": "https://skills.sh/firecrawl/skills/firecrawl-research-index",
        "installs": 25200,
        "weeklyInstalls": [643, 601, 591, 520, 562, 698, 775, 499],
        "firstSeen": "2026-06-16"
      },
      "skillMd": {
        "version": "458d9d0331fb31121fd38e0e09ae5036f952784b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Finds research papers for a query in Firecrawl's index of biomedical and arXiv abstracts, expanding through similar, citing and cited papers.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you need the papers that answer a research question, from one named paper to a whole family of methods"
            },
            {
              "label": "It does",
              "text": "searches abstracts by meaning, expands good hits to similar, citing and cited papers, and reads a paper's full text to check a hard constraint"
            },
            {
              "label": "You get",
              "text": "the relevant papers, most relevant first, leaning toward keeping close neighbours rather than one best match"
            },
            {
              "label": "Covers",
              "text": "mostly PubMed, bioRxiv and medRxiv, plus arXiv preprints in computer science, physics and math"
            },
            {
              "label": "Needs",
              "text": "the Firecrawl CLI's research commands or Firecrawl's MCP tools"
            },
            {
              "label": "Unlike",
              "text": "firecrawl-research-papers, which writes a literature review from the same index; this one only finds the papers"
            }
          ],
          "text": "Firecrawl's skill for its research paper index. There's no fixed recipe: the agent reads the query's shape and picks an approach. A named paper takes one search. A paper described by its method is expanded to its family. A request for papers that do something expands several anchors and re-seeds from new hits. Papers that use a property are found through what cites or is cited by its defining paper. Leaderboard questions go to the web first, then map the top entries back to papers. Author or organization filters are checked against the paper itself. It warns that Firecrawl's ordinary web search with the research category is a different feature: it returns web pages from sites like PubMed and arXiv, not records from this index. An identical copy ships in firecrawl/cli.",
          "permalink": "https://github.com/firecrawl/skills/tree/458d9d0331fb31121fd38e0e09ae5036f952784b/skills/core/firecrawl-research-index"
        },
        "tags": [
          "category:science",
          "type:tool",
          "effect:none",
          "needs:cli",
          "needs:account",
          "by:official",
          "stack:firecrawl",
          "research",
          "flag:mirror"
        ]
      }
    },
