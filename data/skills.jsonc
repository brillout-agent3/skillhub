      "id": "cursor/plugins/pstack/skills/unslop",
      "name": "unslop",
      "skills.sh": {
        "url": "https://skills.sh/cursor/plugins/unslop",
        "installs": 32800,
        "weeklyInstalls": [2897, 1630, 1678, 1955, 2226, 2935, 2475, 3020],
        "firstSeen": "2026-05-24"
      },
      "skillMd": {
        "version": "2776ddd2355d6d6c8747d3964600f28daf62f049",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Rewrites text to remove AI tells: stock vocabulary, em dashes, filler, hedging, passive voice and mannered prose.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a draft, doc or message reads as machine-written and you want it plain"
            },
            {
              "label": "It does",
              "text": "scans the text for 28 numbered patterns, then rewrites it, keeping the meaning and intended tone"
            },
            {
              "label": "You get",
              "text": "the rewritten text"
            },
            {
              "label": "Strict on",
              "text": "punctuation: no em dashes, en dashes or parentheses as stand-ins; colons only before a list or example"
            },
            {
              "label": "Runs",
              "text": "only when you call it with /unslop"
            }
          ],
          "text": "The prose rules of pstack, a set of agent workflows in Cursor's plugin repo; its rule numbers are stable ids that other skills cite. It covers content (trailing -ing phrases, vague attributions), language (words like delve, pivotal and tapestry, \"serves as\" for \"is\", \"not just X but Y\", forced groups of three, rotating synonyms, false ranges), style (em dashes, mid-sentence colons, bold labels that restate the line, title case headings, decorative emoji, curly quotes), chatbot phrases and sycophancy, filler and hedging, and abstract metaphor nouns such as substrate, north star or flywheel. Its plain-speech rules ask for the mechanism or a number instead of a feeling, cutting any sentence that could appear unchanged in another project's docs, and for short sentences, active voice, strong verbs over adverbs, plain words, literal phrasing, and whole sentences instead of compressed fragments and arrows. Unlike no-ai-slop, it has no detect-only mode: it scans and rewrites.",
          "permalink": "https://github.com/cursor/plugins/tree/2776ddd2355d6d6c8747d3964600f28daf62f049/pstack/skills/unslop"
        },
        "tags": [
          "category:writing",
          "type:command",
          "effect:none",
          "needs:none",
          "by:community",
          "anti-slop",
          "writing"
        ]
      }
    },
