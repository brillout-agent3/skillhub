      },
      "skillMd": {
        "version": "da25d5cd06db21cb33b100661cea0d9b89d457a3",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Drives a live browser on a page scraped with Firecrawl: clicks, form fills, logins, pagination and infinite scroll, by prompt or code.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "a page's content needs clicks, forms, a login or scrolling, or a scrape came back incomplete"
            },
            {
              "label": "It does",
              "text": "scrapes the page first, then runs firecrawl interact with plain-language prompts or agent-browser commands in that page's live browser session"
            },
            {
              "label": "You get",
              "text": "the extracted content or the result of the action, with the session stopped afterwards"
            },
            {
              "label": "Needs",
              "text": "the Firecrawl CLI"
            },
            {
              "label": "Keeps",
              "text": "cookies and local storage in a named profile, so you can log in once and return signed in"
            },
            {
              "label": "Unlike firecrawl-agent",
              "text": "you direct each step; Firecrawl's agent navigates on its own"
            }
          ],
          "text": "Sessions belong to a scrape: its ID is saved automatically, so later interact calls can leave it out, though a saved session may expire after about ten minutes. Prompts such as \"click the login button\" or \"extract the pricing table\" work in plain language, and --code runs agent-browser commands for precise control. A read-only reconnect leaves a profile's saved state untouched. For parallel work it scrapes several pages and drives each by its own scrape ID. Web searches belong to firecrawl search; interact is for acting on one page.",
          "permalink": "https://github.com/firecrawl/cli/tree/da25d5cd06db21cb33b100661cea0d9b89d457a3/skills/firecrawl-interact"
        },
