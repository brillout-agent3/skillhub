        "skew": 0
      },
      "agentReview": {
        "description": "Implements authentication and authorization with JWTs, refresh tokens, sessions, OAuth2 social login and role- or permission-based access control.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you're adding login, securing an API, adding Google or GitHub sign-in, setting up roles and permissions, or debugging an auth problem"
            },
            {
              "label": "It does",
              "text": "explains authentication versus authorization and when to use sessions, JWTs or OAuth2, with TypeScript and Express examples for each"
            },
            {
              "label": "You get",
              "text": "auth code that hashes passwords, keeps access tokens short-lived, sets secure cookies and rate-limits login endpoints"
            },
            {
              "label": "Avoids",
              "text": "JWTs in localStorage, tokens that never expire, checks made only on the client, insecure password resets and login endpoints without rate limits"
            }
          ],
          "text": "A reference for building access control. Authentication answers who you are; authorization, what you may do. Sessions keep state on the server behind a cookie; JWTs are stateless and scale horizontally; OAuth2 and OpenID Connect hand login to Google, GitHub or an enterprise single sign-on. The worked examples, in TypeScript with Express, cover issuing and verifying JWTs with a refresh-token flow, sessions stored in Redis, Google and GitHub login through Passport.js, role-based and permission-based access control, resource ownership checks, password hashing with bcrypt and input validation with Zod, and rate limiting. Its rules: never store plain passwords, keep access tokens to 15-30 minutes, set httpOnly, secure and sameSite on cookies, protect session-based auth against CSRF, rotate secrets, log security events and use MFA when possible.",
          "permalink": "https://github.com/wshobson/agents/tree/4bde3168b43c0655c4d00ea2726e631719908a6d/plugins/developer-essentials/skills/auth-implementation-patterns"
