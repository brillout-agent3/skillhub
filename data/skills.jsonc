    {
      "id": "mattpocock/skills/skills/in-progress/writing-beats",
      "name": "writing-beats",
      "skills.sh": {
        "url": "https://skills.sh/mattpocock/skills/writing-beats",
        "installs": 523175,
        "weeklyInstalls": [28193, 26428, 23646, 23327, 29010, 25521, 23114, 21295],
        "firstSeen": "2026-05-06"
      },
      "skillMd": {
        "version": "5beb35b040e3de97e54fa9e386d7e42d15c295c2",
        "updated": "2026-10-20",
        "skew": 0
      },
      "agentReview": {
        "description": "Assembles raw material into an article as a journey of beats.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you have a pile of notes and want a first draft"
            },
            {
              "label": "It does",
              "text": "writes the article one section at a time, offering two or three next sections to pick from"
            },
            {
              "label": "You get",
              "text": "an article in its own file, steered by your choices"
            },
            {
              "label": "Unlike writing-shape",
              "text": "you choose the direction at every step, choose-your-own-adventure style"
            },
            {
              "label": "Runs",
              "text": "only when you call it"
            }
          ],
          "text": "Hand it your notes and it first settles with you what readers already know. It then drafts two or three possible openings from the notes; you pick one, and it writes just that section into the article file. After each section it rereads the article and offers the next possible sections, saying which new ideas each would introduce, so you steer the piece one choice at a time until it ends. Its one hard rule is that no section may lean on an idea the reader hasn't met: either an earlier section explains it, or it's settled up front as something readers bring.",
          "permalink": "https://github.com/mattpocock/skills/tree/5beb35b040e3de97e54fa9e386d7e42d15c295c2/skills/in-progress/writing-beats"
        },
        "tags": [
          "category:writing",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "writing"
        ]
      }
    },
