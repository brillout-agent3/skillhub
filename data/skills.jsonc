      "agentReview": {
        "description": "Investigates a question against primary sources and saves the findings as Markdown.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you need facts about an API, library or topic checked against their source, without stopping your work"
            },
            {
              "label": "It does",
              "text": "starts a background agent that reads primary sources: official docs, source code, specs and first-party APIs"
            },
            {
              "label": "You get",
              "text": "one Markdown file in your repo, with a source cited for each claim"
            },
            {
              "label": "Needs",
              "text": "an agent that can run subagents in the background"
            }
          ],
          "text": "It hands the reading to a background agent, so you and the main agent keep working. That agent investigates the question against primary sources, such as official docs, source code, specs and first-party APIs, rather than second-hand write-ups, and follows each claim back to the source that owns it. The findings go into a single Markdown file with a citation for each claim, saved in the folder where your repo keeps similar notes; if there's none, it picks a place and tells you where.",
          "permalink": "https://github.com/mattpocock/skills/tree/5beb35b040e3de97e54fa9e386d7e42d15c295c2/skills/engineering/research"
