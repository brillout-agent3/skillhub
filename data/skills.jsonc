    {
      "id": "addyosmani/agent-skills/skills/git-workflow-and-versioning",
      "name": "git-workflow-and-versioning",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/agent-skills/git-workflow-and-versioning",
        "installs": 67190,
        "weeklyInstalls": [3077, 4012, 3719, 3878, 4953, 5603, 5303, 4680],
        "firstSeen": "2026-02-16"
      },
      "skillMd": {
        "version": "301b02b12bff98e4688e6984af6556802322bbde",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Keeps git history clean: short-lived branches, small atomic commits with messages that explain why, and releases tagged with semantic versions and changelogs.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "the agent commits, branches, splits messy work into commits, opens a PR, writes a changelog entry or cuts a release"
            },
            {
              "label": "It does",
              "text": "applies trunk-based habits: main always deployable, branches merged within one to three days, one logical change per commit"
            },
            {
              "label": "You get",
              "text": "commits like \"feat: add email validation\" with the why in the body, and a summary of what changed and what was left alone"
            },
            {
              "label": "Also covers",
              "text": "pre-commit checks for secrets, worktrees for parallel agents, git bisect and blame, semantic versioning, tags and changelogs written for users"
            }
          ],
          "text": "Git is treated as a safety net: commits are save points, branches are sandboxes, history is documentation. The agent works trunk-based, keeping main deployable and feature branches short-lived, with feature flags rather than long branches for unfinished work. It commits after each passing increment and goes back to the last commit when a test fails. Each commit does one thing, never mixing formatting, refactoring and features, and aims for about 100 changed lines. Messages follow type: description (feat, fix, refactor, test, docs, chore) with a body explaining why. After a change it writes a summary of what it changed, what it deliberately didn't touch, and any concerns. Before committing it checks the staged diff, searches it for likely secrets and runs tests, lint and type checks. Git worktrees let several agents work on separate branches at once. For anything with consumers, versions follow semver, where a behavior change users relied on is major whatever its size; releases are tagged and the version derived from the tag; and the changelog is curated for users, written with the change rather than dumped from commits.",
          "permalink": "https://github.com/addyosmani/agent-skills/tree/301b02b12bff98e4688e6984af6556802322bbde/skills/git-workflow-and-versioning"
        },
        "tags": [
          "category:engineering",
          "type:workflow",
          "effect:remote",
          "needs:none",
          "by:community",
          "stack:git",
          "git"
        ]
      }
    },
