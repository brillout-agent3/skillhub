    {
      "id": "software-mansion/argent",
      "skew": 0,
      "agentReview": {
        "name": "Argent",
        "description": "Software Mansion's skills for Argent, an MCP server that lets the agent use your app on simulators, emulators, phones, TVs and Chromium apps, to test its UI, record it, debug its JavaScript, profile it and try out design variants.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want the agent to use, test, record, debug or speed up your app, React Native above all, on a simulator, emulator, phone or TV"
            },
            {
              "label": "It does",
              "text": "teaches the agent Argent's tools: drive the app by touch or TV remote, check UI flows, diff screenshots, record video, read logs, profile code and offer design variants"
            },
            {
              "label": "You get",
              "text": "UI flows checked with screenshot diffs, element trees and logs, answers from the live app, videos, profiling reports, measured fixes if you want them, and your chosen design applied"
            },
            {
              "label": "Start with",
              "text": "argent-device-interact, which the testing, recording, design and profiling skills use to drive the app (argent-tv-interact on a TV); for speed, argent-react-native-optimization, which runs the profilers for you"
            },
            {
              "label": "Needs",
              "text": "the Argent MCP server, set up by its installer; full Xcode for native profiling on iOS; the vega CLI for Fire TV; a feature flag for argent-lens"
            },
            {
              "label": "Physical iPhones",
              "text": "support only the tools argent-ios-device-interact lists: no debugger, profiler or screen recording, which move to a simulator, and no permission tool"
            },
            {
              "label": "Unlike agent-browser",
              "text": "which drives websites, it drives apps on phones, TVs, simulators and emulators, and can see inside a React Native app"
            }
          ],
          "text": "Argent is Software Mansion's MCP server for controlling simulators, emulators, phones, TVs and Chromium apps; these twelve skills teach the agent to use it. argent-device-interact is the base: which tool fits each tap, swipe or keystroke, and how to find targets in the element tree. It sends the agent to argent-ios-device-interact for a physical iPhone, which has fewer tools, and to argent-settings-permissions only when the app's own dialog can't change a permission. argent-tv-interact swaps taps for focus moved by remote buttons. argent-test-ui-flow builds on argent-device-interact for manual QA, checking each step with the element tree, logs or a screenshot diff, taken as argent-screenshot-diff describes, then giving a verdict. argent-screen-recording captures a flow as video. argent-metro-debugger attaches to a React Native app's JavaScript runtime through Metro for logs, components, network traffic and running code. Performance work starts at argent-react-native-optimization: subagents fix what lint and a checklist turn up, then argent-react-native-profiler records React commits, with argent-native-profiler alongside by default for native hangs, CPU and leaks; both ask before fixing and re-profile after. argent-lens builds design variants in the running app, lets you pick in Argent's Lens window, then applies your picks. One installer sets up the server and all the repo's skills.",
          "permalink": "https://github.com/software-mansion/argent/tree/b965c94827d6167fd2912a7ca5ad5505040ae4e0"
        },
        "skills": [
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-device-interact",
            "standalone": true
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-ios-device-interact",
            "standalone": false,
            "note": "Covers only what differs on a physical iPhone; argent-device-interact, which sends the agent here for one, still applies to everything else."
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-tv-interact",
            "standalone": true
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-settings-permissions",
            "standalone": true
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-test-ui-flow",
            "standalone": true
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-screenshot-diff",
            "standalone": true
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-screen-recording",
            "standalone": true
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-metro-debugger",
            "standalone": true
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-react-native-optimization",
            "standalone": false,
            "note": "Loads argent-react-native-profiler as its profiling phase, and navigates every screen with argent-device-interact to check that the fixes broke nothing."
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-react-native-profiler",
            "standalone": true
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-native-profiler",
            "standalone": true
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-lens",
            "standalone": true
          }
        ],
        "install": [
          {
            "label": "Editors the Argent installer supports, via npm; also sets up the MCP server and 6 more of the repo's skills",
            "command": "npx @swmansion/argent@latest init"
          },
          {
            "label": "Editors the Argent installer supports, via pnpm; also sets up the MCP server and 6 more of the repo's skills",
            "command": "pnpm dlx @swmansion/argent@latest init"
          }
        ]
      }
    },
    {
      "id": "jakubkrehel/skills@better-interface",
      "skew": 0,
      "agentReview": {
        "name": "Better Interface",
        "description": "Six skills that set and review accessibility, layout, copy, typography, color and UI polish, plus one that runs all six and merges their findings into one ranked report.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a screen or flow built or reviewed for accessibility, layout, copy, typography, color and visual polish, one domain at a time or all at once"
            },
            {
              "label": "It does",
              "text": "six skills each own one domain; better-interface loads all six in a fixed order, accessibility first, and merges their findings into one table ranked by user impact"
            },
            {
              "label": "You get",
              "text": "a findings table with file, line, before and after for each problem, the checks run and a verdict, Block or Approve; better-interface merges all six into one"
            },
            {
              "label": "Unlike make-interfaces-feel-better",
              "text": "the same author's one-skill polish checklist, better-ui hands typography and hit areas to their own skills, gates motion behind the reduced-motion setting, and has no quick review mode"
            },
            {
              "label": "Change reviews",
              "text": "go to the repo's interface-review skill, which isn't in this bundle: for a branch, pull request or uncommitted change, better-interface asks you to run it"
            },
            {
              "label": "Edits code",
              "text": "not during a better-interface review unless you also ask for the fixes; a failing contrast pair is reported, and its colors changed only when you ask"
            },
            {
              "label": "Checks",
              "text": "the code without a browser; with one, the rendered states too, such as 320px width, 200% zoom and right-to-left mirroring. Anything unchecked is marked Not verified"
            }
          ],
          "text": "Jakub Krehel's better-* skills split interface quality into six domains, each naming the sibling that owns what it leaves out. better-accessibility checks keyboard and focus behavior, accessible names, forms and screen-reader announcements against WCAG 2.2. better-layout sets grouping, alignment and reading order, then tests it resized, translated and mirrored for right-to-left languages. better-writing writes labels, errors, empty states and confirmations in the product's existing voice and terms. better-typography sets the type scale, wrapping, truncation and punctuation. better-colors builds palettes, names tokens by role and measures contrast against the background text renders on. better-ui gives exact values for corner radii, shadows, icon swaps and animation. Each works alone, in the project's existing styling and voice, and ends with a checklist of code patterns to catch. better-interface runs all six in that order, so polish never hides a basic failure. It first reads the project's interface guidelines, then merges the findings into one table of at most 15, ranked by severity, then by how far one fix reaches. Thirteen symptoms, such as a control with no accessible name or meaning carried only by color, are high severity on sight. A domain whose skill isn't installed is marked Not reviewed, never guessed.",
          "permalink": "https://github.com/jakubkrehel/skills/tree/60bf140e43c98b248e6594487384ec967e89d98a"
        },
        "skills": [
          {
            "id": "jakubkrehel/skills/skills/better-interface",
            "standalone": false,
            "note": "Loads the six better-* skills as the sources of truth for its domain reviews and marks any it can't load Not reviewed, without recreating its rules, so alone it reviews no domain."
          },
          {
            "id": "jakubkrehel/skills/skills/better-accessibility",
            "standalone": true
          },
          {
            "id": "jakubkrehel/skills/skills/better-layout",
            "standalone": true
          },
          {
            "id": "jakubkrehel/skills/skills/better-writing",
            "standalone": true
          },
          {
            "id": "jakubkrehel/skills/skills/better-typography",
            "standalone": true
          },
          {
            "id": "jakubkrehel/skills/skills/better-colors",
            "standalone": true
          },
          {
            "id": "jakubkrehel/skills/skills/better-ui",
            "standalone": true
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add https://github.com/jakubkrehel/skills --skill better-interface --skill better-accessibility --skill better-layout --skill better-writing --skill better-typography --skill better-colors --skill better-ui"
          },
          {
            "label": "Claude Code plugin, with 7 more of the repo's skills",
            "command": "claude plugin marketplace add jakubkrehel/skills && claude plugin install interfaces@interfaces"
          }
        ]
      }
    },
    {
      "id": "dietrichgebert/ponytail",
      "skew": 0,
      "agentReview": {
        "name": "Ponytail",
        "description": "A lean-code mode for coding agents, with reviews of a change or a whole repo and a ledger of the shortcuts it deferred.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "your coding agent over-engineers: abstractions, options, dependencies or code nobody asked for"
            },
            {
              "label": "It does",
              "text": "keeps the agent to the smallest change that fully solves the task, then reviews a change or audits a whole repo for what will actually break"
            },
            {
              "label": "You get",
              "text": "short diffs and replies that end with what was skipped and any risk, numbered plain-English findings with a verdict, and a ledger of deferred shortcuts"
            },
            {
              "label": "Runs",
              "text": "ponytail stays on for the session until you say \"stop ponytail\"; the other four are one-shot and change no code"
            },
            {
              "label": "Levels",
              "text": "lite only names the smaller option, full is the default, ultra also pushes back on the request before building"
            },
            {
              "label": "Never cuts",
              "text": "validation of untrusted input, error handling that prevents data loss, security, accessibility, or anything you asked for"
            }
          ],
          "text": "Ponytail casts the agent as a lazy senior developer: the best code is the code never written. Its core skill, ponytail, stays on for the session. Before writing, the agent reads the code the task touches and lists every place the change must reach; then it takes the first option that fully works, from skipping what wasn't asked for to reusing the codebase, the standard library or an installed dependency, and only then writes the minimum, with one small test for non-trivial logic. Each known shortcut gets a comment: shortcut: <the limit>, <when to upgrade>. The other skills run once and change no code. ponytail-review checks one change, reading its callers, tests and README, and ponytail-audit maps a whole repo and traces its data flows. Both rank findings as correct, safe, holds under load, tested, fast and lean, need a concrete failing case for each, number them so you can say \"fix 2 and 5\", and count a shortcut: comment that names its limit as a decision. ponytail-debt gathers those comments into one ledger and tags the ones with no upgrade trigger, and ponytail-help prints the levels, commands and settings.",
          "permalink": "https://github.com/dietrichgebert/ponytail/tree/96608e078b2d5ea607c5c3b8b5a54d1c1fba6846"
        },
        "skills": [
          {
            "id": "dietrichgebert/ponytail/skills/ponytail",
            "standalone": true
          },
          {
            "id": "dietrichgebert/ponytail/skills/ponytail-review",
            "standalone": true
          },
          {
            "id": "dietrichgebert/ponytail/skills/ponytail-audit",
            "standalone": true
          },
          {
            "id": "dietrichgebert/ponytail/skills/ponytail-debt",
            "standalone": false,
            "note": "Builds its ledger from the shortcut: comments, each naming a limit and when to upgrade, that the ponytail skill writes; without them it can only list a marker word you name."
          },
          {
            "id": "dietrichgebert/ponytail/skills/ponytail-help",
            "standalone": false,
            "note": "A reference card for ponytail's levels, settings and skills, so it only helps once they're installed."
          }
        ],
        "install": [
          {
            "label": "Claude Code plugin",
            "command": "claude plugin marketplace add DietrichGebert/ponytail && claude plugin install ponytail@ponytail"
          },
          {
            "label": "Codex plugin, then trust its two hooks in /hooks",
            "command": "codex plugin marketplace add DietrichGebert/ponytail && codex plugin add ponytail@ponytail"
          }
        ]
      }
    },
    {
      "id": "nextlevelbuilder/ui-ux-pro-max-skill",
      "skew": 0,
      "agentReview": {
        "name": "UI/UX Pro Max",
        "description": "UI design intelligence plus brand guidelines, design tokens, and generated logos, icons, banners, social images and HTML decks.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want one install for building an interface and making its brand material: guidelines, tokens, logos, icons, banners, social images and decks"
            },
            {
              "label": "It does",
              "text": "ui-ux-pro-max picks styles, palettes and fonts for the UI; five skills by ClaudeKit keep a brand file in sync with design tokens and generate brand assets"
            },
            {
              "label": "You get",
              "text": "a design system for your interface, brand guidelines synced to token CSS, Gemini-made logos, mockups and SVG icons, PNG banners and social images, and HTML decks"
            },
            {
              "label": "Needs",
              "text": "Python 3 and Node for the scripts, and a Gemini API key and two Python packages for design's logos, mockups and icons"
            }
          ],
          "text": "Its best-known skill, ui-ux-pro-max, searches local data on styles, palettes, font pairings and UX rules to give the agent a design system for the interface it builds. The repo's installer, uipro init, and its Claude Code plugin put design skills written by ClaudeKit next to it, and those lean on one another. brand keeps docs/brand-guidelines.md as the source of truth and syncs its colors into design-tokens.json and design-tokens.css. design-system layers tokens into primitive, semantic and component values, flags hardcoded ones in your code, and builds HTML decks that must import the token CSS; slides is a thin index whose references run design-system's slide search. design is the hub for brand assets: it hands brand, token and component work to its siblings, generates logos, identity mockups and SVG icons with Gemini, offers a logo gallery made with ui-ux-pro-max, and builds banners and social images in HTML, the social images by way of brand, design-system and ui-ux-pro-max. banner-design is a fuller, self-contained version of its banner workflow. Both installs also add ui-styling, for shadcn/ui and Tailwind setup.",
          "permalink": "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill/tree/b7d5353e0130feb8c5574ef1251f8a1db1873ccb"
        },
        "skills": [
          {
            "id": "nextlevelbuilder/ui-ux-pro-max-skill/cli/assets/skills/brand",
            "standalone": true
          },
          {
            "id": "nextlevelbuilder/ui-ux-pro-max-skill/cli/assets/skills/design-system",
            "standalone": true
          },
          {
            "id": "nextlevelbuilder/ui-ux-pro-max-skill/.claude/skills/ui-ux-pro-max",
            "standalone": true
          },
          {
            "id": "nextlevelbuilder/ui-ux-pro-max-skill/cli/assets/skills/design",
            "standalone": true
          },
          {
            "id": "nextlevelbuilder/ui-ux-pro-max-skill/cli/assets/skills/banner-design",
            "standalone": true
          },
          {
            "id": "nextlevelbuilder/ui-ux-pro-max-skill/cli/assets/skills/slides",
            "standalone": false,
            "note": "Its references run the slide search script that ships with design-system, which also holds the slide data and the fuller slide workflow."
          }
        ],
        "install": [
          {
            "label": "Claude Code plugin",
            "command": "claude plugin marketplace add nextlevelbuilder/ui-ux-pro-max-skill && claude plugin install ui-ux-pro-max@ui-ux-pro-max-skill"
          },
          {
            "label": "Claude Code, with the uipro CLI",
            "command": "npx ui-ux-pro-max-cli init --ai claude"
          },
          {
            "label": "Cursor, with the uipro CLI; for another agent, such as codex or gemini, put its name after --ai",
            "command": "npx ui-ux-pro-max-cli init --ai cursor"
          }
        ]
      }
    },
    {
      "id": "addyosmani/web-quality-skills",
      "skew": 0,
      "agentReview": {
        "name": "Web Quality Skills",
        "description": "Measurement-led audits and fixes for a website's speed, Core Web Vitals, accessibility, SEO and security, built on Lighthouse and Chrome DevTools.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a website checked and fixed for speed, accessibility, search and security, with measured evidence behind each finding"
            },
            {
              "label": "It does",
              "text": "starts with web-quality-audit, one review across every area, then goes deep with one skill per area; each measures, fixes or recommends fixes, and measures again"
            },
            {
              "label": "You get",
              "text": "code fixes, and from the audit a report: an evidence table, issues ranked critical to low with file and fix, a fix order and what's still unverified"
            },
            {
              "label": "Keeps apart",
              "text": "real-user data, lab runs and guesses from reading code; a high Lighthouse score is never taken as proof of quality"
            },
            {
              "label": "Works with",
              "text": "Chrome DevTools MCP when connected; otherwise the Lighthouse CLI, PageSpeed Insights, axe and manual checks"
            },
            {
              "label": "Install",
              "text": "all six: core-web-vitals and web-quality-audit read files that ship only with the performance skill"
            }
          ],
          "text": "Six skills by Addy Osmani, built on Google Lighthouse, Chrome DevTools and Core Web Vitals; the README calls the collection unofficial. web-quality-audit is the entry point: it settles which pages, states and devices to check, takes a small live baseline, then covers performance, accessibility, SEO, best practices and agentic browsing (how well an AI assistant can understand and operate the page), ending with a ranked report and a fix order. The other five each go deep on one area. performance owns the measurement workflow, which web-quality-audit and core-web-vitals also read: real-user Chrome data (CrUX) decides whether users have a problem, a browser trace or Lighthouse run finds why, and code inspection only forms hypotheses. core-web-vitals targets just LCP, INP and CLS (loading, responsiveness and layout stability) and their thresholds. accessibility tests against WCAG 2.2 with Lighthouse, the accessibility tree and the keyboard. seo covers crawling, indexing, page tags and structured data without promising rankings. best-practices covers security headers, CSP, deprecated APIs and code quality, adding the dependency and header checks Lighthouse lacks. Each re-runs the same checks after its fixes; for speed, real-user confirmation waits for new visits.",
          "permalink": "https://github.com/addyosmani/web-quality-skills/tree/afa8da942115f2961fdbfa80807ea0b232ff6c00"
        },
        "skills": [
          {
            "id": "addyosmani/web-quality-skills/skills/web-quality-audit",
            "standalone": false,
            "note": "Reads the measurement workflow that ships with the performance skill before it measures a live page."
          },
          {
            "id": "addyosmani/web-quality-skills/skills/performance",
            "standalone": true
          },
          {
            "id": "addyosmani/web-quality-skills/skills/core-web-vitals",
            "standalone": false,
            "note": "Reads the measurement workflow and the real-user monitoring reference that ship with the performance skill."
          },
          {
            "id": "addyosmani/web-quality-skills/skills/accessibility",
            "standalone": true
          },
          {
            "id": "addyosmani/web-quality-skills/skills/seo",
            "standalone": true
          },
          {
            "id": "addyosmani/web-quality-skills/skills/best-practices",
            "standalone": true
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add addyosmani/web-quality-skills"
          },
          {
            "label": "Claude Code plugin",
            "command": "claude plugin marketplace add addyosmani/web-quality-skills && claude plugin install web-quality-skills@addy-web-quality-skills"
          },
          {
            "label": "Codex plugin marketplace, Codex CLI 0.122+",
            "command": "codex plugin marketplace add addyosmani/web-quality-skills"
          },
          {
            "label": "Gemini CLI extension",
            "command": "gemini extensions install https://github.com/addyosmani/web-quality-skills"
          }
        ]
      }
