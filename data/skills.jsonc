  "facets": [
    {
      "id": "category",
      "name": "Category",
      "question": "What area is it for?",
      "count": "one or more",
      "values": [
        {
          "id": "software-engineering",
          "label": "Software engineering",
          "description": "Everything for building software: planning, coding, debugging, design, frameworks, cloud, agents and skills.",
          "includes": [
            "planning",
            "engineering",
            "debugging",
            "frameworks",
            "cloud",
            "agents",
            "skill-tools",
            "design",
            "browser",
            "security",
            "output-style"
          ]
        },
        {
          "id": "skill-tools",
          "label": "Skill tools",
          "description": "Find, write, vet and route to other skills."
        },
        {
          "id": "planning",
          "label": "Planning",
          "description": "Make the agent question you and write the plan down before it writes code."
        },
        {
          "id": "engineering",
          "label": "Engineering",
          "description": "Test-first work, implementation from specs, git hygiene and scope control."
        },
        {
          "id": "debugging",
          "label": "Debugging & QA",
          "description": "Find root causes, review code and test what you built."
        },
        {
          "id": "output-style",
          "label": "Output style",
          "description": "Change how the agent replies: shorter, clearer, fewer tokens."
        },
        {
          "id": "writing",
          "label": "Writing",
          "description": "Articles, docs, internal comms, research write-ups and prose that doesn't read as generated."
        },
        {
          "id": "design",
          "label": "Design",
          "description": "Taste for interfaces that don't look generated: direction, motion and accessibility."
        },
        {
          "id": "frameworks",
          "label": "Frameworks",
          "description": "Guides for frameworks, databases and SDKs, mostly from their vendors."
        },
        {
          "id": "cloud",
          "label": "Cloud",
          "description": "Deploy, provision, observe and debug cloud apps."
        },
        {
          "id": "browser",
          "label": "Browser",
          "description": "Drive browsers, scrape pages and search the web."
        },
        {
          "id": "media",
          "label": "Media",
          "description": "Generate and edit video, images and audio."
        },
        {
          "id": "documents",
          "label": "Documents",
          "description": "Office files, notes and suites like Lark and Google Workspace."
        },
        {
          "id": "marketing",
          "label": "Marketing",
          "description": "SEO, copy, conversion, social media and e-commerce."
        },
        {
          "id": "science",
          "label": "Science & data",
          "description": "Research reproduction, financial data, charts and diagrams."
        },
        {
          "id": "agents",
          "label": "Agents",
          "description": "Build agents, orchestrate workers and give agents memory."
        },
        {
          "id": "security",
          "label": "Security",
          "description": "Compliance, guardrails, skill vetting and browser fingerprinting."
        },
        {
          "id": "osint",
          "label": "OSINT",
          "description": "Investigate people, images and leaks from public sources."
        },
        {
          "id": "personal",
          "label": "Personal",
          "description": "Learning and everyday help outside work."
        }
      ]
    },
    {
      "id": "type",
      "name": "Type",
      "question": "How does the skill work?",
      "count": "one",
      "values": [
        {
          "id": "workflow",
          "description": "A multi-step process the agent follows: interview, debug, run a TDD loop, review."
        },
        {
          "id": "guidelines",
          "description": "Knowledge and rules the agent applies while it works: best practices, design principles, API references."
        },
        {
          "id": "tool",
          "description": "Operates a CLI, API, app or bundled script to get something done."
        },
        {
          "id": "command",
          "description": "A one-shot action you invoke by name, such as turning the conversation into a PRD."
        },
        {
          "id": "mode",
          "description": "Changes how the agent talks or behaves for the rest of the session."
        },
        {
          "id": "router",
          "description": "An entry point that picks and loads other skills. Retired skills that only redirect count as routers."
        },
        {
          "id": "setup",
          "description": "One-time configuration or scaffolding of a project, account or tool."
        }
      ]
    },
    {
      "id": "effect",
      "name": "Effect",
      "question": "What can it change on its own?",
      "count": "one",
      "values": [
        {
          "id": "none",
          "description": "Adds no side effects of its own. It shapes how the agent thinks, writes or reviews. Guidelines and routers are always effect:none, even when the task they support edits code."
        },
        {
          "id": "local",
          "description": "Its own steps create or change files, git state or local tools."
        },
        {
          "id": "remote",
          "description": "Its own steps change something outside your machine: post, send, deploy, provision, file issues, drive a website, or upload data to a service."
        }
      ]
    },
    {
      "id": "needs",
      "name": "Needs",
      "question": "What do you need besides the agent?",
      "count": "one or more",
      "values": [
        {
          "id": "none",
          "description": "Instructions only. Works in any agent that supports skills."
        },
        {
          "id": "cli",
          "description": "A specific command-line tool or desktop app must be installed, such as gh, agent-browser, LibreOffice, Obsidian or a vendor CLI."
        },
        {
          "id": "account",
          "description": "An account, API key or paid plan with an outside service."
        },
        {
          "id": "browser",
          "description": "Drives a real Chromium or Chrome browser."
        },
        {
          "id": "subagents",
          "description": "Relies on the agent being able to spawn subagents."
        },
        {
          "id": "issue-tracker",
          "description": "Reads or writes an issue tracker, GitHub Issues by default."
        },
        {
          "id": "mcp",
          "description": "Needs an MCP server connected."
        },
        {
          "id": "claude-code",
          "description": "Uses Claude Code features such as hooks or background agents."
        },
        {
          "id": "claude-ai",
          "description": "Built for claude.ai artifacts."
        },
        {
          "id": "openclaw",
          "description": "Built for the OpenClaw agent."
        }
      ]
    },
    {
      "id": "by",
      "name": "Publisher",
      "question": "Who publishes it?",
      "count": "one",
      "values": [
        {
          "id": "official",
          "description": "A verified publisher on skills.sh, or the company or maintainer behind the product the skill operates."
        },
        {
          "id": "community",
          "description": "Everyone else. Unverified vendor claims default to community."
        }
      ]
    },
    {
      "id": "flag",
      "name": "Flags",
      "question": "Is there something to check before installing?",
      "count": "any",
      "values": [
        {
          "id": "republished",
          "description": "A copy of another publisher's skill under a different org. Each copy found had hundreds of thousands of installs while its original had fewer than twenty, so treat its ranking with caution."
        },
        {
          "id": "mirror",
          "description": "The same publisher ships the skill under two sources, which splits its counts."
        },
        {
          "id": "dual-use",
          "description": "Legitimate uses exist, but the same capability can evade bot detection or investigate other people. Read the SKILL.md before installing."
        }
      ]
    },
