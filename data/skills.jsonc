      "agentReview": {
        "description": "Reads numbers off web dashboards with Firecrawl's browser, including ones you're signed in to, and turns them into a report.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want KPIs, tables or chart values from public stats or status pages, or analytics tools you can sign in to, as a report or date-range table"
            },
            {
              "label": "It does",
              "text": "opens each dashboard in Firecrawl's browser, sets the date range, clicks tabs, expands sections and scrolls tables to read the visible metrics"
