    {
      "id": "emilkowalski/skills/skills/animate",
      "name": "animate",
      "skills.sh": {
        "url": "https://skills.sh/emilkowalski/skills/animate",
        "installs": 202673,
        "weeklyInstalls": [11760, 13469, 14465, 15844, 17674, 18026, 19743, 17825],
