    {
      "id": "tw93/waza/skills/learn",
      "name": "learn",
      "skills.sh": {
        "url": "https://skills.sh/tw93/waza/learn",
        "installs": 13400,
        "weeklyInstalls": [246, 266, 195, 174, 354, 230, 148, 178],
