      },
      "agentReview": {
        "description": "Runs managed Strix pentests on app.strix.ai via the strix cloud CLI or REST API, with no local Docker or LLM key.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want Strix pentesting without running Docker or an LLM yourself, or you want team tracking and scheduled scans"
            },
            {
              "label": "It does",
              "text": "signs in, registers and verifies assets, uploads source safely, launches and polls scans, and triages findings through the strix cloud CLI"
            },
            {
              "label": "You get",
              "text": "validated findings in a dashboard, SARIF export, PR reviews, and compliance reports on the Enterprise plan"
            },
            {
              "label": "Needs",
              "text": "an app.strix.ai account; scans consume credits"
            }
          ],
          "text": "The cloud counterpart to the open-source CLI, for sandboxed agents, teams and continuous testing. Everything runs through the strix cloud CLI (or the REST API), which mirrors every operation and returns JSON when not on a terminal. It covers device sign-in with least-privilege scopes, registering and verifying domains or repos, a two-step digest handoff that keeps a human in control of what source leaves the machine, launching and polling scans, listing and updating vulnerabilities, exporting SARIF, starting PR reviews, buying credits through an agent-payable flow, and setting up schedules and webhooks. Plan and role limits are enforced and passed through: report downloads need Enterprise, schedules need Pro, billing writes need an admin token. It shares the same engine and SARIF output as the OSS CLI, so you can mix the two.",
          "permalink": "https://github.com/usestrix/strix/tree/06015506625a78b981ae0b34be40239fc1b389be/skills/managed-pentesting-with-strix"
        },
        "tags": [
          "category:security",
          "type:tool",
          "effect:remote",
          "needs:cli",
          "needs:account",
          "by:official",
          "stack:strix",
          "security",
          "testing"
        ],
        "note": "Needs an app.strix.ai account; scans consume credits, and PDF/DOCX reports and schedules need paid plans. Only test assets you own or are authorized to test."
      }
