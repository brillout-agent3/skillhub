    {
      "id": "ayghri/i-have-adhd/skills/i-have-adhd",
      "name": "i-have-adhd",
      "skills.sh": {
        "url": "https://skills.sh/ayghri/i-have-adhd/i-have-adhd",
        "installs": 32200,
        "weeklyInstalls": [3005, 2540, 1736, 1508, 2431, 2099, 1925, 1706],
        "firstSeen": "2026-05-14"
      },
      "skillMd": {
        "version": "1ecea1993b7fce257ffbd686c070948b5e07eda6",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Shapes replies for a reader with ADHD: next action first, numbered steps, restated progress and concrete time estimates.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "long or scattered replies make it hard for you to act on them"
            },
            {
              "label": "It does",
              "text": "puts the next action first, numbers multi-step work, restates where you are each turn, holds tangents for later and gives concrete time estimates"
            },
            {
              "label": "You get",
              "text": "replies that start with something to do and end with one next step you can take in under two minutes"
            },
            {
              "label": "Runs",
              "text": "only when you call /i-have-adhd, then for the rest of the session until you say \"stop adhd mode\" or \"normal mode\""
            },
            {
              "label": "Breaks the rules",
              "text": "for explanations you ask for, destructive actions, debugging loops and real ambiguity"
            }
          ],
          "text": "Its rules start from five facts about reading with ADHD: working memory is small, knowing isn't doing, starting is the hardest step, vague estimates all feel the same, and progress you can't see doesn't register. So the first line is an action, such as a file and line to edit, never context. Work with more than one step becomes a numbered list of single actions, as few as will do. Each turn restates the state, like \"Step 3 of 5 done\", or uses the agent's task list if it has one. A second issue waits until the first is done and comes back as a question. Estimates are concrete (\"about 15 minutes if tests already cover this\"), finished work is shown as what now works and how to try it, errors get a cause and a fix without \"uh oh\", and visible lists stay at five items per group without dropping relevant ones. Openers like \"Great question\", recaps and closing pleasantries are cut. After three \"still broken\" turns it stops patching and names the assumption that might be wrong.",
          "permalink": "https://github.com/ayghri/i-have-adhd/tree/1ecea1993b7fce257ffbd686c070948b5e07eda6/skills/i-have-adhd"
        },
        "tags": [
          "category:output-style",
          "type:mode",
          "effect:none",
          "needs:none",
          "by:community",
          "output-style"
        ],
        "note": "Stays on for the rest of the session until you say \"stop adhd mode\" or \"normal mode\"."
      }
    },
    {
      "id": "wheresryan22/anatomy",
      "name": "anatomy",
      "skills.sh": {
        "url": "https://skills.sh/wheresryan22/anatomy/anatomy",
        "installs": 30100,
        "weeklyInstalls": [0, 0, 0, 0, 2079, 12874, 6637, 5289],
        "firstSeen": "2026-10-10"
      },
      "skillMd": {
        "version": "1482e8469b0a9e0d8cc18ea2740a01423d29ae80",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Builds detailed, interactive isometric SVG figures that explain a technical idea as a working physical machine.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a figure for docs, a blog post or a landing page that shows how a system, algorithm or component works"
            },
            {
              "label": "It does",
              "text": "invents a real machine whose working is the idea, like a pin-tumbler lock for a cache key, and draws it in isometric view from dozens of small solid parts"
            },
            {
              "label": "You get",
              "text": "a standalone HTML page, SVG or React components: a framed figure with a live readout and calm motion, optionally WebGL effects, 3D turning or an A4 PDF"
            },
            {
              "label": "Needs",
              "text": "Node.js 20.10 or later, and Chrome or Chromium for its screenshots and checks"
            },
            {
              "label": "Takes",
              "text": "up to an hour for a one-mechanism figure and 2 to 4 hours for a dense one; bigger builds wait for your go-ahead"
            }
          ],
          "text": "Its rule is that the object is the explanation: no boxes, arrows or labels, but a recognisable instrument, such as a test rig, a dial gauge or a chest of drawers, whose motion maps onto the concept. The agent sizes the job, collects the real numbers so every readout and caption is true, invents the object, and lists at least 40 grouped parts before any geometry. A bundled kit builds the solids with four-tone shading, paints them back to front and frames the figure in a card with a title, a hint and a live readout. Eight examples ship with it, from a dial gauge in about 300 lines to a rocket engine on a test stand. Then it verifies like a critic: screenshots on desktop, phone and mid-motion, an audit proving no pipe passes through anything and every overlap is drawn in depth order, a check that every line ends on something, and close-ups at 4x in dark and light themes. WebGL fire, water or lamp light sits inside the drawing in the same perspective. On request, and after you approve its plan, it opens a pull request to the Anatomy community gallery.",
          "permalink": "https://github.com/wheresryan22/anatomy/tree/1482e8469b0a9e0d8cc18ea2740a01423d29ae80"
        },
        "tags": [
          "category:science",
          "category:media",
          "type:workflow",
          "effect:local",
          "needs:cli",
          "needs:browser",
          "by:community",
          "stack:svg",
          "stack:webgl",
          "stack:react",
          "diagrams",
          "animation",
          "image"
        ],
        "note": "Needs Node.js 20.10+ and Chrome or Chromium. A small figure can take up to an hour, a dense one 2 to 4 hours."
      }
