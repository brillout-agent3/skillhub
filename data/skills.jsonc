    {
      "id": "software-mansion/argent/packages/skills/skills/argent-screenshot-diff",
      "name": "argent-screenshot-diff",
      "skills.sh": {
        "url": "https://skills.sh/software-mansion/argent/argent-screenshot-diff",
        "installs": 28000,
        "weeklyInstalls": [1541, 1385, 1528, 1540, 1592, 1643, 1692, 1622],
        "firstSeen": "2026-06-01"
      },
      "skillMd": {
        "version": "b965c94827d6167fd2912a7ca5ad5505040ae4e0",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Compares a baseline and a current screenshot of a running app through Argent to check visual changes and catch visual regressions.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a visual regression test or a before-and-after comparison of a screen around a UI change"
            },
            {
              "label": "It does",
              "text": "saves a full-size baseline screenshot before the interaction or code change, then diffs a fresh capture of the state under test against it"
            },
            {
              "label": "You get",
              "text": "a diff summary and artifact files showing what changed in pixels, read together with a normal look at the screen"
            },
            {
              "label": "Poor fit",
              "text": "for state, navigation or log checks, finding tap targets, or screens with animation, timestamps, ads or random data"
            },
            {
              "label": "Needs",
              "text": "the Argent MCP server"
            }
          ],
          "text": "Part of Software Mansion's Argent toolkit, which lets the agent control simulators, emulators and devices. Argent's screenshot-diff tool highlights pixel-visible change or stability between two screenshots, and this skill sets when and how to use it. It's required when you ask for a visual regression test, a screenshot diff or a before-and-after comparison, unless comparable screenshots can't be produced, and it suits changes in layout, spacing, color, typography, clipping and rendering of text or images. The agent navigates to the known-good state and saves a baseline screenshot at full scale, kept out of its context, before the interaction or edit. Then it makes the change, waits for the app to reload or rebuild, navigates to the state under test and diffs a fresh capture, or a second saved file, against the baseline. The diff is supporting evidence only: the agent still looks at the screen and adds element-tree, log or network checks when the assertion needs them.",
          "permalink": "https://github.com/software-mansion/argent/tree/b965c94827d6167fd2912a7ca5ad5505040ae4e0/packages/skills/skills/argent-screenshot-diff"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:local",
          "needs:mcp",
