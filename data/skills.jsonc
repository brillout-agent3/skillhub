    {
      "id": "tavily-ai/skills/skills/core/tavily-search",
      "name": "tavily-search",
      "skills.sh": {
        "url": "https://skills.sh/tavily-ai/skills/tavily-search",
        "installs": 37600,
        "weeklyInstalls": [745, 965, 747, 663, 658, 653, 678, 889],
