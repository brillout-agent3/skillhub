      "agentReview": {
        "description": "Summarizes recent agent sessions on the current project, grouped by date, for today, this week or the last N sessions.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "you want a rollup of recent work: \"recap\", \"what have we been doing\", today or this week"
            },
            {
              "label": "It does",
              "text": "fetches the project's sessions for the window you name, the last 10 by default, and searches memory for each one's highlights"
            },
            {
              "label": "You get",
              "text": "sessions grouped by date with id, title, observation count, status and highlights, ending with a line of totals"
            },
            {
              "label": "Needs",
              "text": "agentmemory's memory server and MCP tools, plus its capture hooks recording your sessions: connecting the tools alone records no sessions"
            },
            {
              "label": "Unlike session-history",
              "text": "it takes a time window and groups the sessions by date"
            }
          ],
          "text": "Part of agentmemory, a memory server that records what coding agents do in each session as observations. recap takes a window: today, this week (the last seven days), the last N sessions, or the last 10 when you give none. The agent fetches the project's sessions, paging until the window is covered, and matches them to this project by working directory when its identifier is unknown. It groups them by local date and lists each session's short id, title or first prompt, observation count and status, with highlights from a memory search, kept only when they belong to that session. It ends with a totals line: N sessions across M days, K observations. An empty window is reported as empty, not summarized from the conversation.",
          "permalink": "https://github.com/rohitg00/agentmemory/tree/f0f7378ac42849b863fcc5c8e753f120d5ec6f9d/plugin/skills/recap"
