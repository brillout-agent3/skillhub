// Generated by scripts/schema.ts from `Crawl` in data/types.ts: don't edit it, edit the type and run `pnpm run schema`.
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Crawl",
  "definitions": {
    "Crawl": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "The JSON Schema of this file, generated from this interface: for editors."
        },
        "asOf": {
          "type": "string",
          "description": "When crawl.ts last ran (YYYY-MM-DD).\n\nSource: scripts/crawl.ts, which .github/workflows/crawl.yml runs daily, sets it to the day it runs."
        },
        "qualified": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Crawled"
          },
          "description": "At the minimums (`MINIMUMS` in ../scripts/data.ts) or above, most installed first: waiting for an agent to approve or disqualify them, with the add-skill skill.\n\nSource: scripts/crawl.ts sorts every skill of the top 600 it saw that day into `qualified` or `unqualified`, with `passes()` of scripts/data.ts; a skill that left the top 600 keeps its state."
        },
        "unqualified": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Crawled"
          },
          "description": "Below the minimums, most installed first.\n\nSource: scripts/crawl.ts, as for `qualified`."
        },
        "disqualified": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Disqualified"
          },
          "description": "Not to be shown, each with why, and with no agent data: no tags, no TLDR, no copy of its SKILL.md.\n\nSource: scripts/crawl.ts adds the skills of the top 600 that aren't on GitHub, scripts/sync.ts the approved skills whose SKILL.md is gone from their repo, and an agent, with the add-skill skill, the qualified skills it turns down."
        }
      },
      "required": ["$schema", "asOf", "qualified", "unqualified", "disqualified"],
      "additionalProperties": false,
      "description": "The shape of data/crawl.jsonc: every skill the crawl has seen in the skills.sh all-time top 600 that isn't approved (the approved ones are in skills.jsonc), keyed by its skills.sh page. The two files are cumulative: a skill that lands in either never leaves them, only its state changes. Unlike skills.jsonc, crawl.jsonc takes any skill, such as one a website publishes."
    },
    "Crawled": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Its name on skills.sh: the end of its skills.sh page.\n\nSource: scraped by scripts/crawl.ts when it records the skill: `topSkills()` takes `name` from the leaderboard JSON in the HTML of https://www.skills.sh/."
        },
        "repo": {
          "type": "string",
          "description": "Its GitHub repo, `owner/name`, as skills.sh names it: possibly an old name the repo redirects from.\n\nSource: scraped by scripts/crawl.ts when it records the skill: the `source` of its leaderboard entry."
        },
        "official": {
          "type": "boolean",
          "description": "Whether skills.sh shows its publisher as verified.\n\nSource: scraped by scripts/crawl.ts, daily while the skill is in the top 600: the `isOfficial` of its leaderboard entry."
        },
        "stars": {
          "type": ["number", "null"],
          "description": "Its repo's GitHub stars, or null when unknown.\n\nSource: the GitHub API, by scripts/crawl.ts, daily while the skill is in the top 600: the `stargazers_count` of https://api.github.com/repos/<repo>, when GITHUB_TOKEN is set. A request that fails keeps the last number."
        },
        "seen": {
          "type": "string",
          "description": "The last day the crawl saw it in the top 600, which its numbers are from (YYYY-MM-DD).\n\nSource: scripts/crawl.ts sets it to the day it runs, for every skill of the top 600."
        },
        "skills.sh": {
          "$ref": "#/definitions/SkillsSh",
          "description": "Its `skills.sh` field once it's approved."
        }
      },
      "required": ["name", "repo", "official", "stars", "seen", "skills.sh"],
      "additionalProperties": false,
      "description": "A skill of the skills.sh top 600 that's qualified or unqualified."
    },
    "SkillsSh": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The skill's page on skills.sh.\n\nSource: scripts/crawl.ts, when it records the skill: `pageOf()` builds it from the `source` and `skillId` of its leaderboard entry."
        },
        "installs": {
          "type": ["number", "null"],
          "description": "All-time installs, or null when unknown: exact for a skill in the skills.sh all-time top 600, rounded to three digits (such as 26.5K) for an approved skill outside it. A skill of crawl.jsonc that left the top 600 keeps its last number.\n\nSource: scraped from skills.sh's HTML, with no skills.sh API, by scripts/crawl.ts, which .github/workflows/crawl.yml runs daily. For a skill in the top 600, `topSkills()` fetches the HTML of https://www.skills.sh/ and parses the leaderboard JSON that the page's Next.js payload embeds (its `self.__next_f.push(…)` scripts, the `initialSkills` object of the all-time view). For an approved skill outside it, `skillPage()` fetches the HTML of the skill's skills.sh page and matches the \"Installs\" stat in its markup with a regex, such as \"26.5K\"; null when skills.sh no longer has the page."
        },
        "weeklyInstalls": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Installs per week for the 8 weeks up to the installs snapshot, oldest first, or null when unknown.\n\nSource: scraped from skills.sh's HTML by scripts/crawl.ts, daily, together with `installs`. For a skill in the top 600, `topSkills()` takes `weeklyInstalls` from the same leaderboard JSON in the HTML of https://www.skills.sh/. For an approved skill outside it, `skillPage()` matches the `aria-label=\"Weekly installs: …\"` of the chart in the HTML of the skill's skills.sh page."
        },
        "firstSeen": {
          "type": ["string", "null"],
          "description": "When skills.sh first saw the skill (YYYY-MM-DD), or null when unknown. It never changes.\n\nSource: scraped from skills.sh's HTML by scripts/crawl.ts. `skillPage()` fetches the HTML of the skill's skills.sh page and matches its \"First Seen\" stat with a regex, such as \"Jan 22, 2026\", which the leaderboard doesn't give. It does so once: when the crawl records the skill in crawl.jsonc, or for an approved skill that has none."
        }
      },
      "required": ["url", "installs", "weeklyInstalls", "firstSeen"],
      "additionalProperties": false
    },
    "Disqualified": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Its skills.sh page."
        },
        "note": {
          "type": "string",
          "description": "Why it's disqualified.\n\nSource: whoever disqualified it, as for `disqualified`."
        }
      },
      "required": ["url", "note"],
      "additionalProperties": false
    }
  }
}
