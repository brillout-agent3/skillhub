{
  "name": "skillhub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run node-ts scripts/dev.ts",
    "dev:stop": "pnpm run node-ts scripts/dev.ts --stop",
    "build": "vike build --root website",
    "preview": "pnpm run node-ts scripts/dev.ts --preview",
    "========= Checks": "",
    "check": "pnpm run check:data && pnpm run check:types",
    "check:data": "pnpm run node-ts scripts/check.ts",
    "check:types": "tsc --noEmit && tsc --noEmit -p worker",
    "// After pnpm build: the built site's links and ids": "",
    "check:site": "pnpm run node-ts scripts/check-site.ts",
    "// After pnpm build, when the layout changed: the pages that scroll sideways, at a phone's width and wider. A minute a width: not in CI": "",
    "check:widths": "pnpm run node-ts scripts/check-widths.ts",
    "// After a deploy: whether the live site answers as it should": "",
    "check:live": "pnpm run node-ts scripts/check-live.ts",
    "========= The Worker's tests, in worker/index.test.ts": "",
    "test:worker": "pnpm run node-ts --test --test-reporter=spec worker/index.test.ts",
    "========= End-to-end walk of the site, in e2e/": "",
    "test:e2e": "playwright test",
    "========= SKILL.md copies": "",
    "sync": "pnpm run node-ts scripts/sync.ts",
    "tldr": "pnpm run node-ts scripts/tldr.ts",
    "========= JSON Schemas of the data files": "",
    "schema": "pnpm run node-ts scripts/schema.ts",
    "========= Crawl skills.sh and GitHub": "",
    "crawl": "pnpm run node-ts scripts/crawl.ts",
    "========= Formatting": "",
    "format": "oxfmt",
    "===== Utils": "",
    "// Run a .ts file with Node.js <=23 — these two flags aren't needed anymore on Node.js 24+": "",
    "node-ts": "node --experimental-strip-types --no-warnings=ExperimentalWarning",
    "========= Only allow pnpm; forbid yarn & npm": "",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@fontsource-variable/geologica": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "comment-json": "^5.0.0",
    "diff": "^9.0.0",
    "markdown-it": "^15.0.3",
    "miniflare": "5.20261104.0-beta",
    "oxfmt": "^0.74.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2",
    "vike": "^0.4.268",
    "vite": "^8.3.4",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@10.33.0"
}
