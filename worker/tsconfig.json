{
  // The Worker runs in Cloudflare's runtime, not a browser: its own types, without the DOM's.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["."],
  // Its tests run in Node: the root tsconfig.json checks them.
  "exclude": ["index.test.ts"]
}
